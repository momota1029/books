#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C
export GIT_CONFIG_GLOBAL=/dev/null
export GIT_CONFIG_SYSTEM=/dev/null

source_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
test_root=$(mktemp -d)

cleanup() {
  if [[ -n ${test_root:-} && -d $test_root ]]; then
    rm -rf -- "$test_root"
  fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

fail() {
  printf 'not ok %s - %s\n' "$1" "$2" >&2
  exit 1
}

pass() {
  printf 'ok %s - %s\n' "$1" "$2"
}

capture_status() {
  local output_file=$1
  local expected_status=$2
  shift 2
  local actual_status

  if "$@" >"$output_file" 2>&1; then
    actual_status=0
  else
    actual_status=$?
  fi
  [[ $actual_status == "$expected_status" ]]
}

repo_dir=$test_root/repository
mkdir -p "$repo_dir/.system" "$repo_dir/.githooks" \
  "$repo_dir/projects/example/inbox" "$repo_dir/projects/example/draft" \
  "$repo_dir/projects/example/out" \
  "$repo_dir/projects/example/.workspace/source" \
  "$repo_dir/projects/example/.workspace/records" \
  "$repo_dir/projects/example/.workspace/tools" \
  "$repo_dir/projects/example/.workspace/build" \
  "$repo_dir/projects/example/.workspace/cache" \
  "$repo_dir/projects/example/.workspace/tmp" \
  "$repo_dir/projects/example/.workspace/logs" \
  "$repo_dir/projects/example/.workspace/locks"
cp -- "$source_root/.system/standards-migration" "$repo_dir/.system/"
chmod +x "$repo_dir/.system/standards-migration"
printf 'root instructions\n' >"$repo_dir/AGENTS.md"
printf 'routing instructions\n' >"$repo_dir/WORKFLOW_ROUTING.md"
printf 'writing instructions\n' >"$repo_dir/JAPANESE_WRITING.md"
printf 'review instructions\n' >"$repo_dir/MATH_PROSE_REVIEW.md"
printf 'project instructions\n' >"$repo_dir/projects/AGENTS.md"
printf 'refresh checker\n' >"$repo_dir/.system/instruction-refresh"
printf 'post-merge hook\n' >"$repo_dir/.githooks/post-merge"
printf 'unrelated\n' >"$repo_dir/notes.txt"

git init -q "$repo_dir"
cd "$repo_dir"
git config --local user.name 'Standards Migration Test'
git config --local user.email 'standards-migration@example.invalid'
git add -- AGENTS.md WORKFLOW_ROUTING.md JAPANESE_WRITING.md \
  MATH_PROSE_REVIEW.md projects/AGENTS.md notes.txt \
  .system/instruction-refresh .system/standards-migration .githooks/post-merge
git commit -q -m 'test fixture'
git rev-parse --verify 'HEAD^{commit}' >projects/example/.workspace/system-version
.system/standards-migration initialize --scope projects/example >/dev/null

output_file=$test_root/output
if .system/standards-migration check --scope projects/example \
    --operation extend >/dev/null &&
  .system/standards-migration check --scope projects/example \
    --operation promotion >/dev/null &&
  [[ -f projects/example/.workspace/records/standards-initialization.json ]]; then
  pass initialization 'empty project receives a current standards baseline'
else
  fail initialization 'empty project standards baseline'
fi

if capture_status "$output_file" 1 .system/standards-migration initialize \
    --scope projects/example &&
  grep -Fq -- 'only for an empty new project' "$output_file"; then
  pass initialization-once 'standards initialization cannot overwrite a baseline'
else
  fail initialization-once 'standards initialization overwrite rejection'
fi

mv -- projects/example/inbox projects/example/.workspace/records/inbox-real
ln -s -- .workspace/records/inbox-real projects/example/inbox
if capture_status "$output_file" 3 .system/standards-migration check \
    --scope projects/example --operation extend &&
  grep -Fq -- 'path is unsafe' "$output_file"; then
  pass initialized-symlink 'current-at-creation roots remain path-safe'
else
  fail initialized-symlink 'current-at-creation root-symlink rejection'
fi
rm -- projects/example/inbox
mv -- projects/example/.workspace/records/inbox-real projects/example/inbox

mv -- projects/example/.workspace/records "$test_root/records-real"
ln -s -- "$test_root/records-real" projects/example/.workspace/records
if capture_status "$output_file" 1 .system/standards-migration check \
    --scope projects/example --operation extend &&
  grep -Fq -- 'safe .workspace/records' "$output_file"; then
  pass initialized-records-symlink 'the records root cannot escape the project'
else
  fail initialized-records-symlink 'records-root symlink rejection'
fi
rm -- projects/example/.workspace/records
mv -- "$test_root/records-real" projects/example/.workspace/records

ln -s -- / projects/example/.workspace/records/unsafe-descendant
if capture_status "$output_file" 1 .system/standards-migration check \
    --scope projects/example --operation extend &&
  grep -Fq -- 'safe .workspace/records' "$output_file"; then
  pass initialized-records-descendant 'unsafe records descendants are rejected in every state'
else
  fail initialized-records-descendant 'records-descendant rejection'
fi
rm -- projects/example/.workspace/records/unsafe-descendant

printf 'unrelated changed\n' >notes.txt
if .system/standards-migration check --scope projects/example \
    --operation extend >/dev/null; then
  pass unrelated 'unrelated changes do not invalidate project standards'
else
  fail unrelated 'unrelated changes do not invalidate project standards'
fi

printf 'root instructions changed\n' >AGENTS.md
if capture_status "$output_file" 3 .system/standards-migration check \
    --scope projects/example --operation extend &&
  grep -Fq -- 'migration required' "$output_file"; then
  pass freeze 'changed standards freeze legacy extension'
else
  fail freeze 'changed standards freeze legacy extension'
fi

if .system/standards-migration check --scope projects/example \
    --operation inspect >"$output_file" &&
  grep -Fq -- 'state=migration-required' "$output_file"; then
  pass inspect 'read-only inspection remains available during migration'
else
  fail inspect 'read-only inspection during migration'
fi

fingerprint=$(.system/standards-migration fingerprint --scope projects/example)
mkdir -- projects/example/.workspace/source/legacy \
  projects/example/.workspace/source/replacement
printf 'legacy canonical source\n' \
  >projects/example/.workspace/source/legacy/main.tex
printf '%s\n' \
  'standards-migration: reconstructing' \
  "standards-fingerprint: $fingerprint" >projects/example/draft/STATUS.md
python3 - "$fingerprint" <<'PY'
import json
import hashlib
import pathlib
import sys

fingerprint = sys.argv[1]
project = pathlib.Path("projects/example")


def digest(path):
    value = hashlib.sha256()
    if path.is_file():
        value.update(b"file\0")
        value.update(path.read_bytes())
        return value.hexdigest()
    value.update(b"directory\0")
    for entry in sorted(path.rglob("*"), key=lambda item: item.relative_to(path).as_posix()):
        relative = entry.relative_to(path).as_posix().encode("utf-8")
        if entry.is_dir():
            value.update(b"directory-entry\0" + relative + b"\0")
        else:
            value.update(b"file-entry\0" + relative + b"\0")
            value.update(entry.read_bytes())
    return value.hexdigest()


def snapshot(relative):
    return {"path": relative, "sha256": digest(project / relative)}


def review_universe():
    paths = [entry.name for entry in project.iterdir() if entry.name != ".workspace"]
    paths += [
        f".workspace/{entry.name}"
        for entry in (project / ".workspace").iterdir()
        if entry.name != "records"
    ]
    return [snapshot(relative) for relative in sorted(paths)]


legacy_file = ".workspace/source/legacy/main.tex"
universe = review_universe()
audit = {
    "schema_version": 1,
    "project_root": "projects/example",
    "standards_fingerprint": fingerprint,
    "review_universe": universe,
    "evaluated_revisions": {
        "artifact": snapshot(legacy_file),
        "input": snapshot("inbox"),
        "canonical_source": snapshot(legacy_file),
    },
    "decision": "reconstruct",
    "disposition_reason": "The legacy structure violates the current dependency order.",
    "current_requirements": [
        {
            "gate_id": gate_id,
            "requirement": "Definitions precede use.",
            "status": "fail" if gate_id == "dependency-order" else "pass",
            "evidence": "Whole-artifact fixture evidence for " + gate_id,
        }
        for gate_id in (
            "artifact-identity",
            "scope-coverage",
            "dependency-order",
            "quality-review",
            "build-and-render",
            "rights-and-privacy",
        )
    ],
    "legacy_artifacts": [
        {
            "path": item["path"],
            "sha256": item["sha256"],
            "disposition": "rework",
            "reason": "This artifact root is covered by the reconstruction decision.",
        }
        for item in universe
    ],
    "legacy_units": [
        {
            "unit_id": "legacy-unit-1",
            "source_path": legacy_file,
            "source_sha256": digest(project / legacy_file),
            "disposition": "rework",
            "reason": "The unit must be repositioned after its dependencies.",
        }
    ],
    "systemic_findings": [
        {
            "finding": "The dependency order is inherited throughout the outline.",
            "scope": "whole artifact",
            "severity": "blocking",
        }
    ],
    "whole_artifact_review": True,
    "replacement_plan": [
        "Derive a new dependency graph from current requirements.",
        "Create a replacement canonical source without extending the legacy outline.",
    ],
    "legacy_roots": [".workspace/source/legacy"],
    "replacement_roots": [".workspace/source/replacement"],
    "independent_review": {
        "reviewer": "independent-reviewer-fixture",
        "independent_from_legacy_authoring": True,
        "decision_confirmed": True,
        "evidence": "Read-only whole-artifact review fixture.",
    },
    "physical_deletion": {"requested": False},
    "draft_status": {"path": "draft/STATUS.md"},
}
pathlib.Path("projects/example/.workspace/records/migration-audit.json").write_text(
    json.dumps(audit, indent=2, sort_keys=True) + "\n", encoding="utf-8"
)
PY

