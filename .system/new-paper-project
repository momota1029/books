#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'usage: .system/new-paper-project <paper-id>\n' >&2
}

fail() {
  printf 'new-paper-project: %s\n' "$1" >&2
  exit 1
}

script_path="${BASH_SOURCE[0]}"
[[ ! -L "$script_path" ]] || fail "script path check failed"
script_dir="$(cd -P -- "$(dirname -- "$script_path")" && pwd)" || \
  fail "repository root is unavailable"
repo_root="$(git -C "$script_dir/.." rev-parse --show-toplevel 2>/dev/null)" || \
  fail "repository root is unavailable"
repo_root="$(cd -P -- "$repo_root" && pwd)" || \
  fail "repository root is unavailable"
[[ "$script_dir" == "$repo_root/.system" ]] || fail "script path check failed"
cd -- "$repo_root"

"$repo_root/.system/doctor"

if (( $# != 1 )); then
  usage
  exit 2
fi

paper_id="$1"
case "$paper_id" in
  AGENTS.md|agents.md|writing|submitted|papers|projects|shared|system|inbox|draft|out|workspace|source|records|tools|build|cache|tmp|logs|locks|snapshots|submissions|readme.md|bootstrap|doctor|repository-mode|sync-mode-excludes|verify-private-remote|new-book-project|new-paper-project)
    fail "paper id is reserved"
    ;;
esac

[[ "$paper_id" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || \
  fail "paper id is invalid"
[[ "$paper_id" != .* ]] || fail "paper id is invalid"
[[ "$paper_id" != *..* ]] || fail "paper id is invalid"
[[ "$paper_id" != */* && "$paper_id" != *\\* ]] || \
  fail "paper id is invalid"

projects_root_path="$repo_root/papers/writing"
[[ -d "$projects_root_path" && ! -L "$projects_root_path" ]] || \
  fail "project root check failed"
projects_root="$(cd -P -- "$projects_root_path" && pwd)" || \
  fail "project root check failed"
[[ "$projects_root" == "$projects_root_path" ]] || \
  fail "project root check failed"

target="$projects_root/$paper_id"
[[ "$(dirname -- "$target")" == "$projects_root" ]] || \
  fail "target path check failed"
[[ ! -e "$target" && ! -L "$target" ]] || fail "target already exists"

created_target=0
keep_target=0
cleanup() {
  status=$?
  trap - EXIT

  if (( created_target == 1 && keep_target == 0 )) && \
    [[ -d "$target" && ! -L "$target" ]]; then
    rm -f -- \
      "$target/.workspace/system-version" \
      "$target/.workspace/records/standards-initialization.json" \
      2>/dev/null || true
    rmdir -- \
      "$target/.workspace/source" \
      "$target/.workspace/records" \
      "$target/.workspace/tools" \
      "$target/.workspace/build" \
      "$target/.workspace/cache" \
      "$target/.workspace/tmp" \
      "$target/.workspace/logs" \
      "$target/.workspace/locks" \
      "$target/inbox" \
      "$target/draft" \
      "$target/out" 2>/dev/null || true
    rmdir -- "$target/.workspace" 2>/dev/null || true
    rmdir -- "$target" 2>/dev/null || true
  fi

  exit "$status"
}
trap cleanup EXIT

umask 077
mkdir -- "$target" 2>/dev/null || fail "project creation failed"
created_target=1
mkdir -- \
  "$target/inbox" \
  "$target/draft" \
  "$target/out" \
  "$target/.workspace" \
  "$target/.workspace/source" \
  "$target/.workspace/records" \
  "$target/.workspace/tools" \
  "$target/.workspace/build" \
  "$target/.workspace/cache" \
  "$target/.workspace/tmp" \
  "$target/.workspace/logs" \
  "$target/.workspace/locks" 2>/dev/null || fail "project creation failed"

head_commit="$(git rev-parse --verify 'HEAD^{commit}' 2>/dev/null)" || \
  fail "HEAD commit is unavailable"
[[ "$head_commit" =~ ^[0-9a-f]{40,64}$ ]] || \
  fail "HEAD commit is unavailable"
if ! { printf '%s\n' "$head_commit" >"$target/.workspace/system-version"; } 2>/dev/null; then
  fail "system version could not be recorded"
fi
"$repo_root/.system/standards-migration" initialize \
  --scope "papers/writing/$paper_id" >/dev/null || \
  fail "standards baseline could not be initialized"

relative_target="papers/writing/$paper_id"
mode="$(git config --local --get books.repositoryMode 2>/dev/null)" || \
  fail "repository mode check failed"
git check-ignore --no-index -q -- "$relative_target/" >/dev/null 2>&1 && \
  ignore_status=0 || ignore_status=$?
case "$mode:$ignore_status" in
  public:0|private:1)
    ;;
  public:*)
    fail "public private-path ignore check failed"
    ;;
  private:*)
    fail "private path staging check failed"
    ;;
  *)
    fail "repository mode check failed"
    ;;
esac

keep_target=1
printf 'new-paper-project: ok\n'
