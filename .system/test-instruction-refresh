#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C
export GIT_CONFIG_GLOBAL=/dev/null
export GIT_CONFIG_SYSTEM=/dev/null

source_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
test_root=$(mktemp -d)

cleanup() {
  if [[ -n ${test_root:-} && -d $test_root ]]; then
    rm -rf -- "$test_root"
  fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

fail() {
  printf 'not ok %s - %s\n' "$1" "$2" >&2
  exit 1
}

pass() {
  printf 'ok %s - %s\n' "$1" "$2"
}

capture_status() {
  local output_file=$1
  local expected_status=$2
  shift 2
  local actual_status

  if "$@" >"$output_file" 2>&1; then
    actual_status=0
  else
    actual_status=$?
  fi
  [[ $actual_status == "$expected_status" ]]
}

repo_dir=$test_root/repository
mkdir -p "$repo_dir/.system" "$repo_dir/.githooks" \
  "$repo_dir/papers/writing/example"
cp -- "$source_root/.system/instruction-refresh" "$repo_dir/.system/"
cp -- "$source_root/.system/standards-migration" "$repo_dir/.system/"
cp -- "$source_root/.githooks/post-merge" "$repo_dir/.githooks/"
printf '#!/usr/bin/env bash\nexit 0\n' >"$repo_dir/.system/sync-mode-excludes"
chmod +x "$repo_dir/.system/instruction-refresh" \
  "$repo_dir/.system/standards-migration" \
  "$repo_dir/.system/sync-mode-excludes" "$repo_dir/.githooks/post-merge"

printf 'root instructions\n' >"$repo_dir/AGENTS.md"
printf 'routing instructions\n' >"$repo_dir/WORKFLOW_ROUTING.md"
printf 'writing instructions\n' >"$repo_dir/JAPANESE_WRITING.md"
printf 'review instructions\n' >"$repo_dir/MATH_PROSE_REVIEW.md"
printf 'paper instructions\n' >"$repo_dir/papers/AGENTS.md"
printf 'unrelated\n' >"$repo_dir/notes.txt"

git init -q "$repo_dir"
cd "$repo_dir"
git config --local user.name 'Instruction Refresh Test'
git config --local user.email 'instruction-refresh@example.invalid'
git config --local core.hooksPath .githooks
git add -- AGENTS.md WORKFLOW_ROUTING.md JAPANESE_WRITING.md \
  MATH_PROSE_REVIEW.md notes.txt papers/AGENTS.md .system .githooks
git commit -q -m 'test fixture'

export CODEX_THREAD_ID=thread-one
output_file=$test_root/output
if capture_status "$output_file" 3 .system/instruction-refresh check \
    --scope papers/writing/example &&
  grep -Fq -- 'no acknowledged instruction snapshot' "$output_file" &&
  grep -Fq -- 'papers/AGENTS.md' "$output_file"; then
  pass 1 'unacknowledged thread detection and applicable source listing'
else
  fail 1 'unacknowledged thread detection and applicable source listing'
fi

if .system/instruction-refresh ack --scope papers/writing/example >/dev/null &&
  .system/instruction-refresh check --scope papers/writing/example >/dev/null; then
  pass 2 'acknowledgment and unchanged generation'
else
  fail 2 'acknowledgment and unchanged generation'
fi

printf 'root instructions changed\n' >AGENTS.md
if capture_status "$output_file" 3 .system/instruction-refresh check &&
  grep -Fq -- 'modified: AGENTS.md' "$output_file" &&
  capture_status "$output_file" 3 .system/instruction-refresh check &&
  .system/instruction-refresh ack --scope papers/writing/example >/dev/null &&
  .system/instruction-refresh check >/dev/null; then
  pass 3 'changed generation remains pending until explicit acknowledgment'
else
  fail 3 'changed generation remains pending until explicit acknowledgment'
fi

printf 'unrelated change\n' >notes.txt
if .system/instruction-refresh check >/dev/null; then
  pass 4 'unrelated file changes do not invalidate instructions'
else
  fail 4 'unrelated file changes do not invalidate instructions'
fi

if capture_status "$output_file" 3 .system/instruction-refresh check \
    --scope . &&
  grep -Fq -- 'scope changed: papers/writing/example -> .' "$output_file" &&
  .system/instruction-refresh ack --scope . >/dev/null; then
  pass 5 'scope changes require rereading the applicable chain'
else
  fail 5 'scope changes require rereading the applicable chain'
fi

git_dir=$(git rev-parse --absolute-git-dir)
thread_key=$(python3 - <<'PY'
import hashlib

print(hashlib.sha256(b"thread-one").hexdigest())
PY
)
state_file=$git_dir/codex-instruction-refresh/$thread_key.state
legacy_state=$test_root/legacy-instruction-state
awk -F '\t' '
  BEGIN { OFS = "\t" }
  $1 == "VERSION" { print $1, "1"; next }
  $1 == "FILE" { print $1, $2, $4; next }
  { print }
' "$state_file" >"$legacy_state"
mv -- "$legacy_state" "$state_file"
if capture_status "$output_file" 3 .system/instruction-refresh check --scope . &&
  grep -Fq -- 'modified: AGENTS.md' "$output_file" &&
  ! grep -Fq -- 'added: AGENTS.md' "$output_file" &&
  .system/instruction-refresh ack --scope . >/dev/null; then
  pass manifest-v1 'legacy manifests are upgraded as modified records, not additions'
else
  fail manifest-v1 'legacy manifest compatibility'
fi

export CODEX_THREAD_ID=thread-two
if capture_status "$output_file" 3 .system/instruction-refresh check --scope . &&
  grep -Fq -- 'no acknowledged instruction snapshot' "$output_file"; then
  pass 6 'thread state isolation'
else
  fail 6 'thread state isolation'
fi

export CODEX_THREAD_ID=thread-one
if capture_status "$output_file" 2 .system/instruction-refresh ack; then
  pass 7 'acknowledgment requires an explicit scope'
else
  fail 7 'acknowledgment requires an explicit scope'
fi

chmod -x .githooks/post-merge
if capture_status "$output_file" 3 .system/instruction-refresh check --scope . &&
  grep -Fq -- 'modified: .githooks/post-merge' "$output_file"; then
  chmod +x .githooks/post-merge
  .system/instruction-refresh check --scope . >/dev/null
  pass 8 'mode-only instruction changes invalidate the generation'
else
  fail 8 'mode-only instruction changes invalidate the generation'
fi

git add -- AGENTS.md notes.txt
git commit -q -m 'prepare merge baseline'
git switch -q -c instruction-update
printf 'root instructions after merge\n' >AGENTS.md
git add -- AGENTS.md
git commit -q -m 'change instructions'
git switch -q master
if git merge --no-edit instruction-update >"$output_file" 2>&1 &&
  grep -Fq -- 'instruction sources changed' "$output_file" &&
  grep -Fq -- 'modified: AGENTS.md' "$output_file" &&
  capture_status "$output_file" 3 .system/instruction-refresh check; then
  pass 9 'post-merge notice without implicit acknowledgment'
else
  fail 9 'post-merge notice without implicit acknowledgment'
fi

.system/instruction-refresh ack --scope . >/dev/null
git switch -q -c instruction-rename
git mv -- papers/AGENTS.md papers/POLICY.md
git commit -q -m 'rename nested instructions'
git switch -q master
if git merge --no-edit instruction-rename >"$output_file" 2>&1 &&
  grep -Fq -- 'instruction sources changed' "$output_file" &&
  grep -Fq -- 'papers/AGENTS.md' "$output_file"; then
  pass 10 'renamed-away instruction source notification'
else
  fail 10 'renamed-away instruction source notification'
fi

git_dir=$(git rev-parse --absolute-git-dir)
state_dir=$git_dir/codex-instruction-refresh
saved_state_dir=$git_dir/codex-instruction-refresh.saved
outside_state=$test_root/outside-state
mv -- "$state_dir" "$saved_state_dir"
mkdir -- "$outside_state"
ln -s -- "$outside_state" "$state_dir"
if capture_status "$output_file" 1 .system/instruction-refresh check --scope . &&
  grep -Fq -- 'per-thread state directory is unsafe' "$output_file" &&
  [[ -z $(find "$outside_state" -mindepth 1 -print -quit) ]]; then
  rm -- "$state_dir"
  mv -- "$saved_state_dir" "$state_dir"
  pass 11 'symlinked state directory rejection'
else
  fail 11 'symlinked state directory rejection'
fi
