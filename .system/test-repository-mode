#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C
export GIT_CONFIG_GLOBAL=/dev/null
export GIT_CONFIG_SYSTEM=/dev/null
export GIT_TERMINAL_PROMPT=0

source_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
real_git=$(command -v git)
test_root=$(mktemp -d)

cleanup() {
  if [[ -n ${test_root:-} && -d $test_root ]]; then
    rm -rf -- "$test_root"
  fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

fail() {
  printf 'not ok %s - %s\n' "$1" "$2" >&2
  exit 1
}

pass() {
  printf 'ok %s - %s\n' "$1" "$2"
}

rewrite_with_sed() {
  local expression=$1
  local target=$2
  local temporary

  temporary=$(mktemp "$test_root/.sed.XXXXXX") || return 1
  if sed "$expression" "$target" >"$temporary"; then
    mv -- "$temporary" "$target"
  else
    rm -f -- "$temporary"
    return 1
  fi
}

expect_success() {
  "$@" >/dev/null 2>&1
}

expect_failure() {
  if "$@" >/dev/null 2>&1; then
    return 1
  fi
}

repo_dir=$test_root/repository
fake_bin=$test_root/bin
mkdir -p "$repo_dir/.system" "$repo_dir/.githooks" "$fake_bin"

cp -- "$source_root/.system/verify-private-remote" \
  "$source_root/.system/private-checkpoint" \
  "$source_root/.system/repository-mode" \
  "$source_root/.system/sync-mode-excludes" "$repo_dir/.system/"
cp -- "$source_root/.githooks/check-public-tree" \
  "$source_root/.githooks/post-merge" \
  "$source_root/.githooks/pre-commit" \
  "$source_root/.githooks/pre-push" "$repo_dir/.githooks/"
chmod +x "$repo_dir/.system/verify-private-remote" \
  "$repo_dir/.system/private-checkpoint" \
  "$repo_dir/.system/repository-mode" \
  "$repo_dir/.system/sync-mode-excludes" \
  "$repo_dir/.githooks/check-public-tree" \
  "$repo_dir/.githooks/post-merge" \
  "$repo_dir/.githooks/pre-commit" \
  "$repo_dir/.githooks/pre-push"

cat >"$fake_bin/gh" <<'FAKE_GH'
#!/usr/bin/env bash
set -euo pipefail

if (( $# != 7 )) || [[ $1 != repo || $2 != view || $4 != --json ||
  $5 != visibility,nameWithOwner || $6 != --jq ||
  $7 != '[.visibility, .nameWithOwner] | @tsv' ]]; then
  exit 2
fi

case ${FAKE_VISIBILITY:-} in
  PRIVATE|PUBLIC) ;;
  *) exit 2 ;;
esac

name_with_owner=${3#*/}
if [[ $name_with_owner != */* || $name_with_owner == */*/* ]]; then
  exit 2
fi

printf '%s\t%s\n' "$FAKE_VISIBILITY" "$name_with_owner"
FAKE_GH
chmod +x "$fake_bin/gh"
export PATH="$fake_bin:$PATH"

cat >"$repo_dir/.public-files" <<'ALLOWLIST'
.public-files
.gitignore
.githooks/check-public-tree
.githooks/post-merge
.githooks/pre-commit
.githooks/pre-push
.system/repository-mode
.system/private-checkpoint
.system/sync-mode-excludes
.system/verify-private-remote
public.txt
ALLOWLIST
cp -- "$source_root/.gitignore" "$repo_dir/.gitignore"
printf 'public fixture\n' >"$repo_dir/public.txt"

git init -q "$repo_dir"
cd "$repo_dir"
git config --local user.name 'Repository Mode Test'
git config --local user.email 'repository-mode@example.invalid'
git config --local core.hooksPath .githooks
git add -- .public-files .gitignore .githooks .system public.txt
git commit -q -m 'initial public tree'
printf '\n*.user-local\n' >>.git/info/exclude
.system/sync-mode-excludes >/dev/null
.system/sync-mode-excludes >/dev/null
[[ $(grep -Fxc -- '# BEGIN books repository-mode managed excludes' \
  .git/info/exclude) == 1 ]] || fail 1 'managed exclude idempotence'

cp -- .public-files "$test_root/public-files.clean"
printf '# comment\rhidden.txt\n' >>.public-files
printf 'must remain unapproved\n' >hidden.txt
git add -- .public-files hidden.txt
if expect_failure .githooks/check-public-tree --index; then
  pass allowlist-lines 'only LF delimits public allowlist records'
else
  fail allowlist-lines 'non-LF allowlist content approved a tracked path'
fi
git reset -q -- .public-files hidden.txt
mv -- "$test_root/public-files.clean" .public-files
rm -- hidden.txt

remote_name=storage
remote_url=https://github.com/example-owner/example-repository.git
private_path=book-translations/example/inbox/data.txt
user_ignored_path=book-translations/example/inbox/notes.user-local
git remote add "$remote_name" "$remote_url"

status_output=$(.system/repository-mode status 2>/dev/null) ||
  fail 1 'default status'
if [[ $status_output == 'mode=public' ]] &&
  ! git config --local --get books.repositoryMode >/dev/null 2>&1; then
  pass 1 'default status'
else
  fail 1 'default status'
fi

if expect_failure env FAKE_VISIBILITY=PUBLIC \
  .system/repository-mode private "$remote_name" &&
  [[ $(.system/repository-mode status 2>/dev/null) == 'mode=public' ]]; then
  pass 2 'public visibility rejection'
else
  fail 2 'public visibility rejection'
fi

printf '%s\n' '# BEGIN books repository-mode managed excludes' \
  >>.git/info/exclude
if ! expect_failure env FAKE_VISIBILITY=PRIVATE \
    .system/repository-mode private "$remote_name" ||
  [[ $(.system/repository-mode status 2>/dev/null) != 'mode=public' ]] ||
  git config --local --get books.privateRemote >/dev/null 2>&1 ||
  git config --local --get books.privateBase >/dev/null 2>&1; then
  fail 3 'failed transition rollback'
fi
rewrite_with_sed '$d' .git/info/exclude
.system/sync-mode-excludes >/dev/null

base_oid=$(git rev-parse --verify 'HEAD^{commit}')
if git check-ignore --no-index -q -- "$private_path" &&
  expect_success env FAKE_VISIBILITY=PRIVATE \
  .system/repository-mode private "$remote_name" &&
  [[ $(git config --local --get books.repositoryMode) == private ]] &&
  [[ $(git config --local --get books.privateRemote) == "$remote_name" ]] &&
  [[ $(git config --local --get books.privateBase) == "$base_oid" ]] &&
  [[ $(grep -Fxc -- '*.user-local' .git/info/exclude) == 1 ]] &&
  ! grep -Fq -- '# BEGIN books repository-mode managed excludes' \
    .git/info/exclude; then
  pass 3 'private mode metadata'
else
  fail 3 'private mode metadata'
fi
export FAKE_VISIBILITY=PRIVATE

mkdir -p "$(dirname -- "$private_path")"
printf 'temporary fixture\n' >"$private_path"
printf 'user ignored fixture\n' >"$user_ignored_path"
if ! git check-ignore --no-index -q -- "$private_path" &&
  git check-ignore --no-index -q -- "$user_ignored_path" &&
  expect_success git add . &&
  [[ $(git diff --cached --name-only --diff-filter=A) == "$private_path" ]] &&
  expect_success git reset -q &&
  expect_failure env FAKE_VISIBILITY=PRIVATE \
    .system/repository-mode add -- "$user_ignored_path" &&
  git diff --cached --quiet &&
  expect_success env FAKE_VISIBILITY=PRIVATE \
    .system/repository-mode add -- "$private_path" &&
  [[ $(git diff --cached --name-only --diff-filter=A) == "$private_path" ]]; then
  pass 4 'ordinary private content staging'
else
  fail 4 'ordinary private content staging'
fi

if expect_success env FAKE_VISIBILITY=PRIVATE .githooks/pre-commit &&
  expect_failure env FAKE_VISIBILITY=PUBLIC .githooks/pre-commit; then
  pass 5 'commit guard visibility'
else
  fail 5 'commit guard visibility'
fi

git commit -q -m 'temporary content'
git rm -q -- "$private_path"
git commit -q -m 'remove temporary content'
if expect_failure .system/repository-mode public &&
  [[ $(git config --local --get books.repositoryMode) == private ]]; then
  pass 6 'history contamination rejection'
else
  fail 6 'history contamination rejection'
fi

git switch -q -c public-base "$base_oid"
printf '%s\n' '# BEGIN books repository-mode managed excludes' \
  >>.git/info/exclude
if ! expect_failure .system/repository-mode public ||
  [[ $(git config --local --get books.repositoryMode) != private ]] ||
  [[ $(git config --local --get books.privateRemote) != "$remote_name" ]] ||
  [[ $(git config --local --get books.privateBase) != "$base_oid" ]]; then
  fail 7 'failed transition rollback'
fi
rewrite_with_sed '$d' .git/info/exclude
.system/sync-mode-excludes >/dev/null
if expect_success .system/repository-mode public &&
  [[ $(git config --local --get books.repositoryMode) == public ]] &&
  ! git config --local --get books.privateRemote >/dev/null 2>&1 &&
  ! git config --local --get books.privateBase >/dev/null 2>&1 &&
  git check-ignore --no-index -q -- "$private_path" &&
  [[ $(grep -Fxc -- '*.user-local' .git/info/exclude) == 1 ]] &&
  [[ $(grep -Fxc -- '# BEGIN books repository-mode managed excludes' \
    .git/info/exclude) == 1 ]] &&
  mkdir -p "$(dirname -- "$private_path")" &&
  printf 'public guard fixture\n' >"$private_path" &&
  expect_success git add . &&
  git diff --cached --quiet &&
  expect_success git add -f -- "$private_path" &&
  expect_failure .githooks/pre-commit &&
  expect_success git reset -q; then
  pass 7 'clean baseline restoration'
else
  fail 7 'clean baseline restoration'
fi

git switch -q -c merge-source
printf 'post-merge fixture\n' >>public.txt
git add -- public.txt
git commit -q -m 'post-merge fixture'
git switch -q public-base
rewrite_with_sed \
  '/^# BEGIN books repository-mode managed excludes$/,/^# END books repository-mode managed excludes$/d' \
  .git/info/exclude
if ! grep -Fq -- '# BEGIN books repository-mode managed excludes' \
    .git/info/exclude &&
  git merge -q --ff-only merge-source &&
  [[ $(grep -Fxc -- '# BEGIN books repository-mode managed excludes' \
    .git/info/exclude) == 1 ]] &&
  [[ $(grep -Fxc -- '*.user-local' .git/info/exclude) == 1 ]]; then
  pass 8 'post-merge exclude synchronization'
else
  fail 8 'post-merge exclude synchronization'
fi

git config --add "remote.${remote_name}.pushurl" "$remote_url"
git config --add "remote.${remote_name}.pushurl" \
  https://github.com/example-owner/example-mirror.git
if expect_failure env FAKE_VISIBILITY=PRIVATE \
  .system/verify-private-remote "$remote_name" &&
  expect_failure env FAKE_VISIBILITY=PRIVATE \
    .system/repository-mode private "$remote_name"; then
  pass 9 'ambiguous push URL rejection'
else
  fail 9 'ambiguous push URL rejection'
fi
git config --unset-all "remote.${remote_name}.pushurl"

git config --add "remote.${remote_name}.pushurl" "$remote_url"$'\n'
if expect_failure env FAKE_VISIBILITY=PRIVATE \
  .system/verify-private-remote "$remote_name" &&
  expect_failure env FAKE_VISIBILITY=PRIVATE \
  .system/repository-mode private "$remote_name"; then
  pass url-newline 'push URLs containing an embedded trailing LF are rejected'
else
  fail url-newline 'push URL trailing LF was normalized and accepted'
fi
git config --unset-all "remote.${remote_name}.pushurl"

expect_success env FAKE_VISIBILITY=PRIVATE \
  .system/repository-mode private "$remote_name" ||
  fail 10 'push guard verification'
if expect_success env FAKE_VISIBILITY=PRIVATE \
  .githooks/pre-push "$remote_name" "$remote_url" </dev/null &&
  expect_failure env FAKE_VISIBILITY=PUBLIC \
    .githooks/pre-push "$remote_name" "$remote_url" </dev/null &&
  expect_failure env FAKE_VISIBILITY=PRIVATE \
    .githooks/pre-push alternate "$remote_url" </dev/null; then
  pass 10 'push guard verification'
else
  fail 10 'push guard verification'
fi

cat >.system/instruction-refresh <<'REFRESH'
#!/usr/bin/env bash
set -euo pipefail
[[ ${1:-} == check && ${2:-} == --scope && -n ${3:-} && $# == 3 ]]
REFRESH
chmod +x .system/instruction-refresh

checkpoint_project=papers/writing/checkpoint-example
mkdir -p -- \
  "$checkpoint_project/inbox" \
  "$checkpoint_project/draft" \
  "$checkpoint_project/out" \
  "$checkpoint_project/.workspace/source" \
  "$checkpoint_project/.workspace/build" \
  "$checkpoint_project/.workspace/cache" \
  "$checkpoint_project/.workspace/tmp" \
  "$checkpoint_project/.workspace/logs" \
  "$checkpoint_project/.workspace/blocked"
printf '/blocked/\n' >"$checkpoint_project/.workspace/.gitignore"
printf 'previously ignored fixture\n' \
  >"$checkpoint_project/.workspace/blocked/data.txt"

git update-ref "refs/remotes/$remote_name/checkpoint" HEAD
git branch --set-upstream-to="$remote_name/checkpoint" >/dev/null

if expect_failure env FAKE_VISIBILITY=PRIVATE \
    .system/private-checkpoint --scope "$checkpoint_project" \
      --message 'checkpoint without storage review' &&
  expect_failure env FAKE_VISIBILITY=PRIVATE \
    .system/private-checkpoint --scope "$checkpoint_project" \
      --message 'checkpoint with ignored state' --confirm-storage-reviewed &&
  git diff --cached --quiet; then
  pass checkpoint-rejection 'checkpoint requires review confirmation and rejects ignored private state'
else
  fail checkpoint-rejection 'checkpoint accepted unreviewed or ignored private state'
fi

printf '%s\n' \
  '# Verified private mode tracks every permitted .workspace file.' \
  >"$checkpoint_project/.workspace/.gitignore"
printf 'canonical fixture\n' >"$checkpoint_project/.workspace/source/main.tex"
printf 'build fixture\n' >"$checkpoint_project/.workspace/build/document.pdf"
tex_artifacts=(
  document.aux
  document.log
  document.fls
  document.fdb_latexmk
  document.synctex
  document.synctex.gz
  document.bbl
  document.blg
  document.toc
  document.out
  document.run.xml
)
for tex_artifact in "${tex_artifacts[@]}"; do
  printf 'TeX recovery fixture: %s\n' "$tex_artifact" \
    >"$checkpoint_project/.workspace/build/$tex_artifact"
done
printf 'cache fixture\n' >"$checkpoint_project/.workspace/cache/state.bin"
printf 'temporary fixture\n' >"$checkpoint_project/.workspace/tmp/work.state"
printf 'log fixture\n' >"$checkpoint_project/.workspace/logs/build.log"
printf 'input fixture\n' >"$checkpoint_project/inbox/input.txt"
printf 'draft fixture\n' >"$checkpoint_project/draft/STATUS.md"
printf 'output fixture\n' >"$checkpoint_project/out/result.txt"

export REAL_GIT=$real_git
export CHECKPOINT_PUSH_LOG=$test_root/checkpoint-push.log
cat >"$fake_bin/git" <<'FAKE_GIT'
#!/usr/bin/env bash
set -euo pipefail

if [[ ${1:-} == push ]]; then
  (( $# == 3 )) || exit 2
  remote_name=$2
  refspec=$3
  case "$refspec" in
    HEAD:refs/heads/*) ;;
    *) exit 2 ;;
  esac
  remote_branch=${refspec#HEAD:refs/heads/}
  if [[ ${FAKE_PUSH_SKIP_UPDATE:-0} != 1 ]]; then
    "$REAL_GIT" update-ref "refs/remotes/$remote_name/$remote_branch" HEAD
  fi
  printf '%s %s\n' "$remote_name" "$refspec" >"$CHECKPOINT_PUSH_LOG"
  exit 0
fi

if [[ ${1:-} == ls-remote ]]; then
  (( $# == 5 )) || exit 2
  [[ $2 == --exit-code && $3 == --refs ]] || exit 2
  remote_name=$4
  remote_ref=$5
  case "$remote_ref" in
    refs/heads/*) ;;
    *) exit 2 ;;
  esac
  remote_branch=${remote_ref#refs/heads/}
  remote_oid=$("$REAL_GIT" rev-parse --verify \
    "refs/remotes/$remote_name/$remote_branch") || exit 2
  printf '%s\t%s\n' "$remote_oid" "$remote_ref"
  exit 0
fi

exec "$REAL_GIT" "$@"
FAKE_GIT
chmod +x "$fake_bin/git"

printf 'pre-existing ahead fixture\n' >>public.txt
git add -- public.txt
git commit -q -m 'pre-existing unpushed commit'
if expect_failure env FAKE_VISIBILITY=PRIVATE \
    .system/private-checkpoint --scope "$checkpoint_project" \
      --message 'checkpoint with pre-existing ahead commit' \
      --confirm-storage-reviewed &&
  git diff --cached --quiet; then
  pass checkpoint-ahead-rejection 'checkpoint refuses pre-existing unpushed commits'
else
  fail checkpoint-ahead-rejection 'checkpoint pushed a commit owned by another work unit'
fi
git update-ref "refs/remotes/$remote_name/checkpoint" HEAD

nested_repository=$checkpoint_project/.workspace/nested-repository
git init -q "$nested_repository"
git -C "$nested_repository" config user.name 'Nested Repository Test'
git -C "$nested_repository" config user.email nested@example.invalid
printf 'nested ordinary file\n' >"$nested_repository/data.txt"
git -C "$nested_repository" add -- data.txt
git -C "$nested_repository" commit -q -m 'nested fixture'
if expect_failure env FAKE_VISIBILITY=PRIVATE \
    .system/private-checkpoint --scope "$checkpoint_project" \
      --message 'checkpoint with nested repository' \
      --confirm-storage-reviewed &&
  git diff --cached --quiet; then
  pass checkpoint-gitlink-rejection 'checkpoint rejects nested Git repositories'
else
  fail checkpoint-gitlink-rejection 'checkpoint replaced ordinary files with a Git link'
fi
mv -- "$nested_repository" "$test_root/nested-repository-rejected"

checkpoint_output=$(env FAKE_VISIBILITY=PRIVATE \
  .system/private-checkpoint --scope "$checkpoint_project" \
    --message 'private recovery checkpoint' --confirm-storage-reviewed \
    2>&1) || {
  printf '%s\n' "$checkpoint_output" >&2
  fail private-checkpoint 'checkpoint command failed'
}

all_tex_artifacts_tracked=1
for tex_artifact in "${tex_artifacts[@]}"; do
  if ! git cat-file -e \
      "HEAD:$checkpoint_project/.workspace/build/$tex_artifact"; then
    all_tex_artifacts_tracked=0
    break
  fi
done

if grep -Fq 'push=ok dirty=0 ahead=0 created=yes' <<<"$checkpoint_output" &&
  grep -Fqx "$remote_name HEAD:refs/heads/checkpoint" "$CHECKPOINT_PUSH_LOG" &&
  git diff --cached --quiet &&
  [[ -z $(git status --porcelain --untracked-files=all -- \
    "$checkpoint_project/inbox" "$checkpoint_project/draft" \
    "$checkpoint_project/out" "$checkpoint_project/.workspace") ]] &&
  [[ -z $(git ls-files --others --ignored --exclude-standard -- \
    "$checkpoint_project/.workspace") ]] &&
  git cat-file -e "HEAD:$checkpoint_project/.workspace/blocked/data.txt" &&
  git cat-file -e "HEAD:$checkpoint_project/.workspace/build/document.pdf" &&
  git cat-file -e "HEAD:$checkpoint_project/.workspace/cache/state.bin" &&
  git cat-file -e "HEAD:$checkpoint_project/.workspace/tmp/work.state" &&
  git cat-file -e "HEAD:$checkpoint_project/.workspace/logs/build.log" &&
  (( all_tex_artifacts_tracked == 1 )) &&
  [[ $(git rev-list --left-right --count \
    "$remote_name/checkpoint...HEAD") == $'0\t0' ]]; then
  pass private-checkpoint 'checkpoint commits every permitted private project file and pushes it'
else
  fail private-checkpoint 'checkpoint did not close private project state'
fi

printf 'remote verification fixture\n' \
  >>"$checkpoint_project/.workspace/source/main.tex"
if expect_failure env FAKE_VISIBILITY=PRIVATE FAKE_PUSH_SKIP_UPDATE=1 \
    .system/private-checkpoint --scope "$checkpoint_project" \
      --message 'checkpoint whose fake push is not stored remotely' \
      --confirm-storage-reviewed &&
  git diff --cached --quiet &&
  [[ $(git rev-parse --verify "$remote_name/checkpoint") != \
    $(git rev-parse --verify 'HEAD^{commit}') ]]; then
  pass checkpoint-remote-verification 'checkpoint verifies the actual remote branch OID'
else
  fail checkpoint-remote-verification 'checkpoint trusted a local push result without remote storage'
fi
git update-ref "refs/remotes/$remote_name/checkpoint" HEAD

checkpoint_head=$(git rev-parse --verify 'HEAD^{commit}')
checkpoint_output=$(env FAKE_VISIBILITY=PRIVATE \
  .system/private-checkpoint --scope "$checkpoint_project" \
    --message 'unchanged private recovery checkpoint' \
    --confirm-storage-reviewed 2>&1) || {
  printf '%s\n' "$checkpoint_output" >&2
  fail private-checkpoint-noop 'unchanged checkpoint command failed'
}

if grep -Fq 'push=ok dirty=0 ahead=0 created=no' <<<"$checkpoint_output" &&
  [[ $(git rev-parse --verify 'HEAD^{commit}') == "$checkpoint_head" ]] &&
  [[ $(git rev-list --left-right --count \
    "$remote_name/checkpoint...HEAD") == $'0\t0' ]]; then
  pass private-checkpoint-noop 'unchanged checkpoint pushes without an empty commit'
else
  fail private-checkpoint-noop 'unchanged checkpoint created a commit or left unpushed state'
fi

# Public-mode pre-push is intentionally out of scope here: the copied hook has
# a source-repository-specific audited baseline OID that this synthetic history
# cannot contain. That path has been reviewed separately in the source repo.

git config --local books.repositoryMode invalid
if expect_failure .system/repository-mode status &&
  expect_failure .githooks/pre-commit &&
  expect_failure .githooks/pre-push "$remote_name" "$remote_url" </dev/null; then
  pass 11 'invalid mode rejection'
else
  fail 11 'invalid mode rejection'
fi
