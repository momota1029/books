#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C
export GIT_CONFIG_GLOBAL=/dev/null
export GIT_CONFIG_SYSTEM=/dev/null

source_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
test_root=$(mktemp -d)

cleanup() {
  if [[ -n ${test_root:-} && -d $test_root ]]; then
    rm -rf -- "$test_root"
  fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

fail() {
  printf 'not ok %s - %s\n' "$1" "$2" >&2
  exit 1
}

pass() {
  printf 'ok %s - %s\n' "$1" "$2"
}

expect_failure() {
  if "$@" >/dev/null 2>&1; then
    return 1
  fi
}

repo_dir=$test_root/repository
mkdir -p "$repo_dir/.system" "$repo_dir/.githooks" \
  "$repo_dir/paper-lecture-notes"
cp -- "$source_root/.system/new-paper-note-project" \
  "$source_root/.system/standards-migration" \
  "$source_root/.system/sync-mode-excludes" "$repo_dir/.system/"
printf '#!/usr/bin/env bash\nexit 0\n' >"$repo_dir/.system/doctor"
printf 'root instructions\n' >"$repo_dir/AGENTS.md"
printf 'routing instructions\n' >"$repo_dir/WORKFLOW_ROUTING.md"
printf 'writing instructions\n' >"$repo_dir/JAPANESE_WRITING.md"
printf 'review instructions\n' >"$repo_dir/MATH_PROSE_REVIEW.md"
printf 'refresh checker\n' >"$repo_dir/.system/instruction-refresh"
printf 'post-merge hook\n' >"$repo_dir/.githooks/post-merge"
printf '%s\n' '# shared instructions' >"$repo_dir/paper-lecture-notes/AGENTS.md"
chmod +x "$repo_dir/.system/new-paper-note-project" \
  "$repo_dir/.system/standards-migration" \
  "$repo_dir/.system/sync-mode-excludes" "$repo_dir/.system/doctor"

git init -q "$repo_dir"
cd "$repo_dir"
git config --local user.name 'Paper Note Project Test'
git config --local user.email 'paper-note-project@example.invalid'
git config --local books.repositoryMode public
git add -- .system .githooks AGENTS.md WORKFLOW_ROUTING.md \
  JAPANESE_WRITING.md MATH_PROSE_REVIEW.md paper-lecture-notes/AGENTS.md
git commit -q -m 'test fixture'
.system/sync-mode-excludes public >/dev/null

if .system/new-paper-note-project alpha >/dev/null &&
  [[ -d paper-lecture-notes/alpha/inbox ]] &&
  [[ -d paper-lecture-notes/alpha/draft ]] &&
  [[ -d paper-lecture-notes/alpha/out ]] &&
  [[ -d paper-lecture-notes/alpha/.workspace/source ]] &&
  [[ -d paper-lecture-notes/alpha/.workspace/records ]] &&
  [[ -d paper-lecture-notes/alpha/.workspace/tools ]] &&
  [[ -d paper-lecture-notes/alpha/.workspace/review ]] &&
  [[ -d paper-lecture-notes/alpha/.workspace/build ]] &&
  [[ -d paper-lecture-notes/alpha/.workspace/cache ]] &&
  [[ -d paper-lecture-notes/alpha/.workspace/tmp ]] &&
  [[ -d paper-lecture-notes/alpha/.workspace/logs ]] &&
  [[ -d paper-lecture-notes/alpha/.workspace/locks ]] &&
  [[ $(<paper-lecture-notes/alpha/.workspace/project-id) == alpha ]] &&
  [[ $(<paper-lecture-notes/alpha/.workspace/system-version) == \
    $(git rev-parse --verify 'HEAD^{commit}') ]] &&
  [[ -f paper-lecture-notes/alpha/.workspace/records/standards-initialization.json ]] &&
  .system/standards-migration check --scope paper-lecture-notes/alpha \
    --operation extend >/dev/null &&
  git check-ignore --no-index -q -- paper-lecture-notes/alpha/; then
  pass 1 'public project creation and privacy guard'
else
  fail 1 'public project creation and privacy guard'
fi

if expect_failure .system/new-paper-note-project alpha &&
  expect_failure .system/new-paper-note-project ../escape &&
  expect_failure .system/new-paper-note-project alpha_beta &&
  expect_failure .system/new-paper-note-project alpha.beta &&
  expect_failure .system/new-paper-note-project inbox &&
  [[ ! -e paper-lecture-notes/escape ]]; then
  pass 2 'invalid, reserved, and duplicate target rejection'
else
  fail 2 'invalid, reserved, and duplicate target rejection'
fi

mv -- paper-lecture-notes paper-lecture-notes-real
ln -s -- paper-lecture-notes-real paper-lecture-notes
if expect_failure .system/new-paper-note-project symlinked &&
  [[ ! -e paper-lecture-notes-real/symlinked ]]; then
  pass 3 'symlinked collection root rejection'
else
  fail 3 'symlinked collection root rejection'
fi
rm -- paper-lecture-notes
mv -- paper-lecture-notes-real paper-lecture-notes

git config --local books.repositoryMode private
.system/sync-mode-excludes private >/dev/null
if .system/new-paper-note-project beta >/dev/null &&
  ! git check-ignore --no-index -q -- paper-lecture-notes/beta/ &&
  [[ -d paper-lecture-notes/beta/.workspace/records ]]; then
  pass 4 'private project staging availability'
else
  fail 4 'private project staging availability'
fi

git config --local books.repositoryMode invalid
if expect_failure .system/new-paper-note-project gamma &&
  [[ ! -e paper-lecture-notes/gamma ]]; then
  pass 5 'invalid mode rejection and cleanup'
else
  fail 5 'invalid mode rejection and cleanup'
fi
