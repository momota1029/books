def repo_root() -> pathlib.Path:
    root = pathlib.Path(__file__).resolve().parent.parent
    if not (root / ".system" / "paper-evidence-harness").is_file():
        raise HarnessError("repository root check failed")
    return root


def ensure_within(path: pathlib.Path, parent: pathlib.Path) -> pathlib.Path:
    resolved = path.resolve()
    try:
        resolved.relative_to(parent.resolve())
    except ValueError as exc:
        raise HarnessError("path escapes the repository or project") from exc
    return resolved


def project_path(value: str) -> pathlib.Path:
    root = repo_root()
    raw = pathlib.Path(value)
    candidate = raw if raw.is_absolute() else root / raw
    if candidate.is_symlink():
        raise HarnessError("project directory check failed")
    project = ensure_within(candidate, root)
    if not project.is_dir():
        raise HarnessError("project directory check failed")
    collection = root / "paper-lecture-notes"
    if not collection.is_dir() or collection.is_symlink():
        raise HarnessError("paper-lecture-notes collection root is invalid")
    for name in ("inbox", "draft", "out", ".workspace"):
        required = project / name
        if not required.is_dir() or required.is_symlink():
            raise HarnessError(f"required project directory is invalid: {name}")
    if project == collection.resolve():
        legacy_state = any(
            child.name != ".gitignore"
            for name in ("inbox", "draft", "out", ".workspace")
            for child in (project / name).iterdir()
        )
        if not legacy_state:
            raise HarnessError("collection root is not a project; initialize a named child project")
    elif project.parent == collection.resolve():
        if not PROJECT_ID.fullmatch(project.name):
            raise HarnessError("project directory name is not a valid project ID")
        identity = project / ".workspace" / "project-id"
        if identity.is_symlink() or not identity.is_file():
            raise HarnessError("project identity file is missing or invalid")
        try:
            recorded_identity = identity.read_text(encoding="utf-8")
        except OSError as exc:
            raise HarnessError("project identity file could not be read") from exc
        if recorded_identity != project.name + "\n":
            raise HarnessError("project identity does not match its directory")
    else:
        raise HarnessError("project must be the legacy collection root or one direct child")
    return project


