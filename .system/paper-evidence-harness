def validate_registry_shape(registry: dict) -> None:
    if registry.get("schema_version") != SCHEMA_VERSION:
        raise HarnessError("unsupported registry schema version")
    for key in ("assets", "visuals", "resources", "software", "runs"):
        if not isinstance(registry.get(key), dict):
            raise HarnessError(f"registry field must be an object: {key}")
    if not isinstance(registry.get("relations"), list):
        raise HarnessError("registry relations must be an array")
    if not isinstance(registry.get("note_references"), list):
        raise HarnessError("registry note_references must be an array")
    prefix_by_section = {
        "assets": "ASSET-", "visuals": "VIS-", "resources": "RES-",
        "software": "SW-", "runs": "RUN-",
    }
    for section, prefix in prefix_by_section.items():
        for key, entry in registry[section].items():
            if not isinstance(entry, dict) or key != entry.get("id") or not ENTRY_ID.fullmatch(key) or not key.startswith(prefix):
                raise HarnessError(f"invalid {section} registry entry: {key}")
            if entry.get("state", "current") not in ENTRY_STATES:
                raise HarnessError(f"unknown entry state: {key}")
            annotation = entry.get("annotations", {})
            if not isinstance(annotation, dict):
                raise HarnessError(f"entry annotations must be an object: {key}")
            preparations = entry.get("visual_review_preparations", {})
            reviews = entry.get("visual_reviews", {})
            if not isinstance(preparations, dict) or not all(
                isinstance(preparation_id, str) and isinstance(receipt, dict)
                for preparation_id, receipt in preparations.items()
            ):
                raise HarnessError(f"visual review preparations must be an object: {key}")
            if not isinstance(reviews, dict) or not all(
                isinstance(review_id, str) and isinstance(receipt, dict)
                for review_id, receipt in reviews.items()
            ):
                raise HarnessError(f"visual reviews must be an object: {key}")
            active_preparation = entry.get("active_visual_review_preparation", "")
            if not isinstance(active_preparation, str) or (
                active_preparation and active_preparation not in preparations
            ):
                raise HarnessError(f"active visual review preparation is invalid: {key}")
            if annotation.get("disposition", "pending") not in DISPOSITIONS:
                raise HarnessError(f"unknown entry disposition: {key}")
            if annotation.get("rights_status", "pending") not in RIGHTS_STATUSES:
                raise HarnessError(f"unknown rights status: {key}")
            if annotation.get("visibility", "pending") not in VISIBILITIES:
                raise HarnessError(f"unknown reader visibility: {key}")
            if annotation.get("privacy_review_status", "pending") not in PRIVACY_REVIEW_STATUSES:
                raise HarnessError(f"unknown privacy review status: {key}")
            if section == "visuals" and annotation.get("origin", "pending") not in VISUAL_ORIGINS:
                raise HarnessError(f"unknown visual origin: {key}")
            if section == "runs" and entry.get("status") not in {"success", "failed", "non-reproducible"}:
                raise HarnessError(f"unknown run status: {key}")
            if section == "runs":
                for field in ("inputs", "outputs", "output_visuals"):
                    identifiers = entry.get(field)
                    if not isinstance(identifiers, list) or not all(isinstance(value, str) for value in identifiers):
                        raise HarnessError(f"run receipt field must be an ID array: {key}.{field}")
                    if len(identifiers) != len(set(identifiers)):
                        raise HarnessError(f"run receipt field contains duplicate IDs: {key}.{field}")
            if section == "software" and entry.get("source_type", "git") not in {"git", "artifact"}:
                raise HarnessError(f"unknown software source type: {key}")
    if not isinstance(registry.get("receipts", {}).get("builds", []), list):
        raise HarnessError("registry build receipts must be an array")


def initialize(
    project: pathlib.Path, requested_artifact_set: str | None = None,
) -> tuple[dict, dict]:
    paths = managed_paths(project)
    for key in ("config", "registry", "audit", "ingestion", "transaction"):
        reject_symlink_chain(paths[key], project)
    if paths["config"].exists():
        config = read_json(paths["config"])
    else:
        config = default_config(project, requested_artifact_set or "notes")
    if config.get("schema_version") != SCHEMA_VERSION:
        raise HarnessError("unsupported config schema version")
    if config.get("project") != project.name:
        raise HarnessError("config project identity does not match the selected project")
    configured_artifact_set = config.get("artifact_set", "notes")
    if (
        requested_artifact_set is not None
        and configured_artifact_set != requested_artifact_set
    ):
        raise HarnessError(
            "existing evidence harness uses a different artifact set"
        )
    artifacts = artifact_specs(project, config)
    if paths["registry"].exists():
        registry = read_json(paths["registry"])
    else:
        registry = default_registry(project, config)
    validate_registry_shape(registry)
    if registry.get("project") != project.name:
        raise HarnessError("registry project identity does not match the selected project")
    if paths["ingestion"].exists():
        load_ingestion_manifest(project)
    for key in (
        "generated", "figures", "assets", "outputs", "external_cache", "software_cache",
        "scan_tmp", "visual_reviews", "visual_review_tmp",
    ):
        secure_directory(paths[key], project)
    for spec in artifacts.values():
        secure_directory(project / spec["source_root"], project)
    if not paths["config"].exists():
        write_json(paths["config"], config)
    if not paths["registry"].exists():
        write_json(paths["registry"], registry)
    return config, registry


def sha256_file(path: pathlib.Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def stable_file_snapshot(path: pathlib.Path, capture_limit: int = 0) -> dict:
    """Hash a regular file through an O_NOFOLLOW descriptor and verify stability."""
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        raise HarnessError(f"file could not be opened safely: {path}") from exc
    digest = hashlib.sha256()
    head = b""
    captured: list[bytes] = []
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode):
            raise HarnessError(f"scan target is not a regular file: {path}")
        bytes_read = 0
        while bytes_read < before.st_size:
            chunk = os.read(descriptor, min(1024 * 1024, before.st_size - bytes_read))
            if not chunk:
                break
            bytes_read += len(chunk)
            if not head:
                head = chunk[:16]
            digest.update(chunk)
            if capture_limit and before.st_size <= capture_limit:
                captured.append(chunk)
        grew_during_read = bool(os.read(descriptor, 1))
        after = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    stable = (
        before.st_size == after.st_size
        and before.st_mtime_ns == after.st_mtime_ns
        and before.st_ino == after.st_ino
        and before.st_dev == after.st_dev
        and bytes_read == before.st_size
        and not grew_during_read
    )
    result = {
        "sha256": digest.hexdigest(), "size": after.st_size,
        "mtime_ns": after.st_mtime_ns, "inode": after.st_ino,
        "device": after.st_dev, "stable": stable, "head": head,
    }
    if stable and capture_limit and before.st_size <= capture_limit:
        result["data"] = b"".join(captured)
    return result


def lexical_relative_path(path: pathlib.Path, root: pathlib.Path) -> pathlib.Path:
    """Return a normalized lexical path without following any filesystem link."""
    absolute_path = pathlib.Path(os.path.abspath(os.fspath(path)))
    absolute_root = pathlib.Path(os.path.abspath(os.fspath(root)))
    try:
        relative = absolute_path.relative_to(absolute_root)
    except ValueError as exc:
        raise HarnessError("managed path escapes project lexically") from exc
    if not relative.parts or any(part in {"", ".", ".."} for part in relative.parts):
        raise HarnessError("managed path has an unsafe lexical component")
    return relative


@contextlib.contextmanager
def managed_directory_fd(project: pathlib.Path, directory: pathlib.Path):
    """Open a project directory component-by-component without following links."""
    relative = lexical_relative_path(directory, project)
    directory_flags = (
        os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_DIRECTORY", 0)
    )
    descriptor = os.open(project, directory_flags)
    try:
        for component in relative.parts:
            next_descriptor = os.open(component, directory_flags, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = next_descriptor
        info = os.fstat(descriptor)
        if not stat.S_ISDIR(info.st_mode):
            raise HarnessError("managed directory descriptor is not a directory")
        yield descriptor
    except OSError as exc:
        raise HarnessError(f"managed directory could not be opened safely: {directory}") from exc
    finally:
        with contextlib.suppress(OSError):
            os.close(descriptor)


def stable_managed_file_snapshot(
    project: pathlib.Path, path: pathlib.Path, expected_parent: pathlib.Path,
) -> dict:
    """Hash a managed file through no-follow directory and file descriptors."""
    relative = lexical_relative_path(path, project)
    parent_relative = lexical_relative_path(expected_parent, project)
    if relative.parts[:len(parent_relative.parts)] != parent_relative.parts:
        raise HarnessError("managed file is outside its expected package")
    file_flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    with managed_directory_fd(project, path.parent) as parent_fd:
        try:
            descriptor = os.open(path.name, file_flags, dir_fd=parent_fd)
        except OSError as exc:
            raise HarnessError(f"managed file could not be opened safely: {path}") from exc
        digest = hashlib.sha256()
        head = b""
        try:
            before = os.fstat(descriptor)
            if not stat.S_ISREG(before.st_mode):
                raise HarnessError(f"managed review path is not a regular file: {path}")
            bytes_read = 0
            while bytes_read < before.st_size:
                chunk = os.read(descriptor, min(1024 * 1024, before.st_size - bytes_read))
                if not chunk:
                    break
                bytes_read += len(chunk)
                if not head:
                    head = chunk[:16]
                digest.update(chunk)
            grew_during_read = bool(os.read(descriptor, 1))
            after = os.fstat(descriptor)
        finally:
            os.close(descriptor)
    stable = (
        before.st_size == after.st_size
        and before.st_mtime_ns == after.st_mtime_ns
        and before.st_ino == after.st_ino
        and before.st_dev == after.st_dev
        and bytes_read == before.st_size
        and not grew_during_read
    )
    return {
        "sha256": digest.hexdigest(), "size": after.st_size,
        "mtime_ns": after.st_mtime_ns, "inode": after.st_ino,
        "device": after.st_dev, "stable": stable, "head": head,
    }


def publish_managed_directory(
    project: pathlib.Path, working_root: pathlib.Path,
    target_root: pathlib.Path, target_name: str,
) -> None:
    """Publish one new directory using no-follow source and destination dirfds."""
    def remove_owned_tree(parent_fd: int, name: str, depth: int = 0) -> None:
        if depth > 16:
            raise HarnessError("managed publication cleanup depth exceeded")
        directory_flags = (
            os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
            | getattr(os, "O_DIRECTORY", 0)
        )
        try:
            child_fd = os.open(name, directory_flags, dir_fd=parent_fd)
        except OSError:
            os.unlink(name, dir_fd=parent_fd)
            return
        try:
            names = os.listdir(child_fd)
            if len(names) > 10000:
                raise HarnessError("managed publication cleanup entry limit exceeded")
            for child_name in names:
                info = os.stat(child_name, dir_fd=child_fd, follow_symlinks=False)
                if stat.S_ISDIR(info.st_mode) and not stat.S_ISLNK(info.st_mode):
                    remove_owned_tree(child_fd, child_name, depth + 1)
                else:
                    os.unlink(child_name, dir_fd=child_fd)
        finally:
            os.close(child_fd)
        os.rmdir(name, dir_fd=parent_fd)

    if pathlib.PurePath(target_name).name != target_name or target_name in {".", ".."}:
        raise HarnessError("managed publication name is invalid")
    with managed_directory_fd(project, working_root) as working_fd:
        if not stat.S_ISDIR(os.fstat(working_fd).st_mode):
            raise HarnessError("managed publication source is not a directory")
    with (
        managed_directory_fd(project, working_root.parent) as source_parent_fd,
        managed_directory_fd(project, target_root) as target_fd,
    ):
        try:
            os.stat(target_name, dir_fd=target_fd, follow_symlinks=False)
        except FileNotFoundError:
            pass
        else:
            raise HarnessError("visual review preparation ID collision")
        try:
            os.rename(
                working_root.name, target_name,
                src_dir_fd=source_parent_fd, dst_dir_fd=target_fd,
            )
        except OSError as exc:
            raise HarnessError("visual review package could not be published safely") from exc
        target_identity = os.fstat(target_fd)
        try:
            with managed_directory_fd(project, target_root) as current_target_fd:
                current_identity = os.fstat(current_target_fd)
                target_is_current = (
                    target_identity.st_dev == current_identity.st_dev
                    and target_identity.st_ino == current_identity.st_ino
                )
        except HarnessError:
            target_is_current = False
        if not target_is_current:
            try:
                remove_owned_tree(target_fd, target_name)
            except (HarnessError, OSError) as exc:
                raise HarnessError(
                    "visual review publication target changed and cleanup was incomplete"
                ) from exc
            raise HarnessError("visual review publication target changed during publish")


@contextlib.contextmanager
def immutable_parse_snapshot(
    project: pathlib.Path, path: pathlib.Path, expected: dict, max_bytes: int,
):
    """Copy one bounded, already-hashed revision to a private parser snapshot."""
    temp_root = secure_directory(managed_paths(project)["scan_tmp"], project)
    reject_symlink_chain(temp_root, project)
    if expected.get("size", max_bytes + 1) > max_bytes:
        raise HarnessError(f"parser snapshot exceeds configured limit ({max_bytes} bytes)")
    required_free = int(expected.get("size", 0)) + 16 * 1024 * 1024
    if shutil.disk_usage(temp_root).free < required_free:
        raise HarnessError("insufficient private temporary space for parser snapshot")
    source_flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    source_fd = os.open(path, source_flags)
    temp_fd, temp_name = tempfile.mkstemp(prefix="parse-", suffix=path.suffix, dir=temp_root)
    temp_path = pathlib.Path(temp_name)
    digest = hashlib.sha256()
    head = b""
    try:
        before = os.fstat(source_fd)
        if not stat.S_ISREG(before.st_mode):
            raise HarnessError(f"scan target is not a regular file: {path}")
        if (
            before.st_size != expected.get("size")
            or before.st_mtime_ns != expected.get("mtime_ns")
            or before.st_ino != expected.get("inode")
            or before.st_dev != expected.get("device")
        ):
            raise HarnessError(f"file changed before parser snapshot: {path}")
        expected_size = int(expected["size"])
        bytes_read = 0
        with os.fdopen(temp_fd, "wb") as target:
            while bytes_read < expected_size:
                chunk = os.read(source_fd, min(1024 * 1024, expected_size - bytes_read))
                if not chunk:
                    break
                bytes_read += len(chunk)
                if not head:
                    head = chunk[:16]
                digest.update(chunk)
                target.write(chunk)
            grew_during_read = bool(os.read(source_fd, 1))
            target.flush()
            os.fsync(target.fileno())
        after = os.fstat(source_fd)
        stable = (
            before.st_size == after.st_size
            and before.st_mtime_ns == after.st_mtime_ns
            and before.st_ino == after.st_ino
            and before.st_dev == after.st_dev
            and bytes_read == expected_size
            and not grew_during_read
        )
        copied_digest = digest.hexdigest()
        if (
            not stable
            or copied_digest != expected.get("sha256")
            or after.st_size != expected.get("size")
            or after.st_mtime_ns != expected.get("mtime_ns")
            or after.st_ino != expected.get("inode")
            or after.st_dev != expected.get("device")
        ):
            raise HarnessError(f"file changed between hashing and parser snapshot: {path}")
        yield temp_path
    finally:
        os.close(source_fd)
        with contextlib.suppress(OSError):
            os.close(temp_fd)
        temp_path.unlink(missing_ok=True)


def descriptor_snapshot(descriptor: int) -> dict:
    """Hash one already-open regular descriptor and restore its read offset."""
    digest = hashlib.sha256()
    before = os.fstat(descriptor)
    if not stat.S_ISREG(before.st_mode):
        raise HarnessError("decoder snapshot descriptor is not a regular file")
    os.lseek(descriptor, 0, os.SEEK_SET)
    bytes_read = 0
    while bytes_read < before.st_size:
        chunk = os.read(descriptor, min(1024 * 1024, before.st_size - bytes_read))
        if not chunk:
            break
        bytes_read += len(chunk)
        digest.update(chunk)
    grew_during_read = bool(os.read(descriptor, 1))
    after = os.fstat(descriptor)
    os.lseek(descriptor, 0, os.SEEK_SET)
    return {
        "sha256": digest.hexdigest(), "size": after.st_size,
        "mtime_ns": after.st_mtime_ns, "inode": after.st_ino,
        "device": after.st_dev,
        "stable": (
            before.st_size == after.st_size
            and before.st_mtime_ns == after.st_mtime_ns
            and before.st_ino == after.st_ino
            and before.st_dev == after.st_dev
            and bytes_read == before.st_size
            and not grew_during_read
        ),
    }


@contextlib.contextmanager
def immutable_decoder_snapshot(
    project: pathlib.Path, path: pathlib.Path, expected: dict, max_bytes: int,
):
    """Expose an unlink-only, read-only verified snapshot to selected child processes."""
    with immutable_parse_snapshot(project, path, expected, max_bytes) as snapshot_path:
        os.chmod(snapshot_path, 0o400)
        flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
        descriptor = os.open(snapshot_path, flags)
        before = descriptor_snapshot(descriptor)
        if (
            not before.get("stable")
            or before.get("sha256") != expected.get("sha256")
            or before.get("size") != expected.get("size")
        ):
            os.close(descriptor)
            raise HarnessError("decoder snapshot does not match the scanned source")
        snapshot_path.unlink()
        verification_error = ""
        try:
            yield pathlib.Path(f"/dev/fd/{descriptor}"), descriptor
        finally:
            try:
                after = descriptor_snapshot(descriptor)
                if (
                    not after.get("stable")
                    or after.get("sha256") != expected.get("sha256")
                    or after.get("size") != expected.get("size")
                    or after.get("inode") != before.get("inode")
                    or after.get("device") != before.get("device")
                ):
                    verification_error = "decoder snapshot changed while it was in use"
            finally:
                os.close(descriptor)
            if verification_error:
                raise HarnessError(verification_error)


def short_id(prefix: str, material: str) -> str:
    digest = hashlib.sha256(material.encode("utf-8")).hexdigest()[:16].upper()
    return f"{prefix}-{digest}"


def parser_process_limits() -> None:
    import resource
    resource.setrlimit(resource.RLIMIT_AS, (1024 * 1024 * 1024, 1024 * 1024 * 1024))
    resource.setrlimit(resource.RLIMIT_CPU, (120, 120))
    resource.setrlimit(resource.RLIMIT_FSIZE, (64 * 1024 * 1024, 64 * 1024 * 1024))
    resource.setrlimit(resource.RLIMIT_NOFILE, (128, 128))


def run_tool(
    argv: list[str], timeout: int = 60, max_output_bytes: int = 16 * 1024 * 1024,
    environment: dict[str, str] | None = None, pass_fds: tuple[int, ...] = (),
) -> tuple[int, str, str]:
    """Run an untrusted-document parser with bounded process and captured output."""
    try:
        with tempfile.TemporaryFile() as stdout_file, tempfile.TemporaryFile() as stderr_file:
            result = subprocess.run(
                argv, check=False, stdout=stdout_file, stderr=stderr_file,
                timeout=timeout, env=environment or {**os.environ, "LC_ALL": "C"},
                preexec_fn=parser_process_limits, pass_fds=pass_fds,
            )
            stdout_size = stdout_file.tell()
            stderr_size = stderr_file.tell()
            if stdout_size > max_output_bytes or stderr_size > max_output_bytes:
                return 127, "", "tool output exceeded the configured capture limit"
            stdout_file.seek(0)
            stderr_file.seek(0)
            stdout = stdout_file.read(max_output_bytes + 1).decode("utf-8", errors="replace")
            stderr = stderr_file.read(max_output_bytes + 1).decode("utf-8", errors="replace")
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 127, "", str(exc)
    return result.returncode, stdout, stderr


def renderer_process_limits() -> None:
    import resource
    resource.setrlimit(resource.RLIMIT_AS, (2 * 1024 * 1024 * 1024, 2 * 1024 * 1024 * 1024))
    resource.setrlimit(resource.RLIMIT_CPU, (300, 300))
    resource.setrlimit(resource.RLIMIT_FSIZE, (128 * 1024 * 1024, 128 * 1024 * 1024))
    resource.setrlimit(resource.RLIMIT_NOFILE, (128, 128))


def renderer_environment(temp_root: pathlib.Path) -> dict[str, str]:
    return {
        "PATH": os.environ.get("PATH", os.defpath),
        "LANG": "C", "LC_ALL": "C", "TZ": "UTC",
        "TMPDIR": str(temp_root), "MAGICK_TEMPORARY_PATH": str(temp_root),
        "MAGICK_MEMORY_LIMIT": "512MiB", "MAGICK_MAP_LIMIT": "512MiB",
        "MAGICK_DISK_LIMIT": "512MiB", "MAGICK_AREA_LIMIT": "100MP",
        "MAGICK_WIDTH_LIMIT": "32KP", "MAGICK_HEIGHT_LIMIT": "32KP",
        "MAGICK_THREAD_LIMIT": "1", "MAGICK_TIME_LIMIT": "300",
    }


def render_output_budget(root: pathlib.Path, max_files: int, max_bytes: int) -> tuple[int, int]:
    file_count = 0
    total_size = 0
    for current_root, directories, files in os.walk(root, followlinks=False):
        current = pathlib.Path(current_root)
        for name in directories:
            if (current / name).is_symlink():
                raise HarnessError("visual review renderer created a symlink")
        for name in files:
            path = current / name
            info = path.lstat()
            if not stat.S_ISREG(info.st_mode):
                raise HarnessError("visual review renderer created a special file")
            file_count += 1
            total_size += info.st_size
            if file_count > max_files:
                raise HarnessError("visual review renderer exceeded the frame limit")
            if total_size > max_bytes:
                raise HarnessError("visual review renderer exceeded the output byte limit")
    return file_count, total_size


def run_bounded_renderer(
    argv: list[str], output_root: pathlib.Path, temp_root: pathlib.Path,
    max_files: int, max_bytes: int, timeout: int = 300,
    pass_fds: tuple[int, ...] = (),
) -> subprocess.CompletedProcess:
    try:
        process = subprocess.Popen(
            argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            env=renderer_environment(temp_root), preexec_fn=renderer_process_limits,
            start_new_session=True, pass_fds=pass_fds,
        )
    except OSError as exc:
        raise HarnessError(f"visual review renderer could not start: {argv[0]}") from exc
    assert process.stdout is not None and process.stderr is not None
    stdout_fd = process.stdout.fileno()
    stderr_fd = process.stderr.fileno()
    buffers = {stdout_fd: bytearray(), stderr_fd: bytearray()}
    open_streams = {stdout_fd, stderr_fd}
    deadline = time.monotonic() + timeout
    try:
        while open_streams:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise HarnessError("visual review renderer timed out")
            ready, _, _ = select.select(list(open_streams), [], [], min(0.25, remaining))
            for descriptor in ready:
                chunk = os.read(descriptor, 65536)
                if not chunk:
                    open_streams.remove(descriptor)
                    continue
                buffers[descriptor].extend(chunk)
                if len(buffers[descriptor]) > 4 * 1024 * 1024:
                    raise HarnessError("visual review renderer diagnostic output exceeded 4 MiB")
            render_output_budget(output_root, max_files, max_bytes)
        return_code = process.wait(timeout=max(1.0, deadline - time.monotonic()))
    except (HarnessError, subprocess.TimeoutExpired):
        with contextlib.suppress(ProcessLookupError):
            os.killpg(process.pid, 9)
        process.wait()
        raise
    render_output_budget(output_root, max_files, max_bytes)
    return subprocess.CompletedProcess(
        argv, return_code,
        bytes(buffers[stdout_fd]).decode("utf-8", errors="replace"),
        bytes(buffers[stderr_fd]).decode("utf-8", errors="replace"),
    )


def sniff_type(path: pathlib.Path, head: bytes | None = None) -> str:
    if head is None:
        head = stable_file_snapshot(path)["head"]
    signatures = (
        (b"%PDF-", "application/pdf"),
        (b"PK\x03\x04", "application/zip"),
        (b"PK\x05\x06", "application/zip"),
        (b"PK\x07\x08", "application/zip"),
        (b"\x89PNG\r\n\x1a\n", "image/png"),
        (b"\xff\xd8\xff", "image/jpeg"),
        (b"GIF87a", "image/gif"),
        (b"GIF89a", "image/gif"),
        (b"BM", "image/bmp"),
        (b"II*\x00", "image/tiff"),
        (b"MM\x00*", "image/tiff"),
        (b"II+\x00\x08\x00\x00\x00", "image/tiff"),
        (b"MM\x00+\x00\x08\x00\x00", "image/tiff"),
        (b"\x1f\x8b", "application/gzip"),
        (b"BZh", "application/x-bzip2"),
        (b"\xfd7zXZ\x00", "application/x-xz"),
        (b"7z\xbc\xaf'\x1c", "application/x-7z-compressed"),
        (b"Rar!\x1a\x07", "application/vnd.rar"),
        (b"%!PS-Adobe-", "application/postscript"),
    )
    for signature, media_type in signatures:
        if head.startswith(signature):
            return media_type
    if len(head) >= 12 and head.startswith(b"RIFF") and head[8:12] == b"WEBP":
        return "image/webp"
    if len(head) >= 12 and head[4:8] == b"ftyp":
        brand = head[8:12]
        if brand in {b"avif", b"avis"}:
            return "image/avif"
        if brand in {b"heic", b"heix", b"hevc", b"hevx", b"mif1", b"msf1"}:
            return "image/heic"
    if path.suffix.lower() in MAGIC_REQUIRED_SUFFIXES:
        return "application/octet-stream"
    return mimetypes.guess_type(path.name)[0] or "application/octet-stream"


def valid_svg_document(data: bytes) -> bool:
    """Validate one bounded SVG document without fetching or expanding entities."""
    if not data:
        return False
    if re.search(rb"(?i)(?:@import|url\s*\(\s*['\"]?\s*(?!#))", data):
        return False
    root_name = ""
    parser = xml.parsers.expat.ParserCreate(namespace_separator="}")
    parser.SetParamEntityParsing(xml.parsers.expat.XML_PARAM_ENTITY_PARSING_NEVER)

    def valid_embedded_raster(value: str) -> bool:
        match = re.fullmatch(
            r"data:(image/(?:avif|bmp|gif|heic|jpeg|png|tiff|webp));base64,(.*)",
            value, re.IGNORECASE | re.DOTALL,
        )
        if not match:
            return False
        media_type = match.group(1).lower()
        encoded = re.sub(r"\s+", "", match.group(2))
        if len(encoded) > 24 * 1024 * 1024:
            return False
        try:
            decoded = base64.b64decode(encoded, validate=True)
        except (binascii.Error, ValueError):
            return False
        if not decoded or len(decoded) > 16 * 1024 * 1024:
            return False
        suffix = {
            "image/avif": ".avif", "image/bmp": ".bmp", "image/gif": ".gif",
            "image/heic": ".heic", "image/jpeg": ".jpg", "image/png": ".png",
            "image/tiff": ".tiff", "image/webp": ".webp",
        }[media_type]
        return sniff_type(pathlib.Path(f"embedded{suffix}"), decoded[:16]) == media_type

    def start_element(name: str, attributes: dict) -> None:
        nonlocal root_name
        local_name = name.rsplit("}", 1)[-1]
        if not root_name:
            root_name = local_name
        if local_name.lower() in {"script", "foreignobject"}:
            raise ValueError("active or foreign SVG content is not accepted")
        for attribute_name, raw_value in attributes.items():
            local_attribute = attribute_name.rsplit("}", 1)[-1].lower()
            value = str(raw_value).strip()
            if local_attribute.startswith("on"):
                raise ValueError("SVG event handlers are not accepted")
            if local_attribute == "href":
                if value.startswith("#"):
                    continue
                if not valid_embedded_raster(value):
                    raise ValueError("external or nested SVG references are not accepted")

    def reject_entity(*arguments: object) -> None:
        raise ValueError("SVG entity declarations are not accepted")

    parser.StartElementHandler = start_element
    parser.EntityDeclHandler = reject_entity
    parser.StartDoctypeDeclHandler = lambda *arguments: reject_entity()
    parser.ProcessingInstructionHandler = lambda *arguments: reject_entity()
    parser.ExternalEntityRefHandler = lambda *arguments: 1
    try:
        parser.Parse(data, True)
    except (ValueError, xml.parsers.expat.ExpatError):
        return False
    return root_name == "svg"


def classify(path: pathlib.Path, role: str, media_type: str) -> str:
    suffix = path.suffix.lower()
    if role == "note-visual":
        return "note-visual"
    if role == "software-output":
        return "software-output"
    if role == "note-asset":
        return "note-asset"
    if media_type.startswith("image/"):
        return "source-visual"
    if media_type == "application/pdf":
        return "source-document"
    if suffix in DATA_SUFFIXES:
        return "source-data"
    if suffix in ARCHIVE_SUFFIXES or media_type in {"application/zip", "application/gzip"}:
        return "source-archive"
    if suffix in CODE_SUFFIXES:
        return "source-code"
    return "source-supplement"


def default_annotation(kind: str) -> dict:
    annotation = {
        "disposition": "pending",
        "visibility": "pending",
        "privacy_review_status": "pending",
        "public_summary": "",
        "title": "",
        "description": "",
        "rights_status": "pending",
        "license": "",
        "exclusion_reason": "",
    }
    if kind in {"source-document", "source-supplement", "source-archive"}:
        annotation.update({
            "visual_review_status": "pending",
            "link_review_status": "pending",
            "attachment_review_status": "pending",
            "archive_review_status": "pending" if kind == "source-archive" else "not-applicable",
        })
    if kind in {"note-visual", "software-output", "source-visual"}:
        annotation.update({"origin": "pending", "alt_text": "", "creator": ""})
    return annotation


def merge_annotation(old: dict | None, kind: str) -> dict:
    result = default_annotation(kind)
    if isinstance(old, dict):
        result.update(old)
    return result


def safe_archive_member(name: str) -> bool:
    pure = pathlib.PurePosixPath(name.replace("\\", "/"))
    return bool(name) and not pure.is_absolute() and ".." not in pure.parts


def inspect_archive_worker(path: pathlib.Path) -> dict:
    result = {
        "status": "unsupported",
        "members": [],
        "unsafe_entries": [],
        "encrypted_entries": [],
        "total_uncompressed_bytes": 0,
        "nested_archives": 0,
        "limit_exceeded": "",
    }
    if path.stat().st_size > 1024 * 1024 * 1024:
        result["status"] = "blocked"
        result["limit_exceeded"] = "compressed input exceeds 1 GiB"
        return result
    try:
        if zipfile.is_zipfile(path):
            result["status"] = "inspected"
            with zipfile.ZipFile(path) as archive:
                for member_index, info in enumerate(archive.infolist(), 1):
                    if member_index > 10000:
                        result["status"] = "blocked"
                        result["limit_exceeded"] = "archive exceeds 10000 members"
                        break
                    unix_mode = info.external_attr >> 16
                    file_type = stat.S_IFMT(unix_mode) if unix_mode else 0
                    member = {
                        "path": info.filename,
                        "size": info.file_size,
                        "compressed_size": info.compress_size,
                        "unix_mode": oct(unix_mode) if unix_mode else "",
                    }
                    result["members"].append(member)
                    result["total_uncompressed_bytes"] += info.file_size
                    if result["total_uncompressed_bytes"] > 5 * 1024 * 1024 * 1024:
                        result["status"] = "blocked"
                        result["limit_exceeded"] = "declared expansion exceeds 5 GiB"
                        break
                    if not safe_archive_member(info.filename):
                        result["unsafe_entries"].append(info.filename)
                    if file_type and file_type not in {stat.S_IFREG, stat.S_IFDIR}:
                        result["unsafe_entries"].append(info.filename)
                    if info.flag_bits & 0x1:
                        result["encrypted_entries"].append(info.filename)
                    if pathlib.PurePosixPath(info.filename).suffix.lower() in ARCHIVE_SUFFIXES:
                        result["nested_archives"] += 1
                suffix = path.suffix.lower()
                container_format = ZIP_CONTAINER_FORMATS.get(suffix)
                if container_format and result["status"] == "inspected":
                    names = {info.filename for info in archive.infolist()}
                    signature_valid = False
                    if suffix in {".xlsx", ".xlsm"}:
                        signature_valid = "[Content_Types].xml" in names and "xl/workbook.xml" in names
                    elif suffix == ".docx":
                        signature_valid = "[Content_Types].xml" in names and "word/document.xml" in names
                    elif suffix == ".pptx":
                        signature_valid = "[Content_Types].xml" in names and "ppt/presentation.xml" in names
                    elif suffix in {".ods", ".odt", ".odp"}:
                        signature_valid = "mimetype" in names and "META-INF/manifest.xml" in names
                    elif suffix == ".npz":
                        npy_names = [name for name in names if name.lower().endswith(".npy")]
                        if npy_names:
                            try:
                                with archive.open(sorted(npy_names)[0]) as member:
                                    signature_valid = member.read(6) == b"\x93NUMPY"
                            except (KeyError, OSError, RuntimeError, zipfile.BadZipFile):
                                signature_valid = False
                    result["container_format"] = container_format
                    result["container_signature_valid"] = signature_valid
                    result["container_internals"] = True
            return result
        try:
            archive = tarfile.open(path, "r|*")
        except tarfile.TarError:
            archive = None
        if archive is not None:
            result["status"] = "inspected"
            with archive:
                for member_index, info in enumerate(archive, 1):
                    if member_index > 10000:
                        result["status"] = "blocked"
                        result["limit_exceeded"] = "archive exceeds 10000 members"
                        break
                    member = {"path": info.name, "size": info.size, "type": info.type.decode("latin1")}
                    result["members"].append(member)
                    result["total_uncompressed_bytes"] += max(info.size, 0)
                    if result["total_uncompressed_bytes"] > 5 * 1024 * 1024 * 1024:
                        result["status"] = "blocked"
                        result["limit_exceeded"] = "declared expansion exceeds 5 GiB"
                        break
                    if not safe_archive_member(info.name) or info.issym() or info.islnk() or info.isdev():
                        result["unsafe_entries"].append(info.name)
                    if pathlib.PurePosixPath(info.name).suffix.lower() in ARCHIVE_SUFFIXES:
                        result["nested_archives"] += 1
            return result
    except (OSError, zipfile.BadZipFile, tarfile.TarError) as exc:
        result["status"] = "error"
        result["error"] = str(exc)
    return result


def archive_worker_limits() -> None:
    import resource
    resource.setrlimit(resource.RLIMIT_AS, (512 * 1024 * 1024, 512 * 1024 * 1024))
    resource.setrlimit(resource.RLIMIT_CPU, (15, 15))
    resource.setrlimit(resource.RLIMIT_FSIZE, (16 * 1024 * 1024, 16 * 1024 * 1024))
    resource.setrlimit(resource.RLIMIT_NOFILE, (64, 64))


def inspect_archive(path: pathlib.Path) -> dict:
    try:
        with tempfile.TemporaryFile() as stdout_file, tempfile.TemporaryFile() as stderr_file:
            completed = subprocess.run(
                [sys.executable, str(pathlib.Path(__file__).resolve()), "--archive-worker", str(path)],
                check=False, stdout=stdout_file, stderr=stderr_file, timeout=20,
                env={"PATH": os.environ.get("PATH", os.defpath), "LANG": "C", "LC_ALL": "C"},
                preexec_fn=archive_worker_limits,
            )
            if stdout_file.tell() > 16 * 1024 * 1024 or stderr_file.tell() > 16 * 1024 * 1024:
                raise HarnessError("isolated archive inspector output exceeded 16 MiB")
            stdout_file.seek(0)
            stdout = stdout_file.read(16 * 1024 * 1024 + 1).decode("utf-8", errors="replace")
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {
            "status": "blocked", "members": [], "unsafe_entries": [],
            "encrypted_entries": [], "total_uncompressed_bytes": 0,
            "nested_archives": 0, "limit_exceeded": f"isolated inspection failed: {type(exc).__name__}",
        }
    except HarnessError as exc:
        return {
            "status": "blocked", "members": [], "unsafe_entries": [],
            "encrypted_entries": [], "total_uncompressed_bytes": 0,
            "nested_archives": 0, "limit_exceeded": str(exc),
        }
    if completed.returncode != 0:
        return {
            "status": "blocked", "members": [], "unsafe_entries": [],
            "encrypted_entries": [], "total_uncompressed_bytes": 0,
            "nested_archives": 0, "limit_exceeded": "isolated inspector exited unsuccessfully",
        }
    try:
        result = json.loads(stdout)
    except json.JSONDecodeError:
        result = {"status": "blocked", "limit_exceeded": "isolated inspector returned invalid data"}
    return result


def is_single_stream_compression(path: pathlib.Path) -> bool:
    """Return true only for compression wrappers, not compressed tar archives."""
    suffix = path.suffix.lower()
    return suffix in {".gz", ".bz2", ".xz"} and pathlib.Path(path.stem).suffix.lower() != ".tar"


def inspect_single_stream_compression(path: pathlib.Path, snapshot: dict) -> dict:
    """Index a compression stream without decompressing attacker-controlled bytes."""
    member_name = pathlib.Path(path.stem).name or "compressed-stream"
    suffix = path.suffix.lower()
    head = snapshot.get("head", b"")
    valid_header = {
        ".gz": len(head) >= 4 and head[:3] == b"\x1f\x8b\x08" and not (head[3] & 0xE0),
        ".bz2": len(head) >= 4 and head[:3] == b"BZh" and head[3:4] in b"123456789",
        ".xz": head.startswith(b"\xfd7zXZ\x00"),
    }.get(suffix, False)
    if not valid_header:
        return {
            "status": "error", "inspection_mode": "single-stream-header-only",
            "members": [], "unsafe_entries": [], "encrypted_entries": [],
            "total_uncompressed_bytes": 0, "nested_archives": 0,
            "limit_exceeded": "", "error": f"invalid {suffix} compression header",
        }
    return {
        "status": "inspected",
        "inspection_mode": "single-stream-header-only",
        "members": [{
            "path": member_name, "size": None,
            "compressed_size": snapshot.get("size", 0),
            "type": "single compressed stream; uncompressed size not trusted or read",
        }],
        "unsafe_entries": [], "encrypted_entries": [],
        "total_uncompressed_bytes": 0, "nested_archives": 0,
        "limit_exceeded": "",
        "capability_limit": "payload was not decompressed; adoption requires a separately hashed inbox asset",
    }


def pdf_metadata(path: pathlib.Path) -> dict:
    data = {
        "pdfinfo_status": "unavailable",
        "pages": None,
        "caption_candidates": [],
        "embedded_rasters": [],
        "annotation_urls": [],
        "attachments": [],
        "capability_limits": [
            "caption detection does not prove visual completeness",
            "vector-only and captionless visuals require page-by-page attestation",
        ],
    }
    if shutil.which("pdfinfo"):
        status, stdout, _ = run_tool(["pdfinfo", str(path)])
        data["pdfinfo_status"] = "ok" if status == 0 else "failed"
        if status == 0:
            match = re.search(r"^Pages:\s+(\d+)\s*$", stdout, re.MULTILINE)
            if match:
                data["pages"] = int(match.group(1))
            encrypted = re.search(r"^Encrypted:\s+(.+)$", stdout, re.MULTILINE)
            data["encrypted"] = encrypted.group(1).strip() if encrypted else "unknown"
    if shutil.which("pdftotext"):
        status, stdout, _ = run_tool(["pdftotext", "-layout", str(path), "-"], timeout=120)
        data["text_extraction_status"] = "ok" if status == 0 else "failed"
        if status == 0:
            pages = stdout.split("\f")
            for page_number, page_text in enumerate(pages, 1):
                for line_number, line in enumerate(page_text.splitlines(), 1):
                    match = CAPTION_RE.match(line)
                    if match:
                        data["caption_candidates"].append({
                            "page": page_number,
                            "line": line_number,
                            "label": f"{match.group(1)} {match.group(2)}",
                            "caption": match.group(3).strip()[:1000],
                        })
            data["text_urls"] = sorted(extract_urls(stdout))
    if shutil.which("pdfimages"):
        status, stdout, _ = run_tool(["pdfimages", "-list", str(path)], timeout=120)
        data["pdfimages_status"] = "ok" if status == 0 else "failed"
        if status == 0:
            for line in stdout.splitlines():
                fields = line.split()
                if len(fields) >= 13 and fields[0].isdigit() and fields[1].isdigit():
                    data["embedded_rasters"].append({
                        "page": int(fields[0]), "number": int(fields[1]),
                        "type": fields[2], "width": fields[3], "height": fields[4],
                        "object": fields[10] if len(fields) > 10 else "",
                    })
    if shutil.which("mutool"):
        status, pages_out, _ = run_tool(["mutool", "show", str(path), "pages"], timeout=60)
        refs = re.findall(r"page\s+\d+\s*=\s*(\d+)\s+\d+\s+R", pages_out) if status == 0 else []
        if refs:
            args = ["mutool", "show", str(path)] + [f"{ref}/Annots" for ref in refs]
            ann_status, ann_out, _ = run_tool(args, timeout=120)
            data["annotation_scan_status"] = "ok" if ann_status == 0 else "failed"
            if ann_status == 0:
                data["annotation_urls"] = sorted(extract_urls(ann_out))
    if shutil.which("pdfdetach"):
        status, stdout, _ = run_tool(["pdfdetach", "-list", str(path)], timeout=60)
        data["attachment_scan_status"] = "ok" if status == 0 else "failed"
        if status == 0:
            for line in stdout.splitlines():
                match = re.match(r"\s*(\d+):\s+(.+)$", line)
                if match:
                    data["attachments"].append({
                        "number": int(match.group(1)), "name": match.group(2).strip(),
                    })
    return data


def quote_url_path_preserving_escapes(path: str) -> str:
    """Quote a URL path while preserving the identity of encoded reserved bytes."""
    result: list[str] = []
    cursor = 0
    for match in re.finditer(r"%([0-9A-Fa-f]{2})", path):
        result.append(urllib.parse.quote(path[cursor:match.start()], safe="/:@!$&'()*+,;=-._~"))
        result.append("%" + match.group(1).upper())
        cursor = match.end()
    result.append(urllib.parse.quote(path[cursor:], safe="/:@!$&'()*+,;=-._~"))
    return "".join(result)


def redact_and_canonicalize_url(raw: str) -> tuple[str, bool]:
    raw = raw.rstrip(".,;:!?)]}、。，；：）】」』")
    parsed = urllib.parse.urlsplit(raw)
    scheme = parsed.scheme.lower()
    host = (parsed.hostname or "").lower()
    if scheme not in {"http", "https"} or not host:
        return "", False
    try:
        parsed_port = parsed.port
    except ValueError:
        return "", False
    port = f":{parsed_port}" if parsed_port and parsed_port not in {80, 443} else ""
    host_for_url = f"[{host}]" if ":" in host and not host.startswith("[") else host
    netloc = host_for_url + port
    query = urllib.parse.parse_qsl(parsed.query, keep_blank_values=True)
    secret = bool(parsed.username or parsed.password) or any(name.lower() in SECRET_QUERY_NAMES for name, _ in query)
    safe_query = [(name, "[REDACTED]" if name.lower() in SECRET_QUERY_NAMES else value) for name, value in query]
    if parsed.username or parsed.password:
        safe_query.insert(0, ("authorization", "[REDACTED]"))
    safe_path = quote_url_path_preserving_escapes(parsed.path or "/")
    canonical = urllib.parse.urlunsplit((scheme, netloc, safe_path, urllib.parse.urlencode(safe_query), ""))
    return canonical, secret


def extract_urls(text: str) -> set[str]:
    urls: set[str] = set()
    for match in URL_RE.finditer(text):
        canonical, _ = redact_and_canonicalize_url(match.group(0))
        if canonical:
            urls.add(canonical)
    for match in DOI_RE.finditer(text):
        doi = match.group(0).rstrip(".,;:!?)]}、。，；：）】」』")
        urls.add(f"https://doi.org/{doi}")
    return urls


def url_for_receipt(url: str) -> str:
    canonical, _ = redact_and_canonicalize_url(url)
    parsed = urllib.parse.urlsplit(canonical)
    query = urllib.parse.parse_qsl(parsed.query, keep_blank_values=True)
    redacted_query = urllib.parse.urlencode([(name, "[REDACTED]") for name, _ in query])
    return urllib.parse.urlunsplit((parsed.scheme, parsed.netloc, parsed.path, redacted_query, ""))


def read_text_limited(path: pathlib.Path, limit: int = 20 * 1024 * 1024) -> str:
    if path.stat().st_size > limit:
        return ""
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def scan_file(
    project: pathlib.Path, path: pathlib.Path, role: str, old_assets: dict,
    scan_token: str = "", max_parse_bytes: int = 536870912,
) -> dict:
    relative = path.relative_to(project).as_posix()
    if path.is_symlink():
        material = f"symlink:{role}:{relative}:{os.readlink(path)}"
        asset_id = short_id("ASSET", material)
        return {
            "id": asset_id, "state": "current", "role": role, "kind": "unsafe-symlink",
            "locations": [relative], "symlink_target": os.readlink(path),
            "security_status": "blocked", "annotations": merge_annotation(
                old_assets.get(asset_id, {}).get("annotations"), "unsafe-symlink"
            ),
        }
    snapshot = stable_file_snapshot(path, capture_limit=20 * 1024 * 1024)
    digest = snapshot["sha256"]
    stable = snapshot["stable"]
    asset_id = short_id("ASSET", f"{role}:{digest}")
    media_type = sniff_type(path, snapshot["head"])
    guessed_value, guessed_encoding = mimetypes.guess_type(path.name)
    guessed = guessed_value or "application/octet-stream"
    if path.suffix.lower() == ".svg":
        svg_valid = valid_svg_document(snapshot.get("data", b""))
        media_type = "image/svg+xml" if svg_valid else "application/octet-stream"
    kind = classify(path, role, media_type)
    entry = {
        "id": asset_id,
        "state": "current" if stable else "pending-write",
        "role": role,
        "kind": kind,
        "locations": [relative],
        "size": snapshot["size"],
        "mtime_ns": snapshot["mtime_ns"],
        "sha256": digest,
        "metadata_source_sha256": digest,
        "metadata_status": "not-required",
        "media_type": media_type,
        "extension_media_type": guessed,
        "extension_encoding": guessed_encoding or "",
        "media_type_mismatch": (
            (path.suffix.lower() in MAGIC_REQUIRED_SUFFIXES and media_type == "application/octet-stream")
            or (
                media_type != guessed
                and media_type != "application/octet-stream"
                and not (
                    guessed_encoding in {"gzip", "bzip2", "xz"}
                    and media_type in {"application/gzip", "application/x-bzip2", "application/x-xz"}
                )
            )
        ),
        "security_status": "pending" if stable else "blocked",
        "annotations": merge_annotation(old_assets.get(asset_id, {}).get("annotations"), kind),
    }
    old_asset = old_assets.get(asset_id, {})
    for field in (
        "visual_review_preparations", "visual_reviews", "active_visual_review_preparation",
    ):
        if field in old_asset:
            entry[field] = json.loads(json.dumps(old_asset[field]))
    if path.suffix.lower() == ".svg":
        entry["metadata_status"] = "parsed-bounded-memory" if svg_valid else "blocked"
    observations = list(old_assets.get(asset_id, {}).get("stable_observations", []))
    if stable and scan_token and not any(item.get("scan_token") == scan_token for item in observations):
        observations.append({
            "scan_token": scan_token, "observed_at": now_utc(),
            "observed_ns": time.time_ns(),
            "size": snapshot["size"], "mtime_ns": snapshot["mtime_ns"],
            "sha256": digest, "before_after_stat_match": True,
        })
    entry["stable_observations"] = observations[-20:]
    if path.suffix.lower() in TEXT_SUFFIXES and snapshot.get("data"):
        entry["text_urls"] = sorted(extract_urls(snapshot["data"].decode("utf-8", errors="replace")))
    if kind == "source-archive" and is_single_stream_compression(path):
        entry["archive"] = inspect_single_stream_compression(path, snapshot)
        entry["metadata_status"] = "bounded-header-only"
    elif kind == "source-archive" or path.suffix.lower() in ZIP_CONTAINER_FORMATS or media_type == "application/pdf":
        try:
            with immutable_parse_snapshot(project, path, snapshot, max_parse_bytes) as parse_path:
                if kind == "source-archive" or path.suffix.lower() in ZIP_CONTAINER_FORMATS:
                    entry["archive"] = inspect_archive(parse_path)
                    if path.suffix.lower() in ZIP_CONTAINER_FORMATS:
                        entry["media_type_mismatch"] = not bool(entry["archive"].get("container_signature_valid"))
                        entry["annotations"].setdefault("archive_review_status", "pending")
                if media_type == "application/pdf":
                    entry["pdf"] = pdf_metadata(parse_path)
            entry["metadata_status"] = "parsed-bounded-snapshot"
        except HarnessError as exc:
            if "file changed" in str(exc):
                raise
            entry["metadata_status"] = "blocked"
            entry["metadata_error"] = str(exc)
            if kind == "source-archive" or path.suffix.lower() in ZIP_CONTAINER_FORMATS:
                entry["archive"] = {
                    "status": "blocked", "members": [], "unsafe_entries": [],
                    "encrypted_entries": [], "total_uncompressed_bytes": 0,
                    "nested_archives": 0, "limit_exceeded": str(exc),
                }
            if media_type == "application/pdf":
                entry["pdf"] = {"inspection_status": "blocked", "error": str(exc)}
    return entry


def iter_scan_files(project: pathlib.Path, config: dict):
    seen: set[pathlib.Path] = set()
    for root_spec in config.get("scan_roots", []):
        relative = root_spec.get("path")
        role = root_spec.get("role")
        if not isinstance(relative, str) or not isinstance(role, str):
            raise HarnessError("invalid scan root configuration")
        root = ensure_within(project / relative, project)
        if not root.exists():
            continue
        if not root.is_dir() or root.is_symlink():
            raise HarnessError(f"scan root is invalid: {relative}")
        for path in sorted(root.rglob("*")):
            if path.is_dir() and not path.is_symlink():
                continue
            if path.name == ".gitignore":
                continue
            lexical = pathlib.Path(os.path.abspath(path))
            if lexical in seen:
                continue
            seen.add(lexical)
            yield path, role
    source_root = ensure_within(project / config["note_source"], project)
    generated_root = managed_paths(project)["generated"]
    for path in sorted(source_root.rglob("*")):
        if path.is_dir() and not path.is_symlink():
            continue
        if generated_root in path.parents or path.suffix.lower() in TEXT_SUFFIXES:
            continue
        lexical = pathlib.Path(os.path.abspath(path))
        if lexical not in seen:
            seen.add(lexical)
            yield path, "note-asset"


def merge_duplicate_asset(existing: dict, new: dict) -> None:
    existing["locations"] = sorted(set(existing.get("locations", []) + new.get("locations", [])))
    if existing.get("state") != "pending-write":
        existing["state"] = new.get("state", "current")


def resource_kind(url: str) -> str:
    parsed = urllib.parse.urlsplit(url)
    host = (parsed.hostname or "").lower()
    path = parsed.path.lower()
    if host == "doi.org":
        return "persistent-identifier"
    if host in {"github.com", "www.github.com"}:
        return "repository-link"
    if any(path.endswith(suffix) for suffix in (".zip", ".tar", ".tgz", ".gz", ".csv", ".xlsx", ".pdf")):
        return "downloadable-file"
    return "web-resource"


def github_repository(url: str) -> tuple[str, str, str, bool] | None:
    parsed = urllib.parse.urlsplit(url)
    if (parsed.hostname or "").lower() not in {"github.com", "www.github.com"}:
        return None
    parts = [part for part in parsed.path.split("/") if part]
    if len(parts) < 2:
        return None
    owner, repository = parts[0], parts[1].removesuffix(".git")
    if not re.fullmatch(r"[A-Za-z0-9_.-]+", owner) or not re.fullmatch(r"[A-Za-z0-9_.-]+", repository):
        return None
    revision = ""
    revision_requires_review = False
    if len(parts) >= 4 and parts[2] == "commit":
        if re.fullmatch(r"(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})", parts[3]):
            revision = parts[3].lower()
        else:
            revision_requires_review = True
    elif len(parts) >= 5 and parts[2:4] == ["releases", "tag"]:
        revision = "/".join(parts[4:])
    elif len(parts) >= 4 and parts[2] == "tree":
        # GitHub's tree URL does not delimit a branch containing slashes from a
        # subdirectory. Only a full object ID is safe to infer automatically.
        if re.fullmatch(r"(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})", parts[3]):
            revision = parts[3].lower()
        else:
            revision_requires_review = True
    return owner, repository, revision, revision_requires_review


def source_artifact_id(
    project: pathlib.Path, config: dict, path: pathlib.Path,
) -> str:
    for artifact_id, spec in artifact_specs(project, config).items():
        source_root = ensure_within(project / spec["source_root"], project)
        if path == source_root or source_root in path.parents:
            return artifact_id
    return ""


def note_source_texts(
    project: pathlib.Path, config: dict, artifact_id: str | None = None,
):
    artifacts = artifact_specs(project, config)
    if artifact_id is not None:
        if artifact_id not in artifacts:
            raise HarnessError(f"unknown artifact: {artifact_id}")
        source_root = ensure_within(
            project / artifacts[artifact_id]["source_root"], project,
        )
    else:
        source_root = ensure_within(project / config["note_source"], project)
    generated_root = managed_paths(project)["generated"]
    for path in sorted(source_root.rglob("*")):
        if not path.is_file() or path.is_symlink() or generated_root in path.parents:
            continue
        if path.suffix.lower() in TEXT_SUFFIXES:
            snapshot = stable_file_snapshot(path, capture_limit=20 * 1024 * 1024)
            content = snapshot.get("data", b"").decode("utf-8", errors="replace")
            owning_artifact = artifact_id or source_artifact_id(project, config, path)
            yield path, content, snapshot, owning_artifact


def strip_tex_comments(content: str) -> str:
    clean_lines: list[str] = []
    for line in content.splitlines():
        index = 0
        while True:
            percent = line.find("%", index)
            if percent < 0:
                break
            backslashes = 0
            cursor = percent - 1
            while cursor >= 0 and line[cursor] == "\\":
                backslashes += 1
                cursor -= 1
            if backslashes % 2 == 0:
                line = line[:percent]
                break
            index = percent + 1
        clean_lines.append(line)
    without_comments = "\n".join(clean_lines)
    literal_environment = re.compile(
        r"\\begin\{(verbatim\*?|Verbatim|lstlisting|minted)\}.*?"
        r"\\end\{\1\}",
        re.DOTALL,
    )
    return literal_environment.sub("", without_comments)


def collect_note_references(
    project: pathlib.Path, config: dict, artifact_id: str | None = None,
) -> tuple[list[dict], set[str], set[str], list[dict]]:
    references: list[dict] = []
    all_text: list[str] = []
    tex_text: list[str] = []
    source_files: list[dict] = []
    for path, content, snapshot, owning_artifact in note_source_texts(
        project, config, artifact_id,
    ):
        relative = path.relative_to(project).as_posix()
        if not snapshot["stable"]:
            raise HarnessError(f"canonical source changed while hashing: {relative}")
        source_files.append({
            "path": relative, "size": snapshot["size"],
            "mtime_ns": snapshot["mtime_ns"], "sha256": snapshot["sha256"],
            "artifact": owning_artifact,
        })
        suffix = path.suffix.lower()
        if suffix == ".tex":
            content = strip_tex_comments(content)
        all_text.append(content)
        if suffix == ".tex":
            tex_text.append(content)
        if suffix not in NOTE_MARKUP_SUFFIXES:
            continue
        for line_number, line in enumerate(content.splitlines(), 1):
            for match in NOTE_REF_RE.finditer(line):
                reference = {
                    "kind": match.group(1).lower(), "id": match.group(2),
                    "path": relative, "line": line_number,
                }
                if owning_artifact:
                    reference["artifact"] = owning_artifact
                references.append(reference)
            for match in ORIGINAL_CAPTION_RE.finditer(line):
                original_caption = {
                    "kind": "original-caption", "id": match.group(1),
                    "path": relative, "line": line_number,
                }
                visual_reference = {
                    "kind": "visual", "id": match.group(1),
                    "path": relative, "line": line_number,
                }
                if owning_artifact:
                    original_caption["artifact"] = owning_artifact
                    visual_reference["artifact"] = owning_artifact
                references.append(original_caption)
                references.append(visual_reference)
            if suffix == ".tex":
                for match in VISUAL_PLACEMENT_RE.finditer(line):
                    reference = {
                        "kind": "visual-placement", "id": match.group(1),
                        "backing_id": match.group(2),
                        "path": relative, "line": line_number,
                    }
                    if owning_artifact:
                        reference["artifact"] = owning_artifact
                    references.append(reference)
                for match in CODE_PLACEMENT_RE.finditer(line):
                    reference = {
                        "kind": "code-placement", "id": match.group(1),
                        "path": relative, "line": line_number,
                    }
                    if owning_artifact:
                        reference["artifact"] = owning_artifact
                    references.append(reference)
    joined = "\n".join(all_text)
    input_pattern = re.compile(r"\\(?:input|include)\s*\{([^}]*)\}")
    inputs = [
        match.group(1).strip()
        for match in input_pattern.finditer("\n".join(tex_text))
    ]
    integrations = {
        "index" if any(pathlib.PurePosixPath(value).name == "evidence-index.tex" for value in inputs) else "",
        "macros" if any(pathlib.PurePosixPath(value).name == "evidence-macros.tex" for value in inputs) else "",
    } - {""}
    return references, extract_urls(joined), integrations, source_files


def discover(project: pathlib.Path, config: dict, previous: dict) -> dict:
    registry = json.loads(json.dumps(previous))
    old_assets = previous.get("assets", {})
    assets: dict[str, dict] = {}
    discovered_urls: dict[str, set[str]] = {}
    scan_token = f"scan-{time.time_ns()}"
    max_parse_bytes = int(config.get("parsing", {}).get("max_snapshot_bytes", 536870912))
    if max_parse_bytes < 1024 * 1024:
        raise HarnessError("configured parser snapshot limit must be at least 1 MiB")
    for path, role in iter_scan_files(project, config):
        entry = scan_file(project, path, role, old_assets, scan_token, max_parse_bytes)
        if entry["id"] in assets:
            merge_duplicate_asset(assets[entry["id"]], entry)
        else:
            assets[entry["id"]] = entry
        if not path.is_symlink() and path.suffix.lower() in TEXT_SUFFIXES:
            for url in entry.get("text_urls", []):
                discovered_urls.setdefault(url, set()).add(path.relative_to(project).as_posix())
        if entry.get("pdf"):
            for url in entry["pdf"].get("text_urls", []) + entry["pdf"].get("annotation_urls", []):
                discovered_urls.setdefault(url, set()).add(entry["id"])
    for asset_id, old in old_assets.items():
        if asset_id not in assets:
            if old.get("locations") and all(pathlib.PurePosixPath(location).name == ".gitignore" for location in old["locations"]):
                continue
            missing = json.loads(json.dumps(old))
            missing["state"] = "missing"
            assets[asset_id] = missing
    registry["assets"] = assets

    visuals: dict[str, dict] = {}
    old_visuals = previous.get("visuals", {})
    for asset in assets.values():
        if asset.get("state") != "current":
            continue
        annotations = asset.get("annotations", {})
        if asset.get("kind") in {"source-visual", "note-visual", "software-output"}:
            visual_id = short_id("VIS", asset["id"])
            old = old_visuals.get(visual_id, {})
            visuals[visual_id] = {
                "id": visual_id, "state": "current", "source_asset": asset["id"],
                "visual_type": "figure", "locator": {"path": asset["locations"][0]},
                "candidate_basis": "standalone visual file",
                "annotations": merge_annotation(old.get("annotations"), asset["kind"]),
            }
            if annotations.get("origin") != "pending" and visuals[visual_id]["annotations"].get("origin") == "pending":
                visuals[visual_id]["annotations"]["origin"] = annotations["origin"]
        pdf = asset.get("pdf", {})
        for candidate in pdf.get("caption_candidates", []):
            material = f"{asset['id']}:{candidate['page']}:{candidate['label']}:{candidate['caption']}"
            visual_id = short_id("VIS", material)
            old = old_visuals.get(visual_id, {})
            label = candidate["label"].lower()
            visual_type = "table" if "table" in label or "表" in label else "figure"
            visuals[visual_id] = {
                "id": visual_id, "state": "current", "source_asset": asset["id"],
                "visual_type": visual_type,
                "locator": {"page": candidate["page"], "label": candidate["label"]},
                "caption_candidate": candidate["caption"],
                "candidate_basis": "PDF caption heuristic; manual confirmation required",
                "annotations": merge_annotation(old.get("annotations"), "source-visual"),
            }
        for raster in pdf.get("embedded_rasters", []):
            material = f"{asset['id']}:raster:{raster['page']}:{raster['number']}:{raster['object']}"
            visual_id = short_id("VIS", material)
            old = old_visuals.get(visual_id, {})
            visuals[visual_id] = {
                "id": visual_id, "state": "current", "source_asset": asset["id"],
                "visual_type": "embedded-raster-candidate",
                "locator": raster,
                "candidate_basis": "pdfimages object; may be a mask or part of a composite",
                "annotations": merge_annotation(old.get("annotations"), "source-visual"),
            }
    for visual_id, old in old_visuals.items():
        if visual_id not in visuals:
            manual = old.get("candidate_basis") == "manual"
            retained = json.loads(json.dumps(old))
            retained["state"] = "current" if manual else "missing"
            visuals[visual_id] = retained
    for visual_id, visual in visuals.items():
        old = old_visuals.get(visual_id, {})
        for field in (
            "visual_review_preparations", "visual_reviews", "active_visual_review_preparation",
        ):
            if field in old:
                visual[field] = json.loads(json.dumps(old[field]))
    registry["visuals"] = visuals

    note_refs, note_urls, integrations, source_files = collect_note_references(project, config)
    artifact_scans: dict[str, dict] = {}
    for artifact_id, spec in artifact_specs(project, config).items():
        _, _, artifact_integrations, artifact_source_files = collect_note_references(
            project, config, artifact_id,
        )
        artifact_scans[artifact_id] = {
            "kind": spec["kind"],
            "integrations": sorted(artifact_integrations),
            "source_files": artifact_source_files,
            "source_fingerprint": manifest_fingerprint(artifact_source_files),
        }
    for url in note_urls:
        discovered_urls.setdefault(url, set()).add("canonical-note-source")
    resources: dict[str, dict] = {}
    old_resources = previous.get("resources", {})
    for url, found_in in sorted(discovered_urls.items()):
        canonical, secret = redact_and_canonicalize_url(url)
        if not canonical:
            continue
        resource_id = short_id("RES", canonical)
        old = old_resources.get(resource_id, {})
        resources[resource_id] = {
            "id": resource_id, "state": "current", "canonical_url": canonical,
            "secret_query_redacted": secret, "kind": resource_kind(canonical),
            "discovered_in": sorted(found_in),
            "annotations": merge_annotation(old.get("annotations"), "external-resource"),
            "verification": old.get("verification", {}),
            "retrieval": old.get("retrieval", {}),
        }
    for resource_id, old in old_resources.items():
        if resource_id not in resources:
            missing = json.loads(json.dumps(old))
            missing["state"] = "current" if old.get("manual") else "missing"
            resources[resource_id] = missing
    registry["resources"] = resources

    software: dict[str, dict] = {}
    for software_id, old in previous.get("software", {}).items():
        inferred_manual = bool(
            old.get("source_type") == "artifact"
            or software_id != short_id("SW", old.get("repository_url", "").lower())
        )
        retained = json.loads(json.dumps(old))
        if old.get("manual", inferred_manual):
            retained["manual"] = True
            retained["state"] = "current"
        else:
            retained["manual"] = False
            retained["state"] = "missing"
        software[software_id] = retained
    auto_relations = [r for r in registry.get("relations", []) if not r.get("automatic")]
    repository_groups: dict[str, dict] = {}
    for resource in resources.values():
        if resource.get("state") != "current":
            continue
        repository = github_repository(resource["canonical_url"])
        if not repository:
            continue
        owner, name, revision, revision_requires_review = repository
        # GitHub owner/repository identity is case-insensitive.  Group and
        # publish it in one canonical case so differently-cased source links
        # cannot hide conflicting revision candidates under the same SW ID.
        canonical_repo = f"https://github.com/{owner.lower()}/{name.lower()}"
        group = repository_groups.setdefault(canonical_repo, {
            "owner": owner.lower(), "name": name.lower(), "resources": [],
            "revisions": set(), "ambiguous": False,
        })
        group["resources"].append(resource["id"])
        if revision:
            group["revisions"].add(revision)
        group["ambiguous"] = group["ambiguous"] or revision_requires_review
    for canonical_repo, group in sorted(repository_groups.items()):
        software_id = short_id("SW", canonical_repo.lower())
        old = software.get(software_id, {})
        revisions = sorted(group["revisions"])
        inferred_conflict = bool(group["ambiguous"] or len(revisions) > 1)
        manual_revision = old.get("revision_source") == "manual" and bool(old.get("requested_revision"))
        requested_revision = old.get("requested_revision", "") if manual_revision else (revisions[0] if len(revisions) == 1 and not inferred_conflict else "")
        requires_review = False if manual_revision else inferred_conflict
        keep_retrieval = bool(
            old.get("retrieval", {}).get("ok")
            and old.get("requested_revision", "") == requested_revision
            and old.get("retrieval", {}).get("requested_revision") == requested_revision
            and not requires_review
        )
        annotation = default_annotation("software")
        annotation.update({
            "title": f"{group['owner']}/{group['name']}", "purpose": "", "environment": "",
            "usage": "", "no_output_reason": "",
        })
        annotation.update(old.get("annotations", {}))
        software[software_id] = {
            "id": software_id, "state": "current", "manual": False,
            "repository_url": canonical_repo,
            "source_type": "git",
            "discovered_from": sorted(set(old.get("discovered_from", []) + group["resources"])),
            "requested_revision": requested_revision,
            "revision_source": "manual" if manual_revision else "inferred",
            "revision_candidates": revisions,
            "revision_requires_review": requires_review,
            "revision_conflict": len(revisions) > 1,
            "resolved_revision": old.get("resolved_revision", "") if keep_retrieval else "",
            "annotations": annotation,
            "retrieval": old.get("retrieval", {}) if keep_retrieval else {},
        }
        for resource_id in group["resources"]:
            auto_relations.append({
                "from": resource_id, "kind": "resource-identifies-software",
                "to": software_id, "automatic": True,
            })
    registry["software"] = software
    registry["relations"] = auto_relations
    registry["note_references"] = note_refs
    registry["scan"] = {
        "completed_at": now_utc(), "integrations": sorted(integrations),
        "note_source_files": source_files,
        "source_fingerprint": manifest_fingerprint(source_files),
        "artifact_set": config.get("artifact_set", "notes"),
        "artifacts": artifact_scans,
        "asset_count": len([a for a in assets.values() if a.get("state") == "current"]),
        "visual_count": len([v for v in visuals.values() if v.get("state") == "current"]),
        "resource_count": len([r for r in resources.values() if r.get("state") == "current"]),
        "software_count": len([s for s in software.values() if s.get("state") == "current"]),
    }
    registry["scan"]["discovery_fingerprint"] = discovery_fingerprint(registry)
    return registry


def discovery_fingerprint(registry: dict) -> str:
    def cleaned(section: str, entry: dict) -> dict:
        ignored = {
            "annotations", "stable_observations", "visual_review_preparations",
            "visual_reviews", "active_visual_review_preparation",
        }
        if section == "resources":
            ignored.update({"verification", "retrieval"})
        if section == "software":
            ignored.update({"requested_revision", "resolved_revision", "retrieval"})
        return {key: value for key, value in entry.items() if key not in ignored}

    view = {
        section: {
            entry_id: cleaned(section, entry)
            for entry_id, entry in sorted(registry.get(section, {}).items())
        }
        for section in ("assets", "visuals", "resources", "software")
    }
    view["note_references"] = registry.get("note_references", [])
    view["integrations"] = registry.get("scan", {}).get("integrations", [])
    view["note_source_files"] = registry.get("scan", {}).get("note_source_files", [])
    view["artifact_set"] = registry.get("scan", {}).get("artifact_set", "notes")
    view["artifacts"] = registry.get("scan", {}).get("artifacts", {})
    payload = json.dumps(view, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()


def manifest_fingerprint(entries: list[dict]) -> str:
    payload = json.dumps(entries, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()


def load_ingestion_manifest(project: pathlib.Path) -> dict | None:
    path = managed_paths(project)["ingestion"]
    if not path.exists():
        return None
    reject_symlink_chain(path, project)
    manifest = read_json(path)
    if manifest.get("schema_version") != SCHEMA_VERSION or not isinstance(manifest.get("inputs"), dict):
        raise HarnessError("unsupported ingestion manifest")
    if manifest.get("project") != project.name:
        raise HarnessError("ingestion manifest project identity does not match the selected project")
    return manifest


def ingestion_fingerprint(manifest: dict | None) -> str:
    if not manifest:
        return ""
    entries = [
        {
            key: entry.get(key)
            for key in (
                "asset_id", "path", "revision_id", "status", "source_kind", "paper_id",
                "paper_role", "paper_scope", "parent_paper_id", "size", "mtime_ns", "sha256",
            )
        }
        for _, entry in sorted(manifest.get("inputs", {}).items())
    ]
    return manifest_fingerprint(entries)


def stable_observation_tokens(asset: dict, min_interval_seconds: float) -> set[str]:
    matching = [
        item for item in asset.get("stable_observations", [])
        if item.get("before_after_stat_match") is True
        and item.get("sha256") == asset.get("sha256")
        and item.get("size") == asset.get("size")
        and isinstance(item.get("observed_ns"), int)
        and item.get("scan_token")
    ]
    if len({item["scan_token"] for item in matching}) < 2:
        return set()
    observed = [item["observed_ns"] for item in matching]
    if max(observed) - min(observed) < int(min_interval_seconds * 1_000_000_000):
        return set()
    return {item["scan_token"] for item in matching}


def record_ingestion(project: pathlib.Path, config: dict, registry: dict, args: argparse.Namespace) -> dict:
    section, asset = find_entry(registry, args.asset_id)
    if section != "assets" or asset.get("role") != "external-input" or asset.get("state") != "current":
        raise HarnessError("record-ingestion requires a current inbox asset")
    if not args.reason.strip():
        raise HarnessError("ingestion decision requires a reason")
    isolated_project = project.parent == (repo_root() / "paper-lecture-notes").resolve()
    paper_scope = args.paper_scope.strip()
    if args.status == "adopted" and isolated_project and not args.source_kind:
        raise HarnessError("adopted input requires --source-kind in an isolated project")
    if args.source_kind == "paper":
        if not args.paper_id or not PAPER_ID.fullmatch(args.paper_id):
            raise HarnessError("paper input requires a valid --paper-id such as PAPER-MAIN")
        if args.paper_role not in PAPER_ROLES:
            raise HarnessError("paper input requires --paper-role")
        if not paper_scope:
            raise HarnessError("paper input requires --paper-scope")
        if args.parent_paper_id:
            raise HarnessError("paper input cannot have --parent-paper-id")
    else:
        if args.paper_id or args.paper_role or paper_scope:
            raise HarnessError("Paper ID, role, and scope apply only to --source-kind paper")
        if args.parent_paper_id and not PAPER_ID.fullmatch(args.parent_paper_id):
            raise HarnessError("--parent-paper-id is invalid")
    min_interval = float(config.get("ingestion", {}).get("min_stability_interval_seconds", 1.0))
    if min_interval < 0:
        raise HarnessError("ingestion stability interval cannot be negative")
    distinct_scans = stable_observation_tokens(asset, min_interval)
    if args.status == "adopted" and len(distinct_scans) < 2:
        raise HarnessError("adoption requires two stable observations from distinct scans")
    manifest = load_ingestion_manifest(project) or {
        "schema_version": SCHEMA_VERSION, "project": project.name, "inputs": {},
    }
    existing = manifest["inputs"].get(args.asset_id, {})
    if existing.get("paper_id") and existing.get("paper_id") != args.paper_id:
        raise HarnessError("an existing asset cannot change its Paper ID")
    if args.paper_id:
        asset_path = asset.get("locations", [""])[0]
        for other_asset_id, decision in manifest["inputs"].items():
            other_asset = registry.get("assets", {}).get(other_asset_id, {})
            if (
                other_asset_id != args.asset_id
                and decision.get("paper_id") == args.paper_id
                and decision.get("path") != asset_path
                and decision.get("status") == "adopted"
                and other_asset.get("state") == "current"
            ):
                raise HarnessError("Paper ID is already bound to another current adopted source")
    manifest["inputs"][args.asset_id] = {
        "asset_id": args.asset_id,
        "path": asset.get("locations", [""])[0],
        "revision_id": args.revision_id,
        "status": args.status,
        "reason": args.reason.strip(),
        "source_kind": args.source_kind or "",
        "paper_id": args.paper_id or "",
        "paper_role": args.paper_role or "",
        "paper_scope": paper_scope,
        "parent_paper_id": args.parent_paper_id or "",
        "size": asset.get("size"), "mtime_ns": asset.get("mtime_ns"),
        "sha256": asset.get("sha256"),
        "first_recorded_at": existing.get("first_recorded_at", now_utc()),
        "updated_at": now_utc(),
        "snapshot_policy": "content hash revalidated at evidence gates",
        "stable_observation_tokens": sorted(distinct_scans),
    }
    manifest["updated_at"] = now_utc()
    manifest["snapshot_fingerprint"] = ingestion_fingerprint(manifest)
    return manifest


def status_fields(
    project: pathlib.Path, config: dict | None = None,
    artifact_id: str | None = None,
) -> dict[str, str]:
    if config is not None and artifact_id is not None:
        artifacts = artifact_specs(project, config)
        if artifact_id not in artifacts:
            raise HarnessError(f"unknown artifact: {artifact_id}")
        preferred = ensure_within(
            project / artifacts[artifact_id]["status"], project / "draft",
        )
        candidates = [preferred] if preferred.is_file() else []
    else:
        preferred = project / "draft" / "STATUS.md"
        candidates = [preferred] if preferred.is_file() else sorted((project / "draft").glob("STATUS*"))
    if not candidates:
        return {}
    path = candidates[0]
    if not path.is_file() or path.is_symlink():
        raise HarnessError("draft STATUS path is invalid")
    fields: dict[str, str] = {}
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        match = re.match(r"^\s*-\s*([A-Za-z0-9_]+):\s*(.*?)\s*$", line)
        if match:
            fields[match.group(1)] = match.group(2).strip().strip("`")
    fields["_path"] = path.relative_to(project).as_posix()
    return fields


def catalog_fingerprint(registry: dict) -> str:
    view = {
        key: registry.get(key)
        for key in ("schema_version", "project", "scope", "scan", "assets", "visuals", "resources", "software", "runs", "relations")
    }
    payload = json.dumps(view, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()


def json_fingerprint(value: object) -> str:
    payload = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()


def tex_escape(value: object) -> str:
    text = str(value or "")
    replacements = {
        "\\": r"\textbackslash{}", "{": r"\{", "}": r"\}",
        "$": r"\$", "&": r"\&", "#": r"\#", "_": r"\_",
        "%": r"\%", "~": r"\textasciitilde{}", "^": r"\textasciicircum{}",
    }
    return "".join(replacements.get(char, char) for char in text)


def tex_path(value: object) -> str:
    text = str(value or "")
    for delimiter in ("|", "+", "!", ";", "?"):
        if delimiter not in text:
            return rf"\path{delimiter}{text}{delimiter}"
    return tex_escape(text)


def annotation_summary(entry: dict) -> str:
    annotation = entry.get("annotations", {})
    if "command" in entry and "software" in entry:
        return (
            f"{annotation.get('public_summary') or '再現実行記録'} — "
            f"実行状態={entry.get('status')}; software={entry.get('software')}@{entry.get('software_revision')}; "
            f"inputs={','.join(entry.get('inputs', [])) or 'none'}; "
            f"outputs={','.join(entry.get('outputs', [])) or 'none'}"
        )
    title = annotation.get("public_summary") or annotation.get("title") or entry.get("kind") or entry.get("visual_type") or ""
    disposition = annotation.get("disposition", "pending")
    disposition = {
        "pending": "未採否", "include": "索引掲載", "explain": "本文解説", "exclude": "除外",
    }.get(disposition, disposition)
    origin = annotation.get("origin", "")
    origin = {
        "source-original": "原資料の図表", "permitted-copy": "許諾転載",
        "faithful-redraw": "忠実再描画", "adapted": "改変図",
        "note-original": "本ノート独自図", "software-output": "software 出力",
        "pending": "由来未確定",
    }.get(origin, origin)
    result = f"{title} — 採用状態={disposition}" + (f", 由来={origin}" if origin else "")
    if annotation.get("license"):
        result += f", license={annotation['license']}"
    if annotation.get("exclusion_reason"):
        result += f", 除外理由={annotation['exclusion_reason']}"
    return result


def render(project: pathlib.Path, registry: dict) -> None:
    paths = managed_paths(project)
    fingerprint = catalog_fingerprint(registry)
    macros = rf"""% Generated by .system/paper-evidence-harness. Do not edit.
% evidence-fingerprint: {fingerprint}
\providecommand{{\EvidenceAsset}}[1]{{\hyperlink{{evidence:#1}}{{\textsuperscript{{[asset: \texttt{{#1}}]}}}}}}
\providecommand{{\EvidenceVisual}}[1]{{\hyperlink{{evidence:#1}}{{\textsuperscript{{[visual: \texttt{{#1}}]}}}}}}
\providecommand{{\EvidenceResource}}[1]{{\hyperlink{{evidence:#1}}{{\textsuperscript{{[resource: \texttt{{#1}}]}}}}}}
\providecommand{{\EvidenceSoftware}}[1]{{\hyperlink{{evidence:#1}}{{\textsuperscript{{[software: \texttt{{#1}}]}}}}}}
\providecommand{{\EvidenceVisualPlacement}}[2]{{\hyperlink{{evidence:#1}}{{\textsuperscript{{[placed visual: \texttt{{#1}} via \texttt{{#2}}]}}}}}}
\providecommand{{\EvidenceCodePlacement}}[1]{{\hyperlink{{evidence:#1}}{{\textsuperscript{{[placed code: \texttt{{#1}}]}}}}}}
\providecommand{{\EvidenceOriginalCaption}}[2]{{\caption{{【本ノート独自図】#2}}\label{{fig:#1}}}}
"""
    lines = [
        "% Generated by .system/paper-evidence-harness. Do not edit.",
        f"% evidence-fingerprint: {fingerprint}",
        r"\ifdefined\chapter",
        r"  \chapter*{図・外部資料・ソフトウェア索引}",
        r"  \addcontentsline{toc}{chapter}{図・外部資料・ソフトウェア索引}",
        r"\else",
        r"  \section*{図・外部資料・ソフトウェア索引}",
        r"  \addcontentsline{toc}{section}{図・外部資料・ソフトウェア索引}",
        r"\fi",
        "この索引は採用入力と講義ノート正本から機械生成した。採用状態が未採否の項目は、検証済みまたは配布可能であることを意味しない。",
        r"\begingroup\raggedright",
    ]
    sections = (
        ("assets", "外部ファイルと成果物"),
        ("visuals", "図表"),
        ("resources", "外部リンク"),
        ("software", "ソフトウェア"),
        ("runs", "再現実行記録"),
    )
    for key, title in sections:
        lines.extend([rf"\section*{{{tex_escape(title)}}}", r"\begin{description}"])
        current = [entry for entry in registry.get(key, {}).values() if entry.get("state", "current") == "current"]
        if not current:
            lines.append(r"\item[なし] 現在の走査範囲では検出されていない。")
        for entry in sorted(current, key=lambda item: item["id"]):
            annotation = entry.get("annotations", {})
            if annotation.get("visibility") != "reader":
                lines.append(
                    rf"\item[] \hypertarget{{evidence:{entry['id']}}}{{\texttt{{{tex_escape(entry['id'])}}}}}\par "
                    r"非公開項目（詳細は private evidence ledger に記録）"
                )
                continue
            summary = annotation_summary(entry)
            link = ""
            if key == "assets":
                if entry.get("pdf"):
                    pdf = entry["pdf"]
                    summary += (
                        f"; PDF={pdf.get('pages')}頁, caption候補={len(pdf.get('caption_candidates', []))}, "
                        f"埋込raster候補={len(pdf.get('embedded_rasters', []))}, 添付={len(pdf.get('attachments', []))}"
                    )
                if entry.get("archive"):
                    archive = entry["archive"]
                    summary += f"; archive member={len(archive.get('members', []))}件"
            elif key == "resources":
                summary += "; URL="
                command = "nolinkurl" if entry.get("secret_query_redacted") or entry.get("annotations", {}).get("disposition") == "exclude" else "url"
                link = rf"\{command}{{{entry.get('canonical_url', '')}}}"
                if entry.get("retrieval", {}).get("ok"):
                    retrieval = entry["retrieval"]
                    summary += f"; 取得size={retrieval.get('size')} bytes（hash は private ledger に記録）"
            elif key == "software":
                summary += f"; revision={entry.get('resolved_revision') or entry.get('requested_revision') or 'unlocked'}"
                if entry.get("repository_url"):
                    link = rf"; \url{{{entry.get('repository_url', '')}}}"
                elif entry.get("artifact_resource"):
                    summary += f"; artifact-resource={entry['artifact_resource']}"
            elif key == "visuals":
                locator = entry.get("locator", {})
                public_locator = ", ".join(
                    f"{name}={value}" for name, value in locator.items()
                    if name in {"page", "label"}
                )
                if public_locator:
                    summary += f"; locator={public_locator}"
            lines.append(
                rf"\item[] \hypertarget{{evidence:{entry['id']}}}{{\texttt{{{tex_escape(entry['id'])}}}}}\par "
                rf"{tex_escape(summary)}{link}"
            )
            if key == "assets":
                for attachment in entry.get("pdf", {}).get("attachments", []):
                    name = attachment.get("name") if isinstance(attachment, dict) else str(attachment)
                    resolution = annotation.get("attachment_resolutions", {}).get(name, {})
                    resolution_text = resolution.get("status", "unresolved")
                    if resolution.get("reason"):
                        resolution_text += f": {resolution['reason']}"
                    if resolution.get("adopted_asset"):
                        resolution_text += f"; asset={resolution['adopted_asset']}"
                    lines.append(rf"\item[] 添付: {tex_path(name)}; resolution={tex_escape(resolution_text)}")
                archive = entry.get("archive", {})
                if archive.get("container_internals"):
                    lines.append(
                        rf"\item[] container internal components: {len(archive.get('members', []))}; "
                        rf"format={tex_escape(archive.get('container_format', ''))}; "
                        r"names and byte details are retained only in the private evidence ledger"
                    )
                for member in ([] if archive.get("container_internals") else archive.get("members", [])):
                    name = str(member.get("path", ""))
                    resolution = annotation.get("archive_member_resolutions", {}).get(name, {})
                    resolution_text = resolution.get("status", "unresolved")
                    if resolution.get("reason"):
                        resolution_text += f": {resolution['reason']}"
                    if resolution.get("adopted_asset"):
                        resolution_text += f"; asset={resolution['adopted_asset']}"
                    lines.append(
                        rf"\item[] archive member: {tex_path(name)}; size={member.get('size', '')}; "
                        rf"resolution={tex_escape(resolution_text)}"
                    )
        lines.append(r"\end{description}")
    lines.extend([r"\section*{対応関係}", r"\begin{description}"])
    if not registry.get("relations"):
        lines.append(r"\item[なし] 対応関係は未登録である。")
    reader_ids = {
        entry_id for entry_id, (_, entry) in all_entries(registry).items()
        if entry.get("state", "current") == "current"
        and entry.get("annotations", {}).get("visibility") == "reader"
    }
    public_relations = [
        relation for relation in registry.get("relations", [])
        if relation.get("from") in reader_ids and relation.get("to") in reader_ids
    ]
    for index, relation in enumerate(public_relations, 1):
        text = f"{relation.get('from')} --{relation.get('kind')}→ {relation.get('to')}"
        lines.append(rf"\item[{index}] {tex_escape(text)}")
    private_relation_count = len(registry.get("relations", [])) - len(public_relations)
    if private_relation_count:
        lines.append(rf"\item[] 非公開の対応関係 {private_relation_count} 件は private evidence ledger に記録。")
    lines.append(r"\end{description}")
    lines.append(r"\endgroup")
    atomic_write(paths["generated"] / "evidence-macros.tex", macros)
    atomic_write(paths["generated"] / "evidence-index.tex", "\n".join(lines) + "\n")

    markdown = [
        "# Evidence index", "", f"- catalog fingerprint: `{fingerprint}`",
        "- state: generated WIP; pending entries are not reviewed", "",
    ]
    for key, title in sections:
        markdown.extend([f"## {title}", ""])
        current = [entry for entry in registry.get(key, {}).values() if entry.get("state", "current") == "current"]
        if not current:
            markdown.append("- none")
        for entry in sorted(current, key=lambda item: item["id"]):
            if entry.get("annotations", {}).get("visibility") != "reader":
                markdown.append(f"- `{entry['id']}`: private entry; details are in the private evidence ledger")
                continue
            markdown.append(f"- `{entry['id']}`: {annotation_summary(entry)}")
            if key == "assets":
                annotation = entry.get("annotations", {})
                for attachment in entry.get("pdf", {}).get("attachments", []):
                    name = attachment.get("name") if isinstance(attachment, dict) else str(attachment)
                    resolution = annotation.get("attachment_resolutions", {}).get(name, {})
                    markdown.append(f"  - attachment `{name}`: {resolution.get('status', 'unresolved')} — {resolution.get('reason', '')}")
                archive = entry.get("archive", {})
                if archive.get("container_internals"):
                    markdown.append(
                        f"  - container internals: {len(archive.get('members', []))} components; "
                        f"format={archive.get('container_format', '')}; names/details remain private"
                    )
                for member in ([] if archive.get("container_internals") else archive.get("members", [])):
                    name = str(member.get("path", ""))
                    resolution = annotation.get("archive_member_resolutions", {}).get(name, {})
                    markdown.append(f"  - archive member `{name}` ({member.get('size', '')} bytes): {resolution.get('status', 'unresolved')} — {resolution.get('reason', '')}")
        markdown.append("")
    atomic_write(paths["generated"] / "evidence-index.md", "\n".join(markdown))


def begin_catalog_transaction(paths: dict[str, pathlib.Path], operation: str, registry: dict) -> None:
