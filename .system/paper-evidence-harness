def all_entries(registry: dict) -> dict[str, tuple[str, dict]]:
    entries: dict[str, tuple[str, dict]] = {}
    for section in ("assets", "visuals", "resources", "software", "runs"):
        for entry_id, entry in registry.get(section, {}).items():
            if entry_id in entries:
                raise HarnessError(f"duplicate registry ID: {entry_id}")
            entries[entry_id] = (section, entry)
    return entries


def relation_type_error(relation: dict, entries: dict[str, tuple[str, dict]]) -> str | None:
    source = relation.get("from")
    target = relation.get("to")
    kind = relation.get("kind")
    if kind not in RELATION_TYPES:
        return f"unknown relation kind: {kind}"
    if source == target:
        return f"self relation is not allowed: {source}"
    if source not in entries or target not in entries:
        return f"broken relation: {source} -> {target}"
    allowed_sources, allowed_targets = RELATION_TYPES[kind]
    source_section = entries[source][0]
    target_section = entries[target][0]
    if source_section not in allowed_sources or target_section not in allowed_targets:
        return f"relation type mismatch: {source_section} --{kind}→ {target_section}"
    return None


def relation_cycle(registry: dict) -> list[str] | None:
    graph: dict[str, list[str]] = {}
    for relation in registry.get("relations", []):
        graph.setdefault(str(relation.get("from")), []).append(str(relation.get("to")))
    visiting: set[str] = set()
    visited: set[str] = set()

    def visit(node: str, path: list[str]) -> list[str] | None:
        if node in visiting:
            return path[path.index(node):] + [node]
        if node in visited:
            return None
        visiting.add(node)
        path.append(node)
        for target in graph.get(node, []):
            found = visit(target, path)
            if found:
                return found
        path.pop()
        visiting.remove(node)
        visited.add(node)
        return None

    for node in graph:
        found = visit(node, [])
        if found:
            return found
    return None


def reference_ids(registry: dict, kind: str | None = None) -> set[str]:
    return {
        item["id"] for item in registry.get("note_references", [])
        if kind is None or item.get("kind") == kind
    }


def artifact_reference_records(registry: dict, artifact_id: str) -> list[dict]:
    configured_ids = set(registry.get("scan", {}).get("artifacts", {}))
    legacy_single = not configured_ids or configured_ids == {"notes"}
    return [
        reference for reference in registry.get("note_references", [])
        if reference.get("artifact") == artifact_id
        or (
            artifact_id == "notes"
            and legacy_single
            and not reference.get("artifact")
        )
    ]


def artifact_scan_state(registry: dict, artifact_id: str) -> dict:
    state = registry.get("scan", {}).get("artifacts", {}).get(artifact_id)
    if isinstance(state, dict):
        return state
    if artifact_id == "notes":
        return {
            "kind": "lecture-notes",
            "integrations": registry.get("scan", {}).get("integrations", []),
            "source_files": registry.get("scan", {}).get("note_source_files", []),
            "source_fingerprint": registry.get("scan", {}).get("source_fingerprint", ""),
        }
    return {}


def artifact_evidence_ids(
    registry: dict, artifact_id: str, evidence_scope: str,
) -> set[str]:
    entries = all_entries(registry)
    if evidence_scope == "all-current":
        return {
            entry_id for entry_id, (_, entry) in entries.items()
            if entry.get("state", "current") == "current"
        }
    if evidence_scope != "referenced":
        raise HarnessError(f"unknown artifact evidence scope: {evidence_scope}")
    return {
        reference.get("id", "")
        for reference in artifact_reference_records(registry, artifact_id)
        if reference.get("id") in entries
        and entries[reference["id"]][1].get("state", "current") == "current"
    }


def is_code_asset(asset: dict) -> bool:
    if asset.get("kind") == "source-code":
        return True
    return any(
        pathlib.PurePosixPath(str(location)).suffix.lower() in CODE_SUFFIXES
        for location in asset.get("locations", [])
    )


def required_placement_ids(
    registry: dict, evidence_ids: set[str] | None = None,
) -> tuple[set[str], set[str]]:
    required_visuals = {
        visual_id for visual_id, visual in registry.get("visuals", {}).items()
        if visual.get("state", "current") == "current"
        and visual.get("annotations", {}).get("disposition") in {"include", "explain"}
    }
    required_code = {
        asset_id for asset_id, asset in registry.get("assets", {}).items()
        if asset.get("state", "current") == "current"
        and asset.get("annotations", {}).get("disposition") == "explain"
        and is_code_asset(asset)
    }
    if evidence_ids is not None:
        required_visuals &= evidence_ids
        required_code &= evidence_ids
    return required_visuals, required_code


def backing_input_path(
    project: pathlib.Path, asset: dict, input_paths: set[pathlib.Path],
) -> str:
    for relative in asset.get("locations", []):
        try:
            candidate = ensure_within(project / str(relative), project)
        except (HarnessError, OSError):
            continue
        if candidate in input_paths:
            return candidate.relative_to(project).as_posix()
    return ""


def visual_backing_visual_ids(registry: dict, visual_id: str, backing_id: str) -> set[str]:
    visual = registry.get("visuals", {}).get(visual_id, {})
    if visual.get("source_asset") == backing_id:
        return {visual_id}
    backing_visuals = {
        candidate_id for candidate_id, candidate in registry.get("visuals", {}).items()
        if candidate.get("state", "current") == "current"
        and candidate.get("source_asset") == backing_id
    }
    if len(backing_visuals) != 1:
        return set()
    return {
        relation.get("from") for relation in registry.get("relations", [])
        if relation.get("from") in backing_visuals
        and relation.get("kind") == "derived-from"
        and relation.get("to") == visual_id
    }


def visual_backing_matches_lineage(registry: dict, visual_id: str, backing_id: str) -> bool:
    if visual_backing_visual_ids(registry, visual_id, backing_id):
        return True
    has_backing_visual = any(
        candidate.get("state", "current") == "current"
        and candidate.get("source_asset") == backing_id
        for candidate in registry.get("visuals", {}).values()
    )
    return not has_backing_visual and any(
        relation.get("from") == backing_id
        and relation.get("kind") == "derived-from"
        and relation.get("to") == visual_id
        for relation in registry.get("relations", [])
    )


def visual_backing_publication_error(asset: dict) -> str:
    annotation = asset.get("annotations", {})
    if annotation.get("disposition") not in {"include", "explain"}:
        return "backing asset is not included or explained"
    if annotation.get("visibility") != "reader":
        return "backing asset is not reader-visible"
    if annotation.get("privacy_review_status") != "complete":
        return "backing asset privacy review is incomplete"
    if not str(annotation.get("public_summary", "") or "").strip():
        return "backing asset lacks a public summary"
    if annotation.get("rights_status") not in {"cleared", "not-applicable"}:
        return "backing asset rights are unresolved"
    return ""


def required_rendered_placements(
    registry: dict, artifact_id: str | None = None,
    evidence_ids: set[str] | None = None,
) -> tuple[set[tuple[str, str]], set[str]]:
    required_visuals, required_code = required_placement_ids(registry, evidence_ids)
    references = (
        artifact_reference_records(registry, artifact_id)
        if artifact_id is not None else registry.get("note_references", [])
    )
    visual_pairs = {
        (reference.get("id", ""), reference.get("backing_id", ""))
        for reference in references
        if reference.get("kind") == "visual-placement"
        and reference.get("id") in required_visuals
    }
    code_ids = {
        reference.get("id", "") for reference in references
        if reference.get("kind") == "code-placement"
    } & required_code
    return visual_pairs, code_ids


def build_placement_bindings(
    project: pathlib.Path, registry: dict, input_paths: set[pathlib.Path],
    artifact_id: str | None = None, evidence_ids: set[str] | None = None,
) -> dict[str, dict[str, object]]:
    required_visuals, required_code = required_placement_ids(registry, evidence_ids)
    references = (
        artifact_reference_records(registry, artifact_id)
        if artifact_id is not None else registry.get("note_references", [])
    )
    visual_records: dict[str, list[dict]] = {}
    for reference in references:
        if reference.get("kind") == "visual-placement":
            visual_records.setdefault(reference.get("id", ""), []).append(reference)
    visual_markers = set(visual_records)
    code_markers = {
        reference.get("id", "") for reference in references
        if reference.get("kind") == "code-placement"
    }
    missing_visual_markers = sorted(required_visuals - visual_markers)
    missing_code_markers = sorted(required_code - code_markers)
    if missing_visual_markers:
        raise HarnessError(
            "included visual lacks EvidenceVisualPlacement: "
            + ", ".join(missing_visual_markers)
        )
    if missing_code_markers:
        raise HarnessError(
            "included code lacks EvidenceCodePlacement: "
            + ", ".join(missing_code_markers)
        )

    bindings: dict[str, dict[str, object]] = {"visuals": {}, "code": {}}
    for visual_id in sorted(required_visuals):
        bound_assets: list[str] = []
        for reference in visual_records.get(visual_id, []):
            backing_id = reference.get("backing_id", "")
            asset = registry.get("assets", {}).get(backing_id, {})
            if asset.get("state", "current") != "current":
                raise HarnessError(
                    f"visual placement backing asset is missing: {visual_id} -> {backing_id}"
                )
            publication_error = visual_backing_publication_error(asset)
            if publication_error:
                raise HarnessError(
                    f"visual placement {publication_error}: {visual_id} -> {backing_id}"
                )
            if not visual_backing_matches_lineage(registry, visual_id, backing_id):
                raise HarnessError(
                    f"visual placement backing asset lacks lineage: {visual_id} -> {backing_id}"
                )
            path = backing_input_path(project, asset, input_paths)
            if not path:
                raise HarnessError(
                    f"visual placement backing asset was not read by build: {visual_id} -> {backing_id}"
                )
            bound_assets.append(f"{backing_id}:{path}")
        bindings["visuals"][visual_id] = sorted(set(bound_assets))
    for asset_id in sorted(required_code):
        asset = registry.get("assets", {}).get(asset_id, {})
        path = backing_input_path(project, asset, input_paths)
        if not path:
            raise HarnessError(
                f"code placement backing asset was not read by build: {asset_id}"
            )
        bindings["code"][asset_id] = path
    return bindings


def inspect_reader_visibility(entry: dict, strict: bool, errors: list[str], warnings: list[str]) -> None:
    if entry.get("state", "current") != "current":
        return
    annotation = entry.get("annotations", {})
    entry_id = entry.get("id", "unknown")
    visibility = annotation.get("visibility", "pending")
    disposition = annotation.get("disposition", "pending")
    if visibility == "pending":
        (errors if strict else warnings).append(f"reader visibility is pending: {entry_id}")
    if disposition in {"include", "explain"} and visibility != "reader":
        errors.append(f"included/explained entry is not reader-visible: {entry_id}")
    if visibility == "reader":
        if annotation.get("privacy_review_status") != "complete":
            (errors if strict else warnings).append(f"reader-visible entry lacks privacy review: {entry_id}")
        if not str(annotation.get("public_summary", "") or "").strip():
            (errors if strict else warnings).append(f"reader-visible entry lacks a public summary: {entry_id}")


def review_receipt_fingerprint(review: dict) -> str:
    view = json.loads(json.dumps(review))
    view.pop("receipt_fingerprint", None)
    return json_fingerprint(view)


def inspect_visual_review_target(
    project: pathlib.Path, registry: dict, target_id: str, strict: bool,
    errors: list[str], warnings: list[str],
) -> None:
    try:
        _, target, _, current_input = visual_review_target(registry, target_id)
    except HarnessError as exc:
        errors.append(str(exc))
        return
    preparation_id = target.get("active_visual_review_preparation", "")
    preparation = target.get("visual_review_preparations", {}).get(preparation_id, {})
    if not preparation_id:
        (errors if strict else warnings).append(f"Codex visual review preparation is missing: {target_id}")
        return
    preparation_errors = validate_visual_review_preparation(
        project, registry, target_id, preparation,
    )
    if preparation_errors:
        errors.extend(preparation_errors)
        return
    current_reviews: dict[str, dict] = {}
    for review_id, review in target.get("visual_reviews", {}).items():
        if review.get("receipt_fingerprint") != review_receipt_fingerprint(review):
            errors.append(f"visual review receipt fingerprint is invalid: {target_id} {review_id}")
            continue
        if review.get("target_id") != target_id:
            errors.append(f"visual review target identity is invalid: {target_id} {review_id}")
            continue
        checks = review.get("checks", {})
        if (
            not isinstance(checks, dict) or set(checks) != set(VISUAL_REVIEW_CHECKS)
            or any(status not in VISUAL_REVIEW_STATUSES for status in checks.values())
            or review.get("reviewer_kind") not in {"codex", "human", "domain-expert"}
            or review.get("role") not in {"primary", "independent"}
            or review.get("verdict") not in VISUAL_REVIEW_VERDICTS
            or (
                review.get("verdict") == "pass"
                and any(checks.get(key) != "complete" for key in VISUAL_REVIEW_ALWAYS_REQUIRED)
            )
        ):
            errors.append(f"visual review receipt schema is invalid: {target_id} {review_id}")
            continue
        if (
            review.get("preparation_id") == preparation_id
            and review.get("preparation_fingerprint") == preparation.get("receipt_fingerprint")
            and review.get("input_fingerprint") == current_input
        ):
            current_reviews[review_id] = review
    nonpassing = [review_id for review_id, review in current_reviews.items() if review.get("verdict") != "pass"]
    if nonpassing:
        (errors if strict else warnings).append(
            f"current visual review has open findings: {target_id} ({', '.join(sorted(nonpassing))})"
        )
    primaries = {
        review_id: review for review_id, review in current_reviews.items()
        if review.get("role") == "primary" and review.get("verdict") == "pass"
        and review.get("reviewer_kind") == "codex"
        and not review.get("findings") and "blocked" not in review.get("checks", {}).values()
    }
    independent_pairs = [
        (review_id, review, primaries.get(review.get("independent_of")))
        for review_id, review in current_reviews.items()
        if review.get("role") == "independent" and review.get("verdict") == "pass"
        and review.get("reviewer_kind") == "codex"
        and not review.get("findings") and "blocked" not in review.get("checks", {}).values()
    ]
    valid_pair = any(
        primary is not None and primary.get("reviewer") != review.get("reviewer")
        for _, review, primary in independent_pairs
    )
    if not primaries:
        (errors if strict else warnings).append(f"passing primary Codex visual review is missing: {target_id}")
    if not valid_pair:
        (errors if strict else warnings).append(f"independent Codex visual re-review is missing: {target_id}")


def inspect_gate(project: pathlib.Path, config: dict, registry: dict, phase: str) -> tuple[list[str], list[str]]:
    errors: list[str] = []
    warnings: list[str] = []
    entries = all_entries(registry)
    strict = phase in {"shared-draft", "promotion"}
    promotion = phase == "promotion"
    note_refs = reference_ids(registry)
    original_caption_refs = reference_ids(registry, "original-caption")
    visual_placement_refs = reference_ids(registry, "visual-placement")
    code_placement_refs = reference_ids(registry, "code-placement")
    for _, entry in entries.values():
        inspect_reader_visibility(entry, strict, errors, warnings)
    if managed_paths(project)["transaction"].exists():
        errors.append("an interrupted catalog transaction must be recovered with scan")
    manifest = load_ingestion_manifest(project)
    current_ingestion_fingerprint = ingestion_fingerprint(manifest)
    min_stability_interval = float(config.get("ingestion", {}).get("min_stability_interval_seconds", 1.0))

    inbox_assets = {
        entry_id: entry for entry_id, entry in registry.get("assets", {}).items()
        if entry.get("role") == "external-input" and entry.get("state") == "current"
    }
    manifest_inputs = manifest.get("inputs", {}) if manifest else {}
    if not manifest:
        (errors if strict else warnings).append("machine-readable paper ingestion manifest is missing")
    for asset_id, asset in inbox_assets.items():
        decision = manifest_inputs.get(asset_id)
        if not decision:
            (errors if strict else warnings).append(f"inbox asset lacks an ingestion decision: {asset_id}")
            continue
        if any(decision.get(key) != asset.get(asset_key) for key, asset_key in (
            ("size", "size"), ("mtime_ns", "mtime_ns"), ("sha256", "sha256"),
        )) or decision.get("path") not in asset.get("locations", []):
            errors.append(f"ingestion manifest does not match current asset bytes: {asset_id}")
        status = decision.get("status")
        if status not in {"adopted", "excluded", "deferred"}:
            errors.append(f"unknown ingestion decision: {asset_id}")
        if not decision.get("revision_id") or not decision.get("reason"):
            errors.append(f"ingestion decision lacks revision or reason: {asset_id}")
        if strict and status == "deferred":
            errors.append(f"inbox asset ingestion remains deferred: {asset_id}")
        if status == "adopted":
            matching_tokens = stable_observation_tokens(asset, min_stability_interval)
            recorded_tokens = set(decision.get("stable_observation_tokens", []))
            if len(matching_tokens) < 2 or len(recorded_tokens) < 2 or not recorded_tokens <= matching_tokens:
                errors.append(f"adopted inbox asset lacks two matching stable observations: {asset_id}")
        disposition = asset.get("annotations", {}).get("disposition", "pending")
        if status == "adopted" and disposition not in {"include", "explain"}:
            errors.append(f"adopted inbox asset is not included/explained: {asset_id}")
        if status == "excluded" and disposition != "exclude":
            errors.append(f"excluded inbox asset does not have exclude disposition: {asset_id}")

    if project.parent == (repo_root() / "paper-lecture-notes").resolve():
        adopted_papers: dict[str, str] = {}
        current_adopted_inputs = {
            asset_id: manifest_inputs[asset_id]
            for asset_id in inbox_assets
            if asset_id in manifest_inputs and manifest_inputs[asset_id].get("status") == "adopted"
        }
        for asset_id, decision in current_adopted_inputs.items():
            source_kind = decision.get("source_kind")
            if source_kind not in SOURCE_KINDS:
                errors.append(f"adopted input lacks a valid source kind: {asset_id}")
                continue
            if source_kind == "paper":
                paper_id = decision.get("paper_id", "")
                if not PAPER_ID.fullmatch(paper_id):
                    errors.append(f"adopted paper lacks a valid Paper ID: {asset_id}")
                elif paper_id in adopted_papers:
                    errors.append(
                        f"Paper ID is bound to multiple current sources: {paper_id} "
                        f"({adopted_papers[paper_id]}, {asset_id})"
                    )
                else:
                    adopted_papers[paper_id] = asset_id
                if decision.get("paper_role") not in PAPER_ROLES:
                    errors.append(f"adopted paper lacks a valid role: {asset_id}")
                if not str(decision.get("paper_scope", "")).strip():
                    errors.append(f"adopted paper lacks a scope: {asset_id}")
                if decision.get("parent_paper_id"):
                    errors.append(f"paper input has a parent Paper ID: {asset_id}")
            elif any(decision.get(key) for key in ("paper_id", "paper_role", "paper_scope")):
                errors.append(f"non-paper input contains paper-only metadata: {asset_id}")
        for asset_id, decision in current_adopted_inputs.items():
            parent_paper_id = decision.get("parent_paper_id", "")
            if parent_paper_id and parent_paper_id not in adopted_papers:
                errors.append(f"adopted input refers to an unknown parent Paper ID: {asset_id}")
        if strict and not adopted_papers:
            errors.append("isolated project has no adopted source paper with a Paper ID")

    for artifact_id, spec in artifact_specs(project, config).items():
        artifact_state = artifact_scan_state(registry, artifact_id)
        integrations = set(artifact_state.get("integrations", []))
        if not artifact_state.get("source_files"):
            (errors if strict else warnings).append(
                f"canonical source is empty for artifact: {artifact_id}"
            )
        if spec["requires_evidence_index"] and "index" not in integrations:
            (errors if strict else warnings).append(
                f"canonical source does not input evidence-index.tex for artifact: {artifact_id}"
            )
        if "macros" not in integrations:
            (errors if strict else warnings).append(
                f"canonical source does not input evidence-macros.tex for artifact: {artifact_id}"
            )
    fingerprint = catalog_fingerprint(registry)
    for name in ("evidence-index.tex", "evidence-macros.tex"):
        path = managed_paths(project)["generated"] / name
        if not path.is_file() or f"evidence-fingerprint: {fingerprint}" not in path.read_text(encoding="utf-8", errors="replace"):
            errors.append(f"generated artifact is missing or stale: {name}")

    for reference in registry.get("note_references", []):
        if reference["id"] not in entries:
            errors.append(f"unknown note reference: {reference['id']}")
        elif entries[reference["id"]][0] != REFERENCE_SECTIONS.get(reference.get("kind")):
            errors.append(f"note reference kind does not match registry section: {reference.get('kind')} {reference['id']}")
        elif reference.get("kind") == "code-placement" and not is_code_asset(entries[reference["id"]][1]):
            errors.append(f"code placement does not reference a code asset: {reference['id']}")
        elif reference.get("kind") == "visual-placement":
            backing_id = reference.get("backing_id", "")
            if (
                backing_id not in entries
                or entries[backing_id][0] != "assets"
                or entries[backing_id][1].get("state", "current") != "current"
            ):
                errors.append(
                    f"visual placement backing asset is missing: {reference['id']} -> {backing_id}"
                )
            else:
                backing_asset = entries[backing_id][1]
                publication_error = visual_backing_publication_error(backing_asset)
                if publication_error:
                    errors.append(
                        f"visual placement {publication_error}: {reference['id']} -> {backing_id}"
                    )
                if not visual_backing_matches_lineage(registry, reference["id"], backing_id):
                    errors.append(
                        f"visual placement backing asset lacks lineage: {reference['id']} -> {backing_id}"
                    )
                for backing_visual_id in visual_backing_visual_ids(
                    registry, reference["id"], backing_id,
                ):
                    if backing_visual_id == reference["id"]:
                        continue
                    backing_visual = registry.get("visuals", {}).get(backing_visual_id, {})
                    if backing_visual.get("annotations", {}).get("disposition") not in {"include", "explain"}:
                        errors.append(
                            "visual placement backing visual is not included or explained: "
                            f"{reference['id']} -> {backing_visual_id}"
                        )
    for relation in registry.get("relations", []):
        relation_error = relation_type_error(relation, entries)
        if relation_error:
            errors.append(relation_error)
        elif entries[relation["from"]][1].get("state", "current") != "current" or entries[relation["to"]][1].get("state", "current") != "current":
            errors.append(f"relation endpoint is not current: {relation.get('from')} -> {relation.get('to')}")
    cycle = relation_cycle(registry)
    if cycle:
        errors.append(f"relation graph contains a cycle: {' -> '.join(cycle)}")

    for asset in registry.get("assets", {}).values():
        annotation = asset.get("annotations", {})
        disposition = annotation.get("disposition", "pending")
        if asset.get("state") == "missing":
            if disposition != "exclude":
                errors.append(f"adopted or pending asset is missing: {asset['id']}")
            continue
        if asset.get("state") != "current" or asset.get("security_status") == "blocked":
            errors.append(f"asset is not stable/safe: {asset['id']}")
        if asset.get("metadata_status") == "blocked" and disposition in {"include", "explain"}:
            errors.append(f"included asset metadata inspection is blocked: {asset['id']}")
        if asset.get("metadata_source_sha256") != asset.get("sha256"):
            errors.append(f"asset metadata is not bound to its hashed bytes: {asset['id']}")
        if asset.get("media_type_mismatch"):
            errors.append(f"asset media type does not match its extension: {asset['id']}")
        pdf = asset.get("pdf")
        if pdf and disposition in {"include", "explain"} and str(pdf.get("encrypted", "unknown")).lower() not in {"no", "false"}:
            errors.append(f"encrypted or unconfirmed PDF is blocking: {asset['id']}")
        if not strict and disposition == "pending":
            warnings.append(f"asset disposition is pending: {asset['id']}")
        if strict and disposition == "pending":
            errors.append(f"asset disposition is pending: {asset['id']}")
        if disposition == "exclude" and not annotation.get("exclusion_reason"):
            errors.append(f"excluded asset lacks a reason: {asset['id']}")
        if disposition in {"include", "explain"} and annotation.get("rights_status") not in ({"cleared", "not-applicable"} if strict else {"cleared", "not-applicable", "restricted-internal"}):
            errors.append(f"included asset rights are unresolved: {asset['id']}")
        if disposition == "explain" and asset["id"] not in note_refs:
            errors.append(f"explained asset lacks a body reference: {asset['id']}")
        if disposition == "explain" and is_code_asset(asset) and asset["id"] not in code_placement_refs:
            errors.append(f"explained code lacks a rendered body placement: {asset['id']}")
        if asset.get("kind") in {"source-document", "source-supplement", "source-archive"} and strict and disposition in {"include", "explain"}:
            for field in ("visual_review_status", "link_review_status", "attachment_review_status"):
                if annotation.get(field) not in {"complete", "not-applicable"}:
                    errors.append(f"{field} is incomplete for {asset['id']}")
            if not annotation.get("reviewer") or not annotation.get("reviewed_at"):
                errors.append(f"completeness review lacks reviewer metadata: {asset['id']}")
        if asset.get("kind") == "source-document" and disposition in {"include", "explain"}:
            if annotation.get("visual_review_status") != "complete":
                (errors if strict else warnings).append(
                    f"source document requires complete Codex full-page visual review: {asset['id']}"
                )
            else:
                inspect_visual_review_target(project, registry, asset["id"], strict, errors, warnings)
        attachment_names = [
            item.get("name") if isinstance(item, dict) else str(item)
            for item in asset.get("pdf", {}).get("attachments", [])
        ]
        member_names = [str(item.get("path", "")) for item in asset.get("archive", {}).get("members", [])]
        container_internals = bool(asset.get("archive", {}).get("container_internals"))
        if len(member_names) != len(set(member_names)):
            errors.append(f"archive has duplicate member paths that cannot be resolved safely: {asset['id']}")
        for category, names, resolution_field in (
            ("attachment", attachment_names, "attachment_resolutions"),
            ("archive member", member_names, "archive_member_resolutions"),
        ):
            resolutions = annotation.get(resolution_field, {})
            if not isinstance(resolutions, dict):
                errors.append(f"{category} resolutions are malformed: {asset['id']}")
                resolutions = {}
            for unknown_name in set(resolutions) - set(names):
                errors.append(f"{category} resolution has no current source item: {asset['id']} {unknown_name}")
            for name in names:
                resolution = resolutions.get(name, {})
                status = resolution.get("status")
                if category == "archive member" and container_internals and not status:
                    continue
                if not status and strict and disposition in {"include", "explain"}:
                    errors.append(f"{category} is unresolved: {asset['id']} {name}")
                    continue
                if not status:
                    warnings.append(f"{category} is unresolved: {asset['id']} {name}")
                    continue
                if status not in {"adopted", "excluded", "deferred"} or not resolution.get("reason"):
                    errors.append(f"{category} resolution is invalid: {asset['id']} {name}")
                if strict and status == "deferred":
                    errors.append(f"{category} remains deferred: {asset['id']} {name}")
                if status == "adopted":
                    adopted_id = resolution.get("adopted_asset")
                    adopted = registry.get("assets", {}).get(adopted_id, {})
                    decision = manifest_inputs.get(adopted_id, {})
                    if adopted.get("state") != "current" or adopted.get("role") != "external-input" or decision.get("status") != "adopted":
                        errors.append(f"adopted {category} is not a current adopted inbox asset: {asset['id']} {name}")
                    if not any(
                        relation.get("from") == adopted_id and relation.get("kind") == "supplements" and relation.get("to") == asset["id"]
                        for relation in registry.get("relations", [])
                    ):
                        errors.append(f"adopted {category} lacks supplements lineage: {asset['id']} {name}")
        archive = asset.get("archive")
        if archive:
            expanded = archive.get("total_uncompressed_bytes", 0)
            ratio = expanded / max(asset.get("size", 1), 1)
            unsafe_archive = (
                bool(archive.get("unsafe_entries"))
                or archive.get("encrypted_entries")
                or archive.get("nested_archives")
                or expanded > 5 * 1024 * 1024 * 1024
                or ratio > 1000
            )
            if unsafe_archive:
                errors.append(f"archive inspection is blocking: {asset['id']}")
            elif archive.get("status") != "inspected" and disposition in {"include", "explain"}:
                errors.append(f"archive inspection is blocking: {asset['id']}")
            if strict and disposition in {"include", "explain"} and annotation.get("archive_review_status") != "complete":
                errors.append(f"archive review is incomplete: {asset['id']}")

    relations = registry.get("relations", [])
    for visual in registry.get("visuals", {}).values():
        if visual.get("state") != "current":
            continue
        annotation = visual.get("annotations", {})
        disposition = annotation.get("disposition", "pending")
        source_asset = registry.get("assets", {}).get(visual.get("source_asset"))
        if not source_asset or source_asset.get("state") != "current":
            errors.append(f"visual source asset is missing or stale: {visual['id']}")
        locator_page = visual.get("locator", {}).get("page")
        if locator_page is not None:
            if not isinstance(locator_page, int) or locator_page < 1:
                errors.append(f"visual page locator is invalid: {visual['id']}")
            pdf_pages = (source_asset or {}).get("pdf", {}).get("pages")
            if isinstance(pdf_pages, int) and isinstance(locator_page, int) and locator_page > pdf_pages:
                errors.append(f"visual page locator exceeds source PDF: {visual['id']}")
        if not strict and disposition == "pending":
            warnings.append(f"visual disposition is pending: {visual['id']}")
        if strict and disposition == "pending":
            errors.append(f"visual disposition is pending: {visual['id']}")
        if disposition == "exclude" and not annotation.get("exclusion_reason"):
            errors.append(f"excluded visual lacks a reason: {visual['id']}")
        if disposition in {"include", "explain"}:
            if annotation.get("rights_status") not in ({"cleared", "not-applicable"} if strict else {"cleared", "not-applicable", "restricted-internal"}):
                errors.append(f"visual rights are unresolved: {visual['id']}")
            if not annotation.get("alt_text"):
                errors.append(f"visual alt text is missing: {visual['id']}")
            if visual["id"] not in note_refs:
                errors.append(f"visual lacks a body reference: {visual['id']}")
            if visual["id"] not in visual_placement_refs:
                errors.append(f"included visual lacks a rendered body placement: {visual['id']}")
            origin = annotation.get("origin", "pending")
            if origin == "pending":
                errors.append(f"visual origin is pending: {visual['id']}")
            if origin == "note-original" and visual["id"] not in original_caption_refs:
                errors.append(f"note-original visual lacks EvidenceOriginalCaption: {visual['id']}")
            if origin in {"faithful-redraw", "adapted"} and not any(
                rel.get("from") == visual["id"] and rel.get("kind") == "derived-from" for rel in relations
            ):
                errors.append(f"redrawn/adapted visual lacks source lineage: {visual['id']}")
            if origin == "software-output" and not any(
                rel.get("from") == visual["id"] and rel.get("kind") == "generated-by" for rel in relations
            ):
                errors.append(f"software visual lacks generator lineage: {visual['id']}")
            inspect_visual_review_target(project, registry, visual["id"], strict, errors, warnings)

    for resource in registry.get("resources", {}).values():
        if resource.get("state") != "current":
            continue
        annotation = resource.get("annotations", {})
        disposition = annotation.get("disposition", "pending")
        if resource.get("secret_query_redacted"):
            errors.append(f"resource URL contains a secret-like query: {resource['id']}")
        retrieval = resource.get("retrieval", {})
        if retrieval.get("ok"):
            try:
                cache_path = ensure_within(project / retrieval.get("cache_path", ""), managed_paths(project)["external_cache"])
                reject_symlink_chain(cache_path, project)
                cache_snapshot = stable_file_snapshot(cache_path)
                if (
                    not cache_snapshot["stable"]
                    or cache_snapshot["size"] != retrieval.get("size")
                    or cache_snapshot["sha256"] != retrieval.get("sha256")
                ):
                    errors.append(f"resource cache receipt does not match bytes: {resource['id']}")
            except (HarnessError, OSError):
                errors.append(f"resource cache receipt is missing or unsafe: {resource['id']}")
        if not strict and disposition == "pending":
            warnings.append(f"resource disposition is pending: {resource['id']}")
        if strict and disposition == "pending":
            errors.append(f"resource disposition is pending: {resource['id']}")
        if disposition == "exclude" and not annotation.get("exclusion_reason"):
            errors.append(f"excluded resource lacks a reason: {resource['id']}")
        if disposition in {"include", "explain"}:
            allowed_rights = {"cleared", "not-applicable"} if strict else {"cleared", "not-applicable", "restricted-internal"}
            if annotation.get("rights_status") not in allowed_rights:
                errors.append(f"resource rights are unresolved: {resource['id']}")
            if resource.get("kind") == "downloadable-file" or resource.get("retrieval", {}).get("ok"):
                if annotation.get("rights_status") != "cleared" or not annotation.get("license"):
                    errors.append(f"downloadable resource license is unresolved: {resource['id']}")
            verification = resource.get("verification", {})
            if annotation.get("link_review_status") != "complete" or not verification.get("ok"):
                errors.append(f"resource is not link-verified: {resource['id']}")
            if disposition == "explain" and resource["id"] not in note_refs:
                errors.append(f"explained resource lacks a body reference: {resource['id']}")

    for software in registry.get("software", {}).values():
        if software.get("state") != "current":
            continue
        annotation = software.get("annotations", {})
        disposition = annotation.get("disposition", "pending")
        retrieval = software.get("retrieval", {})
        if retrieval.get("ok"):
            try:
                if retrieval.get("requested_revision") != software.get("requested_revision", ""):
                    raise HarnessError("software retrieval is bound to a different requested revision")
                if software.get("source_type", "git") == "artifact":
                    cache_path = ensure_within(project / retrieval.get("cache_path", ""), managed_paths(project)["external_cache"])
                    reject_symlink_chain(cache_path, project)
                    snapshot = stable_file_snapshot(cache_path)
                    if (
                        snapshot["sha256"] != retrieval.get("sha256")
                        or snapshot["size"] != retrieval.get("size")
                        or software.get("resolved_revision") != f"sha256:{snapshot['sha256']}"
                    ):
                        errors.append(f"software artifact receipt does not match bytes: {software['id']}")
                else:
                    cache_path = ensure_within(project / retrieval.get("cache_path", ""), managed_paths(project)["software_cache"])
                    reject_symlink_chain(cache_path, project)
                    if not cache_path.is_dir() or cache_path.is_symlink():
                        raise HarnessError("software cache is not a regular directory")
                    revision = software.get("resolved_revision", "")
                    if retrieval.get("resolved_commit") != revision:
                        raise HarnessError("software retrieval is bound to a different resolved commit")
                    commit_check = git_run(["git", f"--git-dir={cache_path}", "cat-file", "-e", f"{revision}^{{commit}}"])
                    origin_check = git_run(["git", f"--git-dir={cache_path}", "config", "--get", "remote.origin.url"])
                    cache_entry_count, cache_size = validate_git_cache_budget(cache_path)
                    current_inventory = git_tree_inventory(cache_path, revision)
                    if commit_check.returncode != 0 or origin_check.returncode != 0 or origin_check.stdout.strip() != software.get("repository_url"):
                        errors.append(f"software cache receipt does not match repository/commit: {software['id']}")
                    if (
                        cache_entry_count != retrieval.get("cache_entry_count")
                        or cache_size != retrieval.get("cache_size")
                    ):
                        errors.append(f"software cache budget receipt does not match current content: {software['id']}")
                    inventory_fields = (
                        "file_count", "inventory_bytes", "top_level", "license_candidates",
                        "submodules_present", "lfs_review_required",
                    )
                    if any(current_inventory.get(field) != retrieval.get(field) for field in inventory_fields):
                        errors.append(f"software tree inventory receipt does not match current content: {software['id']}")
            except (HarnessError, OSError):
                errors.append(f"software cache receipt is missing or unsafe: {software['id']}")
        if not strict and disposition == "pending":
            warnings.append(f"software disposition is pending: {software['id']}")
        if strict and disposition not in {"explain", "exclude"}:
            errors.append(f"software must be explained or excluded: {software['id']}")
        if software.get("revision_requires_review") and disposition != "exclude":
            errors.append(f"software revision candidates require explicit resolution: {software['id']}")
        if disposition == "exclude" and not annotation.get("exclusion_reason"):
            errors.append(f"excluded software lacks a reason: {software['id']}")
        if disposition == "explain":
            if software["id"] not in note_refs:
                errors.append(f"software lacks a body reference: {software['id']}")
            allowed_software_rights = {"cleared"} if strict else {"cleared", "restricted-internal"}
            if annotation.get("rights_status") not in allowed_software_rights or not annotation.get("license"):
                errors.append(f"software license is unresolved: {software['id']}")
            for field in ("purpose", "environment", "usage"):
                if not annotation.get(field):
                    errors.append(f"software {field} is missing: {software['id']}")
            if not retrieval.get("ok") or not software.get("resolved_revision"):
                errors.append(f"software is not pinned and fetched: {software['id']}")
            if retrieval.get("submodules_present") and not annotation.get("submodule_resolution"):
                errors.append(f"software submodules are unresolved: {software['id']}")
            if retrieval.get("lfs_review_required") and not annotation.get("lfs_resolution"):
                errors.append(f"software Git LFS status is unresolved: {software['id']}")
            linked_outputs = [
                rel for rel in relations
                if rel.get("to") == software["id"] and rel.get("kind") == "generated-by"
            ]
            if not linked_outputs and not annotation.get("no_output_reason"):
                errors.append(f"software has neither linked output nor no-output reason: {software['id']}")
            for relation in linked_outputs:
                output_id = relation.get("from")
                if output_id in registry.get("visuals", {}):
                    output_id = registry["visuals"][output_id].get("source_asset")
                if not any(
                    run.get("software") == software["id"] and output_id in run.get("outputs", [])
                    and run.get("status") == "success"
                    and run.get("software_revision") == software.get("resolved_revision")
                    for run in registry.get("runs", {}).values()
                ):
                    errors.append(f"software output lacks a successful run receipt: {relation.get('from')}")

    for run in registry.get("runs", {}).values():
        annotation = run.get("annotations", {})
        disposition = annotation.get("disposition", "pending")
        if strict and disposition == "pending":
            errors.append(f"run disposition is pending: {run.get('id')}")
        elif not strict and disposition == "pending":
            warnings.append(f"run disposition is pending: {run.get('id')}")
        if disposition == "exclude" and not annotation.get("exclusion_reason"):
            errors.append(f"excluded run lacks a reason: {run.get('id')}")
        dependency_lock = run.get("dependency_lock", "")
        lock_receipt = run.get("dependency_lock_receipt", {})
        if dependency_lock:
            try:
                lock_path = ensure_within(project / lock_receipt.get("path", ""), project)
                if not lock_path.is_file() or lock_path.is_symlink():
                    raise HarnessError("dependency lock is missing or unsafe")
                lock_snapshot = stable_file_snapshot(lock_path)
                expected_lock = f"{lock_receipt.get('path')}@sha256:{lock_receipt.get('sha256')}"
                if (
                    not lock_snapshot["stable"]
                    or lock_snapshot["size"] != lock_receipt.get("size")
                    or lock_snapshot["sha256"] != lock_receipt.get("sha256")
                    or dependency_lock != expected_lock
                ):
                    raise HarnessError("dependency lock receipt does not match current bytes")
            except (HarnessError, OSError, AttributeError, TypeError):
                errors.append(f"run dependency lock receipt is stale or unsafe: {run.get('id')}")
        elif lock_receipt:
            errors.append(f"run has an orphan dependency lock receipt: {run.get('id')}")
        for endpoint in (
            [run.get("software")] + run.get("inputs", []) + run.get("outputs", [])
            + run.get("output_visuals", [])
        ):
            if endpoint not in entries or entries[endpoint][1].get("state", "current") != "current":
                errors.append(f"run endpoint is missing or stale: {run.get('id')} -> {endpoint}")
        for visual_id in run.get("output_visuals", []):
            visual = registry.get("visuals", {}).get(visual_id, {})
            if visual.get("source_asset") not in run.get("outputs", []):
                errors.append(f"run output visual is not derived from a recorded output: {run.get('id')} -> {visual_id}")
        expected_run_edges = {
            (input_id, "input-to", run.get("id")) for input_id in run.get("inputs", [])
        }
        expected_run_edges.update({
            (output_id, "generated-by", run.get("id")) for output_id in run.get("outputs", [])
        })
        expected_run_edges.add((run.get("id"), "uses", run.get("software")))
        expected_run_edges.update({
            (visual_id, "generated-by", run.get("id"))
            for visual_id in run.get("output_visuals", [])
        })
        actual_run_edges = [
            (relation.get("from"), relation.get("kind"), relation.get("to"))
            for relation in relations
            if (
                relation.get("to") == run.get("id")
                and relation.get("kind") in {"input-to", "generated-by"}
            ) or (
                relation.get("from") == run.get("id")
                and relation.get("kind") == "uses"
                and entries.get(relation.get("to"), (None,))[0] == "software"
            )
        ]
        if set(actual_run_edges) != expected_run_edges or len(actual_run_edges) != len(expected_run_edges):
            errors.append(f"run lineage edges do not exactly match the immutable receipt: {run.get('id')}")
        if run.get("status") == "success":
            software = registry.get("software", {}).get(run.get("software"), {})
            if not run.get("software_revision") or run.get("software_revision") != software.get("resolved_revision"):
                errors.append(f"successful run is not bound to the current software revision: {run.get('id')}")
            for field in ("command", "environment", "seed"):
                if not run.get(field):
                    errors.append(f"successful run lacks {field}: {run.get('id')}")
            if run.get("outputs") and not (run.get("dependency_lock") or run.get("container_digest")):
                errors.append(f"successful output-producing run lacks an environment lock/digest: {run.get('id')}")
            if run.get("container_digest") and not re.fullmatch(r"sha256:[0-9a-fA-F]{64}", run["container_digest"]):
                errors.append(f"successful run has an invalid container digest: {run.get('id')}")
            if run.get("outputs") and not run.get("inputs") and not run.get("notes"):
                errors.append(f"successful output-producing run lacks inputs or a no-input explanation: {run.get('id')}")

    if strict:
        builds = registry.get("receipts", {}).get("builds", [])
        artifacts = artifact_specs(project, config)
        multiple_artifacts = len(artifacts) > 1
        selected_builds: dict[str, list[dict]] = {}
        status_pdfs: dict[str, tuple[pathlib.Path, str]] = {}
        for artifact_id, artifact in artifacts.items():
            suffix = f" for artifact {artifact_id}" if multiple_artifacts else ""
            artifact_source_fingerprint = artifact_scan_state(
                registry, artifact_id,
            ).get("source_fingerprint", "")
            expected_ids = artifact_evidence_ids(
                registry, artifact_id, artifact["evidence_scope"],
            )
            current_builds = [
                build for build in builds
                if build.get("catalog_fingerprint") == fingerprint
                and (
                    build.get("artifact_id") == artifact_id
                    or (
                        not multiple_artifacts
                        and artifact_id == "notes"
                        and not build.get("artifact_id")
                    )
                )
            ]
            valid_builds = []
            for build in current_builds:
                try:
                    fls = ensure_within(project / build.get("fls", ""), project)
                    pdf = ensure_within(project / build.get("pdf", ""), project)
                    valid = (
                        fls.is_file() and not fls.is_symlink()
                        and pdf.is_file() and not pdf.is_symlink()
                        and sha256_file(fls) == build.get("fls_sha256")
                        and sha256_file(pdf) == build.get("pdf_sha256")
                        and build.get("source_fingerprint") == artifact_source_fingerprint
                        and build.get("ingestion_fingerprint") == current_ingestion_fingerprint
                    )
                    if valid:
                        rendered_visuals, rendered_code = required_rendered_placements(
                            registry, artifact_id, expected_ids,
                        )
                        allowed_rendered_ids = (
                            artifact_allowed_rendered_ids(
                                registry, artifact_id, expected_ids,
                            )
                            if artifact["evidence_scope"] == "referenced" else None
                        )
                        pages, _ = validate_pdf_file(
                            pdf, expected_ids, rendered_visuals, rendered_code,
                            allowed_rendered_ids,
                        )
                        input_paths = fls_input_paths(
                            project,
                            fls.read_text(encoding="utf-8", errors="replace"),
                        )
                        validate_artifact_input_isolation(
                            project, config, artifact_id, input_paths,
                        )
                        expected_bindings = build_placement_bindings(
                            project, registry,
                            input_paths,
                            artifact_id,
                            expected_ids,
                        )
                        valid = (
                            pages == build.get("pdf_pages")
                            and sorted(expected_ids) == build.get("evidence_ids")
                            and expected_bindings == build.get(
                                "placement_bindings", {"visuals": {}, "code": {}}
                            )
                        )
                except (HarnessError, OSError):
                    valid = False
                if valid:
                    valid_builds.append(build)
                else:
                    warnings.append(
                        "current-catalog build receipt no longer matches its files"
                        f"{suffix}: {build.get('recorded_at')}"
                    )
            if not valid_builds:
                errors.append(f"no build receipt matches the current catalog{suffix}")
            elif promotion and not any(
                build.get("offline") is True for build in valid_builds
            ):
                errors.append(
                    f"promotion requires a current offline build receipt{suffix}"
                )
            fields = status_fields(project, config, artifact_id)
            if not fields:
                errors.append(f"draft STATUS is missing{suffix}")
                continue
            if multiple_artifacts and fields.get("evidence_artifact_id") != artifact_id:
                errors.append(f"draft STATUS evidence_artifact_id is missing or stale{suffix}")
            state = fields.get("state", "").lower()
            if not state or any(word in state for word in ("stale", "failed", "building")):
                errors.append(
                    f"draft STATUS does not describe a current readable result{suffix}"
                )
            if promotion and any(word in state for word in ("wip", "blocked")):
                errors.append(f"promotion STATUS still declares WIP or blocked work{suffix}")
            if promotion:
                for key in ("WIP_units", "blocked_units"):
                    value = fields.get(key, "").strip().lower()
                    if value and value not in {"0", "none", "なし", "[]"}:
                        errors.append(f"promotion STATUS has unresolved {key}{suffix}")
            expected_fields = {
                "evidence_catalog_fingerprint": fingerprint,
                "evidence_source_fingerprint": artifact_source_fingerprint,
                "evidence_ingestion_fingerprint": current_ingestion_fingerprint,
            }
            for key, expected in expected_fields.items():
                if not expected or fields.get(key) != expected:
                    errors.append(f"draft STATUS {key} is missing or stale{suffix}")
            try:
                draft_pdf = ensure_within(
                    project / "draft" / fields.get("evidence_pdf", ""),
                    project / "draft",
                )
                pdf_hash = (
                    sha256_file(draft_pdf)
                    if draft_pdf.is_file() and not draft_pdf.is_symlink() else ""
                )
                if not pdf_hash or pdf_hash != fields.get("evidence_pdf_sha256"):
                    errors.append(f"draft STATUS PDF/hash is missing or stale{suffix}")
                else:
                    matching_builds = [
                        build for build in valid_builds
                        if build.get("pdf_sha256") == pdf_hash
                    ]
                    if matching_builds:
                        selected_builds[artifact_id] = matching_builds
                        status_pdfs[artifact_id] = (draft_pdf, pdf_hash)
                    else:
                        errors.append(
                            f"draft STATUS PDF does not match a current build receipt{suffix}"
                        )
            except (HarnessError, OSError):
                errors.append(f"draft STATUS PDF path is invalid{suffix}")
        artifact_ids = sorted(artifacts)
        for index, artifact_id in enumerate(artifact_ids):
            for other_id in artifact_ids[index + 1:]:
                status_identity = status_pdfs.get(artifact_id)
                other_status_identity = status_pdfs.get(other_id)
                if (
                    status_identity is not None
                    and other_status_identity is not None
                    and (
                        status_identity[0] == other_status_identity[0]
                        or status_identity[1] == other_status_identity[1]
                    )
                ):
                    errors.append(
                        f"draft STATUS PDF is shared by artifacts: "
                        f"{artifact_id}, {other_id}"
                    )
                for build in selected_builds.get(artifact_id, []):
                    for other_build in selected_builds.get(other_id, []):
                        if (
                            build.get("fls") == other_build.get("fls")
                            or build.get("fls_sha256") == other_build.get("fls_sha256")
                        ):
                            errors.append(
                                f"build recorder file is shared by artifacts: "
                                f"{artifact_id}, {other_id}"
                            )
                        if (
                            build.get("pdf") == other_build.get("pdf")
                            or build.get("pdf_sha256") == other_build.get("pdf_sha256")
                        ):
                            errors.append(
                                f"build PDF is shared by artifacts: "
                                f"{artifact_id}, {other_id}"
                            )
    if promotion:
        for section in ("assets", "visuals", "resources", "software", "runs"):
            for entry in registry.get(section, {}).values():
                if entry.get("state") == "current" and entry.get("annotations", {}).get("disposition") == "pending":
                    errors.append(f"promotion has pending entry: {entry['id']}")
                if entry.get("state") == "current" and entry.get("annotations", {}).get("rights_status") == "restricted-internal":
                    errors.append(f"promotion contains restricted-internal material: {entry['id']}")
    return sorted(set(errors)), sorted(set(warnings))


def find_entry(registry: dict, entry_id: str) -> tuple[str, dict]:
    if not ENTRY_ID.fullmatch(entry_id):
        raise HarnessError("invalid entry ID")
    entries = all_entries(registry)
    if entry_id not in entries:
        raise HarnessError(f"entry does not exist: {entry_id}")
    return entries[entry_id]


def annotate_entry(registry: dict, args: argparse.Namespace) -> None:
    section, entry = find_entry(registry, args.entry_id)
    annotation = entry.setdefault("annotations", {})
    mapping = {
        "disposition": args.disposition, "title": args.title,
        "visibility": args.visibility,
        "privacy_review_status": args.privacy_review,
        "public_summary": args.public_summary,
        "description": args.description, "rights_status": args.rights_status,
        "license": args.license, "exclusion_reason": args.exclusion_reason,
        "origin": args.origin, "alt_text": args.alt_text, "creator": args.creator,
        "visual_review_status": args.visual_review,
        "link_review_status": args.link_review,
        "attachment_review_status": args.attachment_review,
        "archive_review_status": args.archive_review,
        "attachment_resolution": args.attachment_resolution,
        "purpose": args.purpose, "environment": args.environment,
        "usage": args.usage, "no_output_reason": args.no_output_reason,
        "submodule_resolution": args.submodule_resolution,
        "lfs_resolution": args.lfs_resolution,
    }
    for key, value in mapping.items():
        if value is not None:
            annotation[key] = value
    for category, resolutions in (
        ("attachment", args.resolve_attachment),
        ("archive_member", args.resolve_archive_member),
    ):
        field = f"{category}_resolutions"
        available: set[str]
        if category == "attachment":
            available = {
                item.get("name") if isinstance(item, dict) else str(item)
                for item in entry.get("pdf", {}).get("attachments", [])
            }
        else:
            available = {str(item.get("path", "")) for item in entry.get("archive", {}).get("members", [])}
        for name, status, adopted_asset, reason in resolutions:
            if section != "assets" or name not in available:
                raise HarnessError(f"unknown {category} locator for {args.entry_id}: {name}")
            if status not in {"adopted", "excluded", "deferred"} or not reason.strip():
                raise HarnessError(f"{category} resolution requires status and reason")
            adopted_id = "" if adopted_asset == "none" else adopted_asset
            if status == "adopted":
                adopted_section, adopted_entry = find_entry(registry, adopted_id)
                if (
                    adopted_section != "assets" or adopted_id == args.entry_id
                    or adopted_entry.get("state") != "current"
                    or adopted_entry.get("role") != "external-input"
                ):
                    raise HarnessError(f"adopted {category} must point to a distinct current inbox asset")
                relation = {"from": adopted_id, "kind": "supplements", "to": args.entry_id, "automatic": False}
                if relation not in registry["relations"]:
                    registry["relations"].append(relation)
            elif adopted_id:
                raise HarnessError(f"non-adopted {category} resolution must use asset ID 'none'")
            annotation.setdefault(field, {})[name] = {
                "status": status, "reason": reason.strip(), "adopted_asset": adopted_id,
                "resolved_at": now_utc(),
            }
    review_values = (args.visual_review, args.link_review, args.attachment_review, args.archive_review)
    if any(value == "complete" for value in review_values):
        if not args.reviewer and not annotation.get("reviewer"):
            raise HarnessError("completeness review requires --reviewer")
        annotation["reviewer"] = args.reviewer or annotation["reviewer"]
        annotation["reviewed_at"] = now_utc()
    if args.revision is not None:
        if section != "software":
            raise HarnessError("--revision applies only to software")
        if args.revision != entry.get("requested_revision", ""):
            entry["resolved_revision"] = ""
            entry["retrieval"] = {}
        entry["requested_revision"] = args.revision
        entry["revision_requires_review"] = not bool(args.revision)
        entry["revision_source"] = "manual"


def current_asset_path(project: pathlib.Path, asset: dict) -> tuple[pathlib.Path, dict]:
    for relative in asset.get("locations", []):
        try:
            path = ensure_within(project / relative, project)
            if not path.is_file() or path.is_symlink():
                continue
            snapshot = stable_file_snapshot(path)
        except (HarnessError, OSError):
            continue
        if (
            snapshot.get("stable")
            and snapshot.get("sha256") == asset.get("sha256")
            and snapshot.get("size") == asset.get("size")
        ):
            return path, snapshot
    raise HarnessError(f"visual review source asset is missing or stale: {asset.get('id')}")


def visual_review_target(registry: dict, target_id: str) -> tuple[str, dict, dict, str]:
    section, target = find_entry(registry, target_id)
    if section == "assets":
        asset = target
    elif section == "visuals":
        asset = registry.get("assets", {}).get(target.get("source_asset"), {})
        if not asset:
            raise HarnessError("visual review target has no current source asset")
    else:
        raise HarnessError("visual review targets must be asset or visual IDs")
    if target.get("state", "current") != "current" or asset.get("state", "current") != "current":
        raise HarnessError("visual review target or source asset is not current")
    target_view = {
        "target_id": target_id,
        "target_section": section,
        "source_asset": asset.get("id"),
        "source_sha256": asset.get("sha256"),
        "source_size": asset.get("size"),
        "source_media_type": asset.get("media_type"),
        "source_pdf_pages": asset.get("pdf", {}).get("pages"),
        "target_annotations": target.get("annotations", {}),
    }
    if section == "visuals":
        target_view.update({
            "visual_type": target.get("visual_type"),
            "locator": target.get("locator", {}),
            "caption_candidate": target.get("caption_candidate", ""),
            "candidate_basis": target.get("candidate_basis", ""),
        })
    relevant_ids = {target_id, str(asset.get("id", ""))}
    target_view["relations"] = sorted(
        (
            str(relation.get("from", "")), str(relation.get("kind", "")),
            str(relation.get("to", "")),
        )
        for relation in registry.get("relations", [])
        if relation.get("from") in relevant_ids or relation.get("to") in relevant_ids
    )
    referenced_paths = {
        reference.get("path") for reference in registry.get("note_references", [])
        if reference.get("id") in relevant_ids
    }
    target_view["note_source_files"] = sorted(
        (source.get("path"), source.get("sha256"))
        for source in registry.get("scan", {}).get("note_source_files", [])
        if source.get("path") in referenced_paths
    )
    return section, target, asset, json_fingerprint(target_view)


def imagemagick_review_policy(temp_root: pathlib.Path) -> tuple[str, str]:
    identify = shutil.which("identify")
    convert = shutil.which("convert")
    if not identify or not convert:
        raise HarnessError("ImageMagick identify and convert are required for raster/SVG visual review")
    environment = renderer_environment(temp_root)
    status_code, policy_text, policy_error = run_tool(
        [identify, "-list", "policy"], timeout=30, max_output_bytes=1024 * 1024,
        environment=environment,
    )
    if status_code != 0:
        raise HarnessError(f"ImageMagick policy could not be inspected: {policy_error.strip()[:200]}")
    policy_blocks = re.split(r"\n\s*Policy:\s*", policy_text)
    denied_delegates: set[str] = set()
    path_indirection_denied = False
    for block in policy_blocks:
        if re.search(r"^Delegate\s*$", block, re.MULTILINE) and re.search(r"rights:\s*None", block, re.IGNORECASE):
            pattern = re.search(r"pattern:\s*(\S+)", block)
            if pattern:
                denied_delegates.add(pattern.group(1).upper())
        if re.search(r"^Path\s*$", block, re.MULTILINE) and re.search(r"rights:\s*None", block, re.IGNORECASE):
            if re.search(r"pattern:\s*@\*", block):
                path_indirection_denied = True
    if not {"URL", "HTTP", "HTTPS"} <= denied_delegates or not path_indirection_denied:
        raise HarnessError("ImageMagick policy must deny URL/HTTP/HTTPS delegates and @ path indirection")
    status_code, version_out, version_error = run_tool(
        [identify, "-version"], timeout=30, max_output_bytes=65536,
        environment=environment,
    )
    if status_code != 0:
        raise HarnessError(f"ImageMagick version could not be recorded: {version_error.strip()[:200]}")
    version = version_out.splitlines()[0].strip()
    return version, json_fingerprint(policy_text)


def preparation_receipt_fingerprint(receipt: dict) -> str:
    view = json.loads(json.dumps(receipt))
    view.pop("receipt_fingerprint", None)
    return json_fingerprint(view)


def validate_visual_review_preparation(
    project: pathlib.Path, registry: dict, target_id: str, receipt: dict,
) -> list[str]:
    errors: list[str] = []
    try:
        _, _, asset, current_input = visual_review_target(registry, target_id)
    except HarnessError as exc:
        return [str(exc)]
    preparation_id = receipt.get("id", "")
    if not preparation_id or receipt.get("target_id") != target_id:
        errors.append(f"visual review preparation identity is invalid: {target_id}")
    if receipt.get("input_fingerprint") != current_input:
        errors.append(f"visual review preparation is stale for current input: {target_id}")
    if receipt.get("receipt_fingerprint") != preparation_receipt_fingerprint(receipt):
        errors.append(f"visual review preparation receipt fingerprint is invalid: {target_id}")
    expected_root = managed_paths(project)["visual_reviews"] / target_id / preparation_id
    expected_count = receipt.get("expected_frame_count")
    source_count = receipt.get("source_frame_count")
    outputs = receipt.get("outputs", [])
    if (
        not isinstance(expected_count, int) or expected_count < 1
        or not isinstance(source_count, int) or source_count < expected_count
        or not isinstance(outputs, list) or len(outputs) != expected_count
    ):
        errors.append(f"visual review frame count is incomplete: {target_id}")
        outputs = outputs if isinstance(outputs, list) else []
    if receipt.get("source_snapshot_sha256") != asset.get("sha256"):
        errors.append(f"visual review source snapshot identity is invalid: {target_id}")
    output_names: list[str] = []
    output_indices: list[int] = []
    for output in outputs:
        try:
            path = project / output.get("path", "")
            if lexical_relative_path(path.parent, project) != lexical_relative_path(expected_root / "frames", project):
                raise HarnessError("review frame is outside the exact frame directory")
            name_match = re.fullmatch(r"frame-(\d+)\.png", path.name)
            if not name_match:
                raise HarnessError("review frame name is invalid")
            snapshot = stable_managed_file_snapshot(project, path, expected_root)
            if not snapshot.get("stable") or sniff_type(path, snapshot.get("head")) != "image/png":
                raise HarnessError("review frame is missing, unsafe, or not PNG")
            if (
                snapshot.get("sha256") != output.get("sha256")
                or snapshot.get("size") != output.get("size")
            ):
                raise HarnessError("review frame bytes do not match receipt")
            if not isinstance(output.get("width"), int) or output["width"] < 1:
                raise HarnessError("review frame width is invalid")
            if not isinstance(output.get("height"), int) or output["height"] < 1:
                raise HarnessError("review frame height is invalid")
            output_names.append(path.name)
            output_indices.append(int(name_match.group(1)))
        except (HarnessError, OSError, AttributeError, TypeError) as exc:
            errors.append(f"visual review output is stale or unsafe: {target_id}: {exc}")
    if not outputs:
        errors.append(f"visual review preparation has no rendered frames: {target_id}")
    if output_indices and output_indices != list(range(output_indices[0], output_indices[0] + len(output_indices))):
        errors.append(f"visual review frame sequence is incomplete: {target_id}")
    try:
        with managed_directory_fd(project, expected_root / "frames") as frames_fd:
            actual_names = sorted(os.listdir(frames_fd))
        if actual_names != sorted(output_names):
            raise HarnessError("frame directory does not exactly match the receipt")
    except (HarnessError, OSError) as exc:
        errors.append(f"visual review frame directory is stale or unsafe: {target_id}: {exc}")
    try:
        manifest_path = project / receipt.get("manifest_path", "")
        if lexical_relative_path(manifest_path.parent, project) != lexical_relative_path(expected_root, project):
            raise HarnessError("review manifest is outside the exact preparation directory")
        manifest_snapshot = stable_managed_file_snapshot(project, manifest_path, expected_root)
        if (
            not manifest_snapshot.get("stable")
            or manifest_snapshot.get("sha256") != receipt.get("manifest_sha256")
            or manifest_snapshot.get("size") != receipt.get("manifest_size")
        ):
            raise HarnessError("review manifest bytes do not match receipt")
    except (HarnessError, OSError, AttributeError, TypeError):
        errors.append(f"visual review manifest is stale or unsafe: {target_id}")
    return errors


def render_visual_review_source(
    project: pathlib.Path, source_path: pathlib.Path, source_snapshot: dict,
    max_input_bytes: int, section: str, target: dict, asset: dict, media_type: str,
    dpi: int, max_dimension: int, max_frames: int, max_bytes: int,
    frame_root: pathlib.Path, decoder_temp: pathlib.Path,
) -> tuple[str, str, list[str], int, int]:
    """Render exactly one immutable, hash-verified source revision."""
    decoder_version = ""
    decoder_policy_fingerprint = ""
    normalized_command: list[str] = []
    with immutable_decoder_snapshot(
        project, source_path, source_snapshot, max_input_bytes,
    ) as (decoder_source, decoder_source_fd):
        if media_type == "application/pdf":
            mutool = shutil.which("mutool")
            if not mutool:
                raise HarnessError("mutool is required for PDF visual review")
            status_code, version_out, version_error = run_tool(
                [mutool, "-v"], timeout=30, max_output_bytes=65536,
                environment=renderer_environment(decoder_temp),
            )
            if status_code != 0:
                raise HarnessError(f"MuPDF version could not be recorded: {version_error.strip()[:200]}")
            decoder_version = (version_out or version_error).splitlines()[0].strip()
            pages_status, pages_out, pages_error = run_tool(
                [mutool, "pages", str(decoder_source)], timeout=120,
                max_output_bytes=min(1024 * 1024, max_frames * 128 + 4096),
                environment=renderer_environment(decoder_temp),
                pass_fds=(decoder_source_fd,),
            )
            if pages_status != 0:
                raise HarnessError(f"MuPDF page inventory failed: {pages_error.strip()[:200]}")
            page_numbers = [int(value) for value in re.findall(r'<page\s+pagenum="(\d+)"', pages_out)]
            source_frame_count = len(page_numbers)
            if page_numbers != list(range(1, source_frame_count + 1)):
                raise HarnessError("MuPDF page inventory is incomplete")
            if source_frame_count != int(asset.get("pdf", {}).get("pages") or 0):
                raise HarnessError("PDF page inventory does not match the scanned source metadata")
            locator_page = target.get("locator", {}).get("page") if section == "visuals" else None
            if locator_page is not None and (
                not isinstance(locator_page, int) or not 1 <= locator_page <= source_frame_count
            ):
                raise HarnessError("PDF visual review page locator is outside the source")
            expected_frame_count = 1 if locator_page else source_frame_count
            if source_frame_count < 1 or not 1 <= expected_frame_count <= max_frames:
                raise HarnessError("PDF visual review page count exceeds the configured frame limit")
            page_spec = str(locator_page) if locator_page else f"1-{source_frame_count}"
            output_pattern = frame_root / "frame-%04d.png"
            command = [
                mutool, "draw", "-q", "-r", str(dpi), "-w", str(max_dimension),
                "-h", str(max_dimension), "-o", str(output_pattern), str(decoder_source), page_spec,
            ]
            normalized_command = [
                "mutool", "draw", "-q", "-r", str(dpi), "-w", str(max_dimension),
                "-h", str(max_dimension), "-o", "{FRAME_PATTERN}", "{IMMUTABLE_SOURCE}", page_spec,
            ]
        else:
            decoder_version, decoder_policy_fingerprint = imagemagick_review_policy(decoder_temp)
            identify = shutil.which("identify")
            convert = shutil.which("convert")
            if not identify or not convert:
                raise HarnessError("ImageMagick identify and convert are required for visual review")
            input_coder = "SVG" if media_type == "image/svg+xml" else RASTER_CODERS[media_type]
            status_code, frame_metadata, frame_error = run_tool(
                [
                    identify, "-regard-warnings", "-format", "%p\t%n\n",
                    f"{input_coder}:{decoder_source}",
                ],
                timeout=300, max_output_bytes=min(1024 * 1024, max_frames * 64 + 1024),
                environment=renderer_environment(decoder_temp),
                pass_fds=(decoder_source_fd,),
            )
            if status_code != 0:
                raise HarnessError(f"visual review source frame inventory failed: {frame_error.strip()[:300]}")
            frame_inventory: list[tuple[int, int]] = []
            for line in frame_metadata.splitlines():
                match = re.fullmatch(r"(\d+)\t(\d+)", line.strip())
                if not match:
                    raise HarnessError("visual review source frame inventory is malformed")
                frame_inventory.append((int(match.group(1)), int(match.group(2))))
            source_frame_count = len(frame_inventory)
            if not 1 <= source_frame_count <= max_frames:
                raise HarnessError("visual review source frame count exceeds the configured limit")
            if (
                [index for index, _ in frame_inventory] != list(range(source_frame_count))
                or any(total != source_frame_count for _, total in frame_inventory)
            ):
                raise HarnessError("visual review source frame inventory is incomplete")
            expected_frame_count = source_frame_count
            output_pattern = frame_root / "frame-%04d.png"
            command = [convert, "-regard-warnings"]
            if media_type == "image/svg+xml":
                command.extend(["-density", str(dpi)])
            command.extend([
                f"{input_coder}:{decoder_source}", "-coalesce", "-auto-orient",
                "-thumbnail", f"{max_dimension}x{max_dimension}>", "-strip",
                f"PNG:{output_pattern}",
            ])
            normalized_command = [
                "convert", "-regard-warnings",
                *(["-density", str(dpi)] if media_type == "image/svg+xml" else []),
                f"{input_coder}:{{IMMUTABLE_SOURCE}}", "-coalesce", "-auto-orient",
                "-thumbnail", f"{max_dimension}x{max_dimension}>", "-strip",
                "PNG:{FRAME_PATTERN}",
            ]
        result = run_bounded_renderer(
            command, frame_root, decoder_temp, max_frames, max_bytes,
            pass_fds=(decoder_source_fd,),
        )
        if result.returncode != 0:
            raise HarnessError(f"visual review decode/render failed: {result.stderr.strip()[:300]}")
    return (
        decoder_version, decoder_policy_fingerprint, normalized_command,
        source_frame_count, expected_frame_count,
    )


def prepare_visual_review(
    project: pathlib.Path, config: dict, registry: dict, args: argparse.Namespace,
) -> None:
    section, target, asset, input_fingerprint = visual_review_target(registry, args.target_id)
    source_path, source_snapshot = current_asset_path(project, asset)
    media_type = asset.get("media_type", "")
    if asset.get("media_type_mismatch") or media_type not in set(RASTER_CODERS) | {"image/svg+xml", "application/pdf"}:
        raise HarnessError("visual review source format is unsupported or has not passed format validation")
    review_config = config.get("visual_review", {})
    dpi = args.dpi or int(review_config.get("default_dpi", 144))
    max_dimension = args.max_dimension or int(review_config.get("default_max_dimension", 4096))
    max_frames = int(review_config.get("max_rendered_frames", 200))
    max_bytes = int(review_config.get("max_rendered_bytes", 536870912))
    max_input_bytes = int(config.get("parsing", {}).get("max_snapshot_bytes", 536870912))
    if not 72 <= dpi <= 600 or not 512 <= max_dimension <= 16384:
        raise HarnessError("visual review dpi/max-dimension is outside the accepted range")
    if not 1 <= max_frames <= 1000 or not 16 * 1024 * 1024 <= max_bytes <= 4 * 1024 * 1024 * 1024:
        raise HarnessError("visual review config limits are invalid")
    if not 1 <= max_input_bytes <= 4 * 1024 * 1024 * 1024:
        raise HarnessError("visual review input snapshot limit is invalid")

    review_root = secure_directory(managed_paths(project)["visual_reviews"], project)
    temp_root = secure_directory(managed_paths(project)["visual_review_tmp"], project)
    target_root = secure_directory(review_root / args.target_id, project)
    preparation_id = short_id(
        "PREP", f"{args.target_id}:{input_fingerprint}:{dpi}:{max_dimension}:{time.time_ns()}",
    )
    final_root = target_root / preparation_id
    if final_root.exists():
        raise HarnessError("visual review preparation ID collision")
    working_root = pathlib.Path(tempfile.mkdtemp(prefix=f".{preparation_id}.", dir=temp_root))
    frame_root = working_root / "frames"
    decoder_temp = working_root / "tmp"
    frame_root.mkdir(mode=0o700)
    decoder_temp.mkdir(mode=0o700)
    try:
        (
            decoder_version, decoder_policy_fingerprint, normalized_command,
            source_frame_count, expected_frame_count,
        ) = render_visual_review_source(
            project, source_path, source_snapshot, max_input_bytes, section, target, asset,
            media_type, dpi, max_dimension, max_frames, max_bytes, frame_root, decoder_temp,
        )
        frame_paths = sorted(frame_root.glob("frame-*.png"))
        if len(frame_paths) != expected_frame_count:
            raise HarnessError("visual review renderer did not produce the exact expected frame count")
        outputs: list[dict] = []
        identify = shutil.which("identify")
        if not identify:
            raise HarnessError("ImageMagick identify is required to validate review frames")
        for frame_path in frame_paths:
            snapshot = stable_file_snapshot(frame_path)
            if not snapshot.get("stable") or sniff_type(frame_path, snapshot.get("head")) != "image/png":
                raise HarnessError("visual review renderer produced an invalid PNG frame")
            status_code, metadata, metadata_error = run_tool(
                [identify, "-regard-warnings", "-format", "%m\t%w\t%h\t%[channels]", f"PNG:{frame_path}"],
                timeout=120, max_output_bytes=65536,
                environment=renderer_environment(decoder_temp),
            )
            if status_code != 0:
                raise HarnessError(f"rendered review frame could not be decoded: {metadata_error.strip()[:200]}")
            fields = metadata.strip().split("\t")
            if len(fields) != 4 or fields[0] != "PNG":
                raise HarnessError("rendered review frame metadata is malformed")
            outputs.append({
                "path": (final_root / "frames" / frame_path.name).relative_to(project).as_posix(),
                "size": snapshot["size"], "sha256": snapshot["sha256"],
                "width": int(fields[1]), "height": int(fields[2]), "channels": fields[3],
            })
        manifest_lines = [
            "# Codex visual review package", "",
            f"- preparation_id: `{preparation_id}`",
            f"- target_id: `{args.target_id}`",
            f"- target_section: `{section}`",
            f"- source_asset: `{asset.get('id')}`",
            f"- input_fingerprint: `{input_fingerprint}`",
            f"- decoder: `{decoder_version}`",
            f"- source_frame_count: {source_frame_count}",
            f"- expected_frame_count: {expected_frame_count}",
            f"- rendered_frame_count: {len(outputs)}", "",
            "## Frames", "",
        ]
        for output in outputs:
            manifest_lines.append(
                f"- `{output['path']}` — {output['width']}x{output['height']}, sha256 `{output['sha256']}`"
            )
        manifest_lines.extend([
            "", "## Required review", "",
            "Inspect every frame at useful zoom. Record every checklist item, limitations, and any open finding.",
            "A different reviewer must record the independent receipt against this same preparation.", "",
        ])
        manifest_path = working_root / "REVIEW.md"
        atomic_write(manifest_path, "\n".join(manifest_lines))
        manifest_snapshot = stable_file_snapshot(manifest_path)
        publish_managed_directory(project, working_root, target_root, preparation_id)
        receipt = {
            "id": preparation_id, "target_id": args.target_id,
            "target_section": section, "source_asset": asset.get("id"),
            "input_fingerprint": input_fingerprint,
            "source_snapshot_sha256": source_snapshot.get("sha256"),
            "source_frame_count": source_frame_count,
            "expected_frame_count": expected_frame_count,
            "prepared_at": now_utc(), "decoder_version": decoder_version,
            "decoder_policy_fingerprint": decoder_policy_fingerprint,
            "normalized_command": normalized_command,
            "dpi": dpi, "max_dimension": max_dimension,
            "outputs": outputs,
            "manifest_path": (final_root / "REVIEW.md").relative_to(project).as_posix(),
            "manifest_size": manifest_snapshot["size"],
            "manifest_sha256": manifest_snapshot["sha256"],
            "execution_policy": "bounded local decode/render only; no Codex semantic verdict was inferred",
        }
        receipt["receipt_fingerprint"] = preparation_receipt_fingerprint(receipt)
        target.setdefault("visual_review_preparations", {})[preparation_id] = receipt
        target["active_visual_review_preparation"] = preparation_id
        preparation_errors = validate_visual_review_preparation(
            project, registry, args.target_id, receipt,
        )
        if preparation_errors:
            raise HarnessError(preparation_errors[0])
    except BaseException:
        if working_root.exists():
            shutil.rmtree(working_root)
        raise
    print(preparation_id)
    print(receipt["manifest_path"])


def record_visual_review(registry: dict, project: pathlib.Path, args: argparse.Namespace) -> None:
    if not ENTRY_ID.fullmatch(args.review_id) or not args.review_id.startswith("VREV-"):
        raise HarnessError("visual review ID must match VREV-[A-Z0-9-]+")
    for section in ("assets", "visuals"):
        if any(args.review_id in entry.get("visual_reviews", {}) for entry in registry.get(section, {}).values()):
            raise HarnessError("visual review IDs are immutable and globally unique")
    _, target, _, input_fingerprint = visual_review_target(registry, args.target_id)
    preparation_id = target.get("active_visual_review_preparation", "")
    preparation = target.get("visual_review_preparations", {}).get(preparation_id, {})
    preparation_errors = validate_visual_review_preparation(project, registry, args.target_id, preparation)
    if preparation_errors:
        raise HarnessError(preparation_errors[0])
    reviewer = args.reviewer.strip()
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:@/-]{2,127}", reviewer):
        raise HarnessError("visual reviewer identity contains unsupported characters")
    checks: dict[str, str] = {}
    for key, status in args.check:
        if key not in VISUAL_REVIEW_CHECKS or status not in VISUAL_REVIEW_STATUSES:
            raise HarnessError(f"unknown visual review checklist value: {key}={status}")
        if key in checks:
            raise HarnessError(f"duplicate visual review checklist item: {key}")
        checks[key] = status
    if set(checks) != set(VISUAL_REVIEW_CHECKS):
        missing = sorted(set(VISUAL_REVIEW_CHECKS) - set(checks))
        raise HarnessError(f"visual review checklist is incomplete: {', '.join(missing)}")
    findings = [finding.strip() for finding in args.finding if finding.strip()]
    if args.verdict == "pass" and (findings or "blocked" in checks.values()):
        raise HarnessError("passing visual reviews cannot contain open findings or blocked checks")
    if args.verdict == "pass" and any(
        checks.get(key) != "complete" for key in VISUAL_REVIEW_ALWAYS_REQUIRED
    ):
        raise HarnessError(
            "passing visual reviews require complete decode, crop/presence, and source completeness checks"
        )
    if args.verdict != "pass" and not findings:
        raise HarnessError("non-passing visual reviews require at least one finding")
    independent_of = args.independent_of or ""
    if args.role == "primary" and independent_of:
        raise HarnessError("primary visual reviews cannot use --independent-of")
    if args.role == "independent":
        if not independent_of:
            raise HarnessError("independent visual reviews require --independent-of")
        primary = target.get("visual_reviews", {}).get(independent_of, {})
        if (
            primary.get("role") != "primary" or primary.get("verdict") != "pass"
            or primary.get("preparation_id") != preparation_id
            or primary.get("preparation_fingerprint") != preparation.get("receipt_fingerprint")
        ):
            raise HarnessError("independent visual review does not reference a current passing primary review")
        if primary.get("reviewer") == reviewer:
            raise HarnessError("independent visual review must use a different reviewer identity")
    review = {
        "id": args.review_id, "target_id": args.target_id,
        "preparation_id": preparation_id,
        "preparation_fingerprint": preparation.get("receipt_fingerprint"),
        "input_fingerprint": input_fingerprint,
        "role": args.role, "reviewer": reviewer, "reviewer_kind": args.reviewer_kind,
        "independent_of": independent_of, "reviewed_at": now_utc(),
        "verdict": args.verdict, "checks": checks,
        "summary": args.summary.strip(), "limitations": args.limitations.strip(),
        "findings": findings,
    }
    if not review["summary"] or not review["limitations"]:
        raise HarnessError("visual review summary and limitations are required")
    review["receipt_fingerprint"] = json_fingerprint(review)
    target.setdefault("visual_reviews", {})[args.review_id] = review


def add_visual(registry: dict, args: argparse.Namespace) -> None:
    if not ENTRY_ID.fullmatch(args.visual_id) or not args.visual_id.startswith("VIS-"):
        raise HarnessError("manual visual ID must match VIS-[A-Z0-9-]+")
    if args.visual_id in all_entries(registry):
        raise HarnessError("entry ID already exists")
    source_section, _ = find_entry(registry, args.source_asset)
    if source_section != "assets":
        raise HarnessError("manual visual source must be an asset")
    annotation = merge_annotation(None, "source-visual")
    annotation["origin"] = args.origin
    annotation["title"] = args.caption
    registry["visuals"][args.visual_id] = {
        "id": args.visual_id, "state": "current", "source_asset": args.source_asset,
        "visual_type": args.visual_type,
        "locator": {"page": args.page, "label": args.label},
        "caption_candidate": args.caption, "candidate_basis": "manual",
