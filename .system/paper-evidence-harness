def artifact_specs(project: pathlib.Path, config: dict) -> dict[str, dict]:
    artifact_set = config.get("artifact_set", "notes")
    if artifact_set not in ARTIFACT_SETS:
        raise HarnessError("unsupported artifact set")
    expected_artifacts = default_artifacts(artifact_set)
    raw_artifacts = config.get("artifacts")
    if raw_artifacts is None:
        raw_artifacts = default_artifacts("notes")
    if not isinstance(raw_artifacts, dict) or not raw_artifacts:
        raise HarnessError("artifact configuration must be a non-empty object")
    expected_ids = {"notes"} if artifact_set == "notes" else {"notes", "slides"}
    if set(raw_artifacts) != expected_ids:
        raise HarnessError("artifact configuration does not match artifact_set")

    source_parent = ensure_within(project / ".workspace" / "source", project)
    draft_parent = ensure_within(project / "draft", project)
    normalized: dict[str, dict] = {}
    source_paths: list[pathlib.Path] = []
    status_paths: set[pathlib.Path] = set()
    for artifact_id, raw_spec in sorted(raw_artifacts.items()):
        if not ARTIFACT_ID.fullmatch(artifact_id) or not isinstance(raw_spec, dict):
            raise HarnessError("artifact configuration contains an invalid artifact ID")
        if raw_spec != expected_artifacts[artifact_id]:
            raise HarnessError(
                f"artifact configuration does not match the fixed profile: {artifact_id}"
            )
        kind = raw_spec.get("kind")
        evidence_scope = raw_spec.get("evidence_scope")
        requires_index = raw_spec.get("requires_evidence_index")
        if kind not in ARTIFACT_KINDS:
            raise HarnessError(f"artifact kind is invalid: {artifact_id}")
        if evidence_scope not in EVIDENCE_SCOPES:
            raise HarnessError(f"artifact evidence scope is invalid: {artifact_id}")
        if not isinstance(requires_index, bool):
            raise HarnessError(f"artifact index requirement is invalid: {artifact_id}")
        source_value = raw_spec.get("source_root")
        status_value = raw_spec.get("status")
        if not isinstance(source_value, str) or not isinstance(status_value, str):
            raise HarnessError(f"artifact paths are invalid: {artifact_id}")
        for value in (source_value, status_value):
            pure = pathlib.PurePosixPath(value)
            if pure.is_absolute() or ".." in pure.parts:
                raise HarnessError(f"artifact path is unsafe: {artifact_id}")
        source_path = ensure_within(project / source_value, source_parent)
        status_path = ensure_within(project / status_value, draft_parent)
        if status_path.parent != draft_parent or status_path in status_paths:
            raise HarnessError(f"artifact STATUS path is invalid or duplicated: {artifact_id}")
        status_paths.add(status_path)
        source_paths.append(source_path)
        normalized[artifact_id] = {
            "kind": kind,
            "source_root": source_path.relative_to(project).as_posix(),
            "status": status_path.relative_to(project).as_posix(),
            "evidence_scope": evidence_scope,
            "requires_evidence_index": requires_index,
        }
    for index, source_path in enumerate(source_paths):
        for other in source_paths[index + 1:]:
            if source_path == other or source_path in other.parents or other in source_path.parents:
                raise HarnessError("artifact source roots overlap")
    return normalized


