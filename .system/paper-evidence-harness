def main() -> int:
    args = build_parser().parse_args()
    try:
        project = project_path(args.project)
        with project_lock(project):
            config, registry = initialize(
                project,
                args.artifact_set if args.command == "init" else None,
            )
            paths = managed_paths(project)
            if paths["transaction"].exists() and args.command not in {"scan", "gate", "status"}:
                raise HarnessError("interrupted catalog transaction detected; run scan to recover")
            if args.command == "init":
                begin_catalog_transaction(paths, args.command, registry)
                commit_catalog_transaction(project, paths, registry)
                print("paper-evidence-harness: init ok")
                return 0
            if args.command == "scan":
                registry = discover(project, config, registry)
                begin_catalog_transaction(paths, args.command, registry)
                commit_catalog_transaction(project, paths, registry)
                print("paper-evidence-harness: scan ok")
                print(status_summary(registry))
                return 0
            if args.command == "status":
                print(status_summary(registry))
                return 0
            if args.command == "render-index":
                begin_catalog_transaction(paths, args.command, registry)
                commit_catalog_transaction(project, paths, registry)
                print("paper-evidence-harness: render-index ok")
                return 0
            pending_ingestion_manifest = None
            if args.command == "annotate":
                annotate_entry(registry, args)
            elif args.command == "prepare-visual-review":
                prepare_visual_review(project, config, registry, args)
            elif args.command == "record-visual-review":
                record_visual_review(registry, project, args)
            elif args.command == "add-visual":
                add_visual(registry, args)
            elif args.command == "relate":
                add_relation(registry, args)
            elif args.command == "add-resource":
                add_resource(registry, args)
            elif args.command == "record-ingestion":
                pending_ingestion_manifest = record_ingestion(project, config, registry, args)
            elif args.command == "add-software":
                add_software(registry, args)
            elif args.command == "verify-links":
                for entry_id in args.ids:
                    section, entry = find_entry(registry, entry_id)
                    if section != "resources":
                        raise HarnessError(f"not a resource ID: {entry_id}")
                    verify_resource(entry)
                    entry.setdefault("annotations", {})["link_review_status"] = "complete"
            elif args.command == "fetch-resource":
                section, entry = find_entry(registry, args.entry_id)
                if section != "resources":
                    raise HarnessError("fetch-resource requires a resource ID")
                fetch_resource(project, entry, args.max_bytes)
            elif args.command == "fetch-software":
                section, entry = find_entry(registry, args.entry_id)
                if section != "software":
                    raise HarnessError("fetch-software requires a software ID")
                fetch_software(project, registry, entry, args.revision)
            elif args.command == "record-run":
                record_run(project, registry, args)
            elif args.command == "record-build":
                record_build(project, config, registry, args)
            elif args.command == "gate":
                fresh = discover(project, config, registry)
                stored_discovery = registry.get("scan", {}).get("discovery_fingerprint")
                current_discovery = fresh.get("scan", {}).get("discovery_fingerprint")
                errors, warnings = inspect_gate(project, config, registry, args.phase)
                if not stored_discovery or stored_discovery != current_discovery:
                    errors.append("discovery inputs changed after the last scan; run scan again")
                    errors = sorted(set(errors))
                audit = {
                    "checked_at": now_utc(), "phase": args.phase,
                    "catalog_fingerprint": catalog_fingerprint(registry),
                    "errors": errors, "warnings": warnings,
                    "result": "fail" if errors else "pass",
                }
                write_json(paths["audit"], audit)
                for warning in warnings:
                    print(f"WARNING: {warning}", file=sys.stderr)
                for error in errors:
                    print(f"ERROR: {error}", file=sys.stderr)
                if errors:
                    print(f"paper-evidence-harness: gate {args.phase} failed ({len(errors)} errors)", file=sys.stderr)
                    return 1
                print(f"paper-evidence-harness: gate {args.phase} ok")
                return 0
            else:
                raise HarnessError("unsupported command")
            begin_catalog_transaction(paths, args.command, registry)
            if pending_ingestion_manifest is not None:
                write_json(paths["ingestion"], pending_ingestion_manifest)
            commit_catalog_transaction(project, paths, registry)
            print(f"paper-evidence-harness: {args.command} ok")
            return 0
    except HarnessError as exc:
        fail(str(exc))
    return 1


