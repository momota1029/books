def reject_symlink_chain(path: pathlib.Path, stop: pathlib.Path) -> None:
    current = path
    while True:
        if current.is_symlink():
            raise HarnessError(f"managed path is a symlink: {current}")
        if current == stop:
            return
        if stop not in current.parents:
            raise HarnessError("managed path escapes project")
        current = current.parent


def secure_directory(path: pathlib.Path, project: pathlib.Path) -> pathlib.Path:
    """Create/check a private managed directory without accepting symlink ancestors."""
    ensure_within(path, project)
    reject_symlink_chain(path.parent, project)
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    reject_symlink_chain(path, project)
    if not path.is_dir():
        raise HarnessError(f"managed directory is invalid: {path}")
    return path


@contextlib.contextmanager
def project_lock(project: pathlib.Path):
    paths = managed_paths(project)
    lock_path = paths["lock"]
    secure_directory(lock_path.parent, project)
    if lock_path.exists() and lock_path.is_symlink():
        raise HarnessError("lock path is a symlink")
    with lock_path.open("a+", encoding="utf-8") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        yield


def atomic_write(path: pathlib.Path, data: str) -> None:
    root = repo_root()
    if ".workspace" in path.parts:
        workspace_index = path.parts.index(".workspace")
        root = pathlib.Path(*path.parts[:workspace_index])
    secure_directory(path.parent, root)
    if path.exists() and path.is_symlink():
        raise HarnessError(f"refusing to replace symlink: {path}")
    fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temp = pathlib.Path(temp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp, path)
    finally:
        temp.unlink(missing_ok=True)


def write_json(path: pathlib.Path, value: object) -> None:
    atomic_write(path, json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n")


def read_json(path: pathlib.Path) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise HarnessError(f"JSON could not be read: {path}") from exc
    if not isinstance(value, dict):
        raise HarnessError(f"JSON root must be an object: {path}")
    return value


