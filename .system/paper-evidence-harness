    }


def add_relation(registry: dict, args: argparse.Namespace) -> None:
    entries = all_entries(registry)
    if args.from_id not in entries or args.to_id not in entries:
        raise HarnessError("relation endpoint does not exist")
    relation = {"from": args.from_id, "kind": args.kind, "to": args.to_id, "automatic": False}
    relation_error = relation_type_error(relation, entries)
    if relation_error:
        raise HarnessError(relation_error)
    protected_run_lineage = (
        args.to_id in registry.get("runs", {}) and args.kind in {"input-to", "generated-by"}
    ) or (
        args.from_id in registry.get("runs", {}) and args.kind == "uses"
        and entries[args.to_id][0] == "software"
    )
    if protected_run_lineage:
        raise HarnessError("run execution lineage is immutable and can only be created by record-run")
    if relation not in registry["relations"]:
        registry["relations"].append(relation)
    cycle = relation_cycle(registry)
    if cycle:
        registry["relations"].remove(relation)
        raise HarnessError(f"relation would create a cycle: {' -> '.join(cycle)}")


def add_resource(registry: dict, args: argparse.Namespace) -> None:
    canonical, secret = redact_and_canonicalize_url(args.url)
    if not canonical:
        raise HarnessError("resource URL is invalid")
    if args.discovered_from:
        find_entry(registry, args.discovered_from)
    resource_id = short_id("RES", canonical)
    old = registry["resources"].get(resource_id, {})
    registry["resources"][resource_id] = {
        "id": resource_id, "state": "current", "manual": True,
        "canonical_url": canonical, "secret_query_redacted": secret,
        "kind": args.kind or resource_kind(canonical),
        "discovered_in": sorted(set(old.get("discovered_in", []) + ([args.discovered_from] if args.discovered_from else ["manual-review"]))),
        "annotations": merge_annotation(old.get("annotations"), "external-resource"),
        "verification": old.get("verification", {}), "retrieval": old.get("retrieval", {}),
    }
    print(resource_id)


def add_software(registry: dict, args: argparse.Namespace) -> None:
    if not ENTRY_ID.fullmatch(args.software_id) or not args.software_id.startswith("SW-"):
        raise HarnessError("software ID must match SW-[A-Z0-9-]+")
    if args.software_id in all_entries(registry):
        raise HarnessError("entry ID already exists")
    if bool(args.repository_url) == bool(args.artifact_resource):
        raise HarnessError("choose exactly one repository URL or artifact resource")
    annotation = default_annotation("software")
    annotation.update({
        "title": args.name, "purpose": "", "environment": "",
        "usage": "", "no_output_reason": "",
    })
    entry = {
        "id": args.software_id, "state": "current", "manual": True,
        "annotations": annotation,
        "requested_revision": args.revision, "revision_source": "manual",
        "revision_candidates": [], "revision_requires_review": False,
        "revision_conflict": False,
        "resolved_revision": "", "retrieval": {},
        "discovered_from": [],
    }
    if args.repository_url:
        canonical = validate_network_url(args.repository_url, git_host_only=True)
        parsed = urllib.parse.urlsplit(canonical)
        if (parsed.hostname or "").lower() == "github.com":
            repository = github_repository(canonical)
            if not repository:
                raise HarnessError("GitHub software URL must identify an owner and repository")
            owner, name, _, _ = repository
            canonical = f"https://github.com/{owner.lower()}/{name.lower()}"
        entry.update({"source_type": "git", "repository_url": canonical.rstrip("/").removesuffix(".git")})
    else:
        section, resource = find_entry(registry, args.artifact_resource)
        if section != "resources" or resource.get("state") != "current":
            raise HarnessError("artifact software requires a current resource")
        entry.update({"source_type": "artifact", "artifact_resource": args.artifact_resource})
        entry["discovered_from"] = [args.artifact_resource]
        registry["relations"].append({
            "from": args.artifact_resource, "kind": "resource-identifies-software",
            "to": args.software_id, "automatic": False,
        })
    registry["software"][args.software_id] = entry


def public_addresses(host: str) -> list[str]:
    try:
        addresses = socket.getaddrinfo(host, 443, type=socket.SOCK_STREAM)
    except socket.gaierror as exc:
        raise HarnessError(f"DNS resolution failed for {host}") from exc
    if not addresses:
        raise HarnessError(f"DNS resolution returned no addresses for {host}")
    result: list[str] = []
    for address in addresses:
        ip = ipaddress.ip_address(address[4][0])
        if not ip.is_global:
            raise HarnessError("URL does not resolve exclusively to public addresses")
        if str(ip) not in result:
            result.append(str(ip))
    return result


def validate_network_url(url: str, git_host_only: bool = False) -> str:
    canonical, secret = redact_and_canonicalize_url(url)
    if not canonical or secret:
        raise HarnessError("URLs with credentials or secret-like query parameters are not allowed")
    parsed = urllib.parse.urlsplit(canonical)
    if parsed.scheme != "https" or not parsed.hostname:
        raise HarnessError("only credential-free HTTPS URLs are allowed")
    if parsed.port not in {None, 443}:
        raise HarnessError("non-default network ports are not allowed")
    if git_host_only and parsed.hostname.lower() not in SUPPORTED_GIT_HOSTS:
        raise HarnessError("git software fetch permits only the configured GitHub/GitLab/Bitbucket hosts")
    public_addresses(parsed.hostname)
    return canonical


class PinnedHTTPSConnection(http.client.HTTPSConnection):
    def __init__(self, hostname: str, pinned_ip: str, timeout: int):
        super().__init__(hostname, port=443, timeout=timeout, context=ssl.create_default_context())
        self.pinned_ip = pinned_ip

    def connect(self) -> None:
        raw = socket.create_connection((self.pinned_ip, 443), self.timeout)
        try:
            self.sock = self._context.wrap_socket(raw, server_hostname=self.host)
        except BaseException:
            raw.close()
            raise


class SafeResponse:
    def __init__(self, connection: PinnedHTTPSConnection, response: http.client.HTTPResponse, final_url: str):
        self.connection = connection
        self.response = response
        self.status = response.status
        self.headers = response.headers
        self.final_url = final_url

    def read(self, amount: int | None = None) -> bytes:
        return self.response.read(amount)

    def geturl(self) -> str:
        return self.final_url

    def getcode(self) -> int:
        return self.status

    def close(self) -> None:
        try:
            self.response.close()
        finally:
            self.connection.close()

    def __enter__(self):
        return self

    def __exit__(self, exc_type, exc, traceback):
        self.close()


def one_pinned_request(url: str, method: str, timeout: int) -> SafeResponse:
    parsed = urllib.parse.urlsplit(url)
    target = urllib.parse.urlunsplit(("", "", parsed.path or "/", parsed.query, ""))
    last_error: OSError | ssl.SSLError | None = None
    for address in public_addresses(parsed.hostname or ""):
        connection = PinnedHTTPSConnection(parsed.hostname or "", address, timeout)
        try:
            connection.request(method, target, headers={
                "User-Agent": "paper-evidence-harness/1", "Accept": "*/*",
                "Connection": "close",
            })
            return SafeResponse(connection, connection.getresponse(), url)
        except (OSError, ssl.SSLError, http.client.HTTPException) as exc:
            connection.close()
            last_error = exc
    raise HarnessError(f"HTTPS connection failed for {parsed.hostname}") from last_error


def safe_open(url: str, method: str = "HEAD", timeout: int = 20) -> SafeResponse:
    current = validate_network_url(url)
    visited: set[str] = set()
    for _ in range(6):
        if current in visited:
            raise HarnessError("redirect loop detected")
        visited.add(current)
        response = one_pinned_request(current, method, timeout)
        if response.status not in {301, 302, 303, 307, 308}:
            return response
        location = response.headers.get("Location", "")
        response.close()
        if not location:
            raise HarnessError("redirect response lacks Location")
        current = validate_network_url(urllib.parse.urljoin(current, location))
    raise HarnessError("redirect limit exceeded")


def verify_resource(entry: dict) -> None:
    url = entry.get("canonical_url", "")
    if "[REDACTED]" in url:
        raise HarnessError("redacted secret URL cannot be fetched")
    checked_at = now_utc()
    try:
        response = safe_open(url, "HEAD")
        if response.status in {400, 405, 501}:
            response.close()
            response = safe_open(url, "GET")
        with response:
            if response.status in {401, 403}:
                entry["verification"] = {
                    "ok": True, "checked_at": checked_at, "status": response.status,
                    "final_url": url_for_receipt(response.geturl()), "access_limited": True,
                    "note": "server denied automated access; identifier/redirect resolution succeeded",
                }
                return
            if response.status >= 400:
                raise HarnessError(f"HTTP status {response.status}")
            if response.headers.get("Content-Length") and int(response.headers["Content-Length"]) < 0:
                raise HarnessError("invalid Content-Length")
            if response.getcode() == 200 and response.headers.get("Content-Length") is None:
                response.read(1)
            entry["verification"] = {
                "ok": True, "checked_at": checked_at, "status": response.getcode(),
                "final_url": url_for_receipt(response.geturl()), "content_type": response.headers.get("Content-Type", ""),
                "content_length": response.headers.get("Content-Length", ""),
                "etag": response.headers.get("ETag", ""),
                "last_modified": response.headers.get("Last-Modified", ""),
            }
    except (HarnessError, OSError, ValueError) as exc:
        entry["verification"] = {"ok": False, "checked_at": checked_at, "error": str(exc)}
        raise HarnessError(f"resource verification failed: {entry['id']}") from exc


def fetch_resource(project: pathlib.Path, entry: dict, max_bytes: int) -> None:
    url = entry.get("canonical_url", "")
    if "[REDACTED]" in url:
        raise HarnessError("redacted secret URL cannot be fetched")
    cache = managed_paths(project)["external_cache"] / entry["id"]
    secure_directory(cache, project)
    with safe_open(url, "GET") as response:
        if response.status >= 400:
            raise HarnessError(f"resource download returned HTTP status {response.status}")
        final_url = response.geturl()
        validate_network_url(final_url)
        content_length = response.headers.get("Content-Length")
        if content_length and int(content_length) > max_bytes:
            raise HarnessError("resource exceeds configured size limit")
        parsed = urllib.parse.urlsplit(final_url)
        basename = pathlib.PurePosixPath(parsed.path).name or "download.bin"
        basename = re.sub(r"[^A-Za-z0-9._-]+", "-", basename)[:120] or "download.bin"
        fd, temp_name = tempfile.mkstemp(prefix=".download-", dir=cache)
        digest = hashlib.sha256()
        size = 0
        try:
            with os.fdopen(fd, "wb") as handle:
                while True:
                    chunk = response.read(1024 * 1024)
                    if not chunk:
                        break
                    size += len(chunk)
                    if size > max_bytes:
                        raise HarnessError("resource exceeded configured size limit while downloading")
                    digest.update(chunk)
                    handle.write(chunk)
                handle.flush()
                os.fsync(handle.fileno())
            destination = cache / f"{digest.hexdigest()}-{basename}"
            reject_symlink_chain(cache, project)
            if destination.exists():
                if destination.is_symlink() or not destination.is_file() or sha256_file(destination) != digest.hexdigest():
                    raise HarnessError("content-addressed resource cache is invalid")
                pathlib.Path(temp_name).unlink(missing_ok=True)
            else:
                os.replace(temp_name, destination)
        finally:
            pathlib.Path(temp_name).unlink(missing_ok=True)
        entry["retrieval"] = {
            "ok": True, "retrieved_at": now_utc(), "final_url": url_for_receipt(final_url),
            "cache_path": destination.relative_to(project).as_posix(),
            "size": size, "sha256": digest.hexdigest(),
            "content_type": response.headers.get("Content-Type", ""),
            "archive_policy": "not extracted; adopt into inbox only after inspection",
        }


def git_environment() -> dict[str, str]:
    environment = {
        "PATH": os.environ.get("PATH", os.defpath),
        "LANG": "C", "LC_ALL": "C",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_SYSTEM": "/dev/null",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_COUNT": "0",
        "GIT_TERMINAL_PROMPT": "0",
        "GIT_PROTOCOL_FROM_USER": "0",
        "GIT_LFS_SKIP_SMUDGE": "1",
    }
    return environment


def git_process_limits() -> None:
    import resource
    resource.setrlimit(resource.RLIMIT_AS, (2 * 1024 * 1024 * 1024, 2 * 1024 * 1024 * 1024))
    resource.setrlimit(resource.RLIMIT_CPU, (300, 300))
    resource.setrlimit(resource.RLIMIT_FSIZE, (2 * 1024 * 1024 * 1024, 2 * 1024 * 1024 * 1024))
    resource.setrlimit(resource.RLIMIT_NOFILE, (128, 128))


def hardened_git_argv(argv: list[str]) -> list[str]:
    if not argv or argv[0] != "git":
        raise HarnessError("git runner accepts git commands only")
    return [
        "git", "-c", "protocol.allow=never", "-c", "protocol.https.allow=always",
        *argv[1:],
    ]


def git_run(
    argv: list[str], timeout: int = 300, max_output_bytes: int = 16 * 1024 * 1024,
) -> subprocess.CompletedProcess:
    hardened_argv = hardened_git_argv(argv)
    try:
        process = subprocess.Popen(
            hardened_argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            env=git_environment(), preexec_fn=git_process_limits, start_new_session=True,
        )
    except OSError as exc:
        raise HarnessError(f"git command failed to start: {argv[0]}") from exc
    assert process.stdout is not None and process.stderr is not None
    stdout_fd = process.stdout.fileno()
    stderr_fd = process.stderr.fileno()
    buffers = {stdout_fd: bytearray(), stderr_fd: bytearray()}
    open_streams = {stdout_fd, stderr_fd}
    deadline = time.monotonic() + timeout
    try:
        while open_streams:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise HarnessError("git command timed out")
            ready, _, _ = select.select(list(open_streams), [], [], min(1.0, remaining))
            if not ready:
                continue
            for descriptor in ready:
                chunk = os.read(descriptor, 65536)
                if not chunk:
                    open_streams.remove(descriptor)
                    continue
                buffers[descriptor].extend(chunk)
                if len(buffers[descriptor]) > max_output_bytes:
                    raise HarnessError("git command output exceeded the configured capture limit")
        return_code = process.wait(timeout=max(1.0, deadline - time.monotonic()))
    except (HarnessError, subprocess.TimeoutExpired):
        with contextlib.suppress(ProcessLookupError):
            os.killpg(process.pid, 9)
        process.wait()
        raise
    return subprocess.CompletedProcess(
        hardened_argv, return_code,
        bytes(buffers[stdout_fd]).decode("utf-8", errors="replace"),
        bytes(buffers[stderr_fd]).decode("utf-8", errors="replace"),
    )


def git_network_run(argv: list[str], url: str, timeout: int = 300) -> subprocess.CompletedProcess:
    canonical = validate_network_url(url, git_host_only=True)
    parsed = urllib.parse.urlsplit(canonical)
    address = public_addresses(parsed.hostname or "")[0]
    curl_address = f"[{address}]" if ":" in address else address
    hardened = [
        "git", "-c", f"http.curloptResolve={parsed.hostname}:443:{curl_address}",
        *argv[1:],
    ]
    return git_run(hardened, timeout=timeout)


def validate_git_cache_budget(path: pathlib.Path) -> tuple[int, int]:
    """Bound a bare repository by inode count and allocated logical bytes."""
    file_count = 0
    total_size = 0
    for root, directories, files in os.walk(path, followlinks=False):
        root_path = pathlib.Path(root)
        for name in directories + files:
            item = root_path / name
            info = item.lstat()
            if stat.S_ISLNK(info.st_mode) or not (stat.S_ISREG(info.st_mode) or stat.S_ISDIR(info.st_mode)):
                raise HarnessError("software cache contains a symlink or special file")
            file_count += 1
            if file_count > 200000:
                raise HarnessError("software cache exceeds 200000 filesystem entries")
            if stat.S_ISREG(info.st_mode):
                total_size += info.st_size
                if total_size > 2 * 1024 * 1024 * 1024:
                    raise HarnessError("software cache exceeds 2 GiB")
    return file_count, total_size


def git_tree_inventory(git_dir: pathlib.Path, revision: str) -> dict:
    """Stream a NUL-delimited tree listing under explicit byte/entry limits."""
    argv = hardened_git_argv([
        "git", f"--git-dir={git_dir}", "ls-tree", "-r", "-z", "--name-only", revision,
    ])
    try:
        process = subprocess.Popen(
            argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            env=git_environment(), preexec_fn=git_process_limits,
        )
    except OSError as exc:
        raise HarnessError("software tree inventory could not start") from exc
    assert process.stdout is not None
    count = 0
    byte_count = 0
    pending = b""
    top_level: set[str] = set()
    licenses: list[str] = []
    submodules_present = False
    lfs_review_required = False
    deadline = time.monotonic() + 300
    try:
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise HarnessError("software tree inventory timed out")
            ready, _, _ = select.select([process.stdout], [], [], min(1.0, remaining))
            if not ready:
                if process.poll() is not None:
                    chunk = process.stdout.read(1024 * 1024)
                    if not chunk:
                        break
                else:
                    continue
            else:
                chunk = os.read(process.stdout.fileno(), 1024 * 1024)
            if not chunk:
                break
            byte_count += len(chunk)
            if byte_count > 16 * 1024 * 1024:
                raise HarnessError("software tree inventory exceeds 16 MiB")
            pending += chunk
            items = pending.split(b"\0")
            pending = items.pop()
            for raw_name in items:
                if not raw_name:
                    continue
                count += 1
                if count > 100000:
                    raise HarnessError("software tree exceeds 100000 files")
                name = raw_name.decode("utf-8", errors="replace")
                top_level.add(name.split("/", 1)[0])
                basename = pathlib.PurePosixPath(name).name.lower()
                if basename.startswith(("license", "copying", "notice")) and len(licenses) < 50:
                    licenses.append(name)
                submodules_present = submodules_present or name == ".gitmodules"
                lfs_review_required = lfs_review_required or name.endswith(".gitattributes")
        if pending:
            raise HarnessError("software tree inventory is not NUL terminated")
        return_code = process.wait(timeout=30)
        if return_code != 0:
            raise HarnessError("software tree could not be indexed")
    except (HarnessError, subprocess.TimeoutExpired):
        process.kill()
        process.wait()
        raise
    return {
        "file_count": count, "inventory_bytes": byte_count,
        "top_level": sorted(top_level)[:200], "license_candidates": licenses,
        "submodules_present": submodules_present,
        "lfs_review_required": lfs_review_required,
    }


def resolve_git_revision(url: str, revision: str) -> str:
    if re.fullmatch(r"(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})", revision):
        return revision.lower()
    query = revision or "HEAD"
    if (
        len(query) > 255
        or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._/-]*", query)
        or query.endswith(("/", "."))
        or ".." in query
        or "//" in query
        or any(part.startswith(".") or part.endswith(".lock") for part in query.split("/"))
    ):
        raise HarnessError("git revision must be one exact ref name or a full object ID")
    result = git_network_run([
        "git", "-c", "protocol.file.allow=never", "ls-remote", url,
        query, f"{query}^{{}}",
    ], url)
    if result.returncode != 0:
        raise HarnessError("git revision lookup failed")
    logical_refs: dict[str, dict[str, str]] = {}
    for line in result.stdout.splitlines():
        match = re.fullmatch(r"((?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64}))\s+([^\s]+)", line.strip())
        if not match:
            raise HarnessError("git revision lookup returned malformed output")
        object_id, ref_name = match.groups()
        peeled = ref_name.endswith("^{}")
        logical_name = ref_name[:-3] if peeled else ref_name
        values = logical_refs.setdefault(logical_name, {})
        field = "peeled" if peeled else "direct"
        if field in values and values[field] != object_id.lower():
            raise HarnessError("git revision lookup returned conflicting object IDs")
        values[field] = object_id.lower()
    if not logical_refs:
        raise HarnessError("requested git revision was not found")
    if len(logical_refs) != 1:
        raise HarnessError("requested git revision resolves to multiple refs")
    values = next(iter(logical_refs.values()))
    return values.get("peeled") or values.get("direct") or ""


def fetch_artifact_software(project: pathlib.Path, registry: dict, entry: dict, resource_id: str, revision_override: str | None) -> None:
    resource = registry.get("resources", {}).get(resource_id, {})
    retrieval = resource.get("retrieval", {})
    if resource.get("state") != "current" or not retrieval.get("ok"):
        raise HarnessError("artifact software requires a fetched current resource")
    cache_path = ensure_within(project / retrieval.get("cache_path", ""), managed_paths(project)["external_cache"])
    reject_symlink_chain(cache_path, project)
    snapshot = stable_file_snapshot(cache_path)
    if snapshot["sha256"] != retrieval.get("sha256") or snapshot["size"] != retrieval.get("size"):
        raise HarnessError("artifact resource cache receipt does not match bytes")
    requested = revision_override if revision_override is not None else entry.get("requested_revision", "")
    if not requested:
        raise HarnessError("artifact software requires an explicit package/release version")
    entry["requested_revision"] = requested
    if revision_override is not None:
        entry["revision_source"] = "manual"
    entry["resolved_revision"] = f"sha256:{snapshot['sha256']}"
    entry["retrieval"] = {
        "ok": True, "retrieved_at": now_utc(), "source_type": "artifact",
        "source_resource": resource_id, "version_label": requested,
        "requested_revision": requested,
        "cache_path": retrieval.get("cache_path"), "size": snapshot["size"],
        "sha256": snapshot["sha256"],
        "storage": "content-addressed resource artifact; not unpacked or executed",
    }


def fetch_software(project: pathlib.Path, registry: dict, entry: dict, revision_override: str | None) -> None:
    if entry.get("source_type", "git") == "artifact":
        resource_id = entry.get("artifact_resource")
        return fetch_artifact_software(project, registry, entry, resource_id, revision_override)
    url = entry.get("repository_url", "")
    requested = revision_override if revision_override is not None else entry.get("requested_revision", "")
    if entry.get("revision_requires_review") and not requested:
        raise HarnessError("ambiguous repository page requires an explicit --revision")
    validate_network_url(url, git_host_only=True)
    resolved = resolve_git_revision(url, requested)
    cache_root = managed_paths(project)["software_cache"]
    software_root = cache_root / entry["id"]
    secure_directory(cache_root, project)
    secure_directory(software_root, project)
    destination = software_root / f"{resolved}.git"
    if destination.exists():
        if destination.is_symlink() or not destination.is_dir():
            raise HarnessError("software cache path is invalid")
        verify = git_run(["git", f"--git-dir={destination}", "cat-file", "-e", f"{resolved}^{{commit}}"])
        if verify.returncode != 0:
            raise HarnessError("content-addressed software cache is invalid")
        validate_git_cache_budget(destination)
    else:
        reject_symlink_chain(cache_root, project)
        temp = pathlib.Path(tempfile.mkdtemp(prefix=f".{entry['id']}.", dir=cache_root))
        try:
            result = git_network_run([
                "git", "-c", "protocol.file.allow=never", "clone", "--bare",
                "--filter=blob:none", "--no-tags", url, str(temp),
            ], url)
            if result.returncode != 0:
                raise HarnessError("bare software clone failed")
            verify = git_run(["git", f"--git-dir={temp}", "cat-file", "-e", f"{resolved}^{{commit}}"])
            if verify.returncode != 0 and requested:
                result = git_network_run([
                    "git", f"--git-dir={temp}", "-c", "protocol.file.allow=never",
                    "fetch", "--depth=1", "origin", requested,
                ], url)
                if result.returncode != 0:
                    raise HarnessError("requested software revision could not be fetched")
                verify = git_run(["git", f"--git-dir={temp}", "cat-file", "-e", f"{resolved}^{{commit}}"])
            if verify.returncode != 0:
                raise HarnessError("resolved software commit is absent after fetch")
            validate_git_cache_budget(temp)
            reject_symlink_chain(software_root, project)
            os.replace(temp, destination)
        finally:
            if temp.exists():
                shutil.rmtree(temp)
    cache_entries, cache_size = validate_git_cache_budget(destination)
    inventory = git_tree_inventory(destination, resolved)
    entry["requested_revision"] = requested
    if revision_override is not None:
        entry["revision_source"] = "manual"
    entry["revision_requires_review"] = False
    entry["resolved_revision"] = resolved
    entry["retrieval"] = {
        "ok": True, "retrieved_at": now_utc(), "resolved_commit": resolved,
        "requested_revision": requested,
        "cache_path": destination.relative_to(project).as_posix(),
        "storage": "content-addressed bare partial clone; no checkout, hooks, submodules, or LFS objects executed/fetched",
        "cache_entry_count": cache_entries, "cache_size": cache_size,
        **inventory,
    }


def record_run(project: pathlib.Path, registry: dict, args: argparse.Namespace) -> None:
    if not ENTRY_ID.fullmatch(args.run_id) or not args.run_id.startswith("RUN-"):
        raise HarnessError("run ID must match RUN-[A-Z0-9-]+")
    if args.run_id in registry.get("runs", {}):
        raise HarnessError("run IDs are immutable; record a new run ID for a new receipt")
    section, software_entry = find_entry(registry, args.software)
    if section != "software":
        raise HarnessError("run software ID is invalid")
    software_revision = software_entry.get("resolved_revision", "")
    retrieval = software_entry.get("retrieval", {})
    if args.status == "success" and (not software_revision or not retrieval.get("ok")):
        raise HarnessError("successful run requires software pinned by fetch-software")
    if args.container_digest and not re.fullmatch(r"sha256:[0-9a-fA-F]{64}", args.container_digest):
        raise HarnessError("container digest must be sha256 followed by 64 hexadecimal digits")
    entries = all_entries(registry)
    if len(args.input) != len(set(args.input)):
        raise HarnessError("run input IDs must be unique")
    for input_id in args.input:
        if input_id not in entries or entries[input_id][0] not in {"assets", "resources"}:
            raise HarnessError(f"run input ID does not exist: {input_id}")
        relation = {"from": input_id, "kind": "input-to", "to": args.run_id, "automatic": False}
        if relation not in registry["relations"]:
            registry["relations"].append(relation)
    outputs: list[str] = []
    output_visuals: list[str] = []
    for relative in args.output:
        path = ensure_within(project / relative, project)
        allowed = managed_paths(project)["outputs"]
        if allowed not in path.parents or not path.is_file() or path.is_symlink():
            raise HarnessError("run outputs must be regular files under .workspace/source/software-output")
        digest = sha256_file(path)
        asset_id = short_id("ASSET", f"software-output:{digest}")
        asset = registry["assets"].get(asset_id)
        if not asset:
            asset = scan_file(project, path, "software-output", registry["assets"])
            registry["assets"][asset_id] = asset
        if asset_id in outputs:
            raise HarnessError("run output files must have distinct content")
        outputs.append(asset_id)
        relation = {"from": asset_id, "kind": "generated-by", "to": args.software, "automatic": False}
        if relation not in registry["relations"]:
            registry["relations"].append(relation)
        run_relation = {"from": asset_id, "kind": "generated-by", "to": args.run_id, "automatic": False}
        if run_relation not in registry["relations"]:
            registry["relations"].append(run_relation)
        if asset.get("media_type", "").startswith("image/") or path.suffix.lower() == ".pdf":
            visual_id = short_id("VIS", asset_id)
            old_visual = registry["visuals"].get(visual_id, {})
            visual_annotation = merge_annotation(old_visual.get("annotations"), "software-output")
            if visual_annotation.get("origin") == "pending":
                visual_annotation["origin"] = "software-output"
            visual_entry = {
                "id": visual_id, "state": "current", "source_asset": asset_id,
                "visual_type": "figure", "locator": {"path": path.relative_to(project).as_posix()},
                "candidate_basis": "recorded software visual output",
                "annotations": visual_annotation,
            }
            for key in (
                "visual_review_preparations", "visual_reviews",
                "active_visual_review_preparation",
            ):
                if key in old_visual:
                    visual_entry[key] = old_visual[key]
            registry["visuals"][visual_id] = visual_entry
            visual_relation = {"from": visual_id, "kind": "generated-by", "to": args.software, "automatic": False}
            if visual_relation not in registry["relations"]:
                registry["relations"].append(visual_relation)
            visual_run_relation = {"from": visual_id, "kind": "generated-by", "to": args.run_id, "automatic": False}
            if visual_run_relation not in registry["relations"]:
                registry["relations"].append(visual_run_relation)
            output_visuals.append(visual_id)
    dependency_lock = ""
    dependency_lock_receipt: dict = {}
    if args.dependency_lock:
        lock_path = ensure_within(project / args.dependency_lock, project)
        if not lock_path.is_file() or lock_path.is_symlink():
            raise HarnessError("dependency lock path is invalid")
        lock_snapshot = stable_file_snapshot(lock_path)
        if not lock_snapshot["stable"]:
            raise HarnessError("dependency lock changed while being recorded")
        relative_lock = lock_path.relative_to(project).as_posix()
        dependency_lock = f"{relative_lock}@sha256:{lock_snapshot['sha256']}"
        dependency_lock_receipt = {
            "path": relative_lock, "size": lock_snapshot["size"],
            "mtime_ns": lock_snapshot["mtime_ns"], "sha256": lock_snapshot["sha256"],
        }
    registry["runs"][args.run_id] = {
        "id": args.run_id, "state": "current", "software": args.software, "status": args.status,
        "software_revision": software_revision,
        "software_cache_path": retrieval.get("cache_path", ""),
        "recorded_at": now_utc(), "command": args.run_command,
        "environment": args.environment, "container_digest": args.container_digest or "",
        "dependency_lock": dependency_lock,
        "dependency_lock_receipt": dependency_lock_receipt, "seed": args.seed,
        "inputs": args.input, "outputs": outputs, "output_visuals": output_visuals,
        "notes": args.notes or "",
        "execution_policy": "receipt only; harness did not execute external code",
        "annotations": merge_annotation(None, "run"),
    }
    uses_relation = {"from": args.run_id, "kind": "uses", "to": args.software, "automatic": False}
    if uses_relation not in registry["relations"]:
        registry["relations"].append(uses_relation)


def validate_pdf_file(
    path: pathlib.Path, evidence_ids: set[str] | None = None,
    visual_placements: set[tuple[str, str]] | None = None,
    code_placements: set[str] | None = None,
    allowed_evidence_ids: set[str] | None = None,
) -> tuple[int, str]:
    if sniff_type(path) != "application/pdf":
        raise HarnessError("build receipt PDF does not have a PDF signature")
    if not shutil.which("pdfinfo"):
        raise HarnessError("pdfinfo is required to validate a build receipt")
    status_code, stdout, stderr = run_tool(["pdfinfo", str(path)])
    if status_code != 0:
        raise HarnessError(f"build receipt PDF is structurally invalid: {stderr.strip()[:300]}")
    pages_match = re.search(r"^Pages:\s+(\d+)\s*$", stdout, re.MULTILINE)
    encrypted_match = re.search(r"^Encrypted:\s+(.+)$", stdout, re.MULTILINE)
    if not pages_match or int(pages_match.group(1)) < 1:
        raise HarnessError("build receipt PDF has no readable pages")
    encrypted = encrypted_match.group(1).strip() if encrypted_match else "unknown"
    if encrypted.lower() not in {"no", "false"}:
        raise HarnessError("encrypted build PDFs are not accepted")
    if not shutil.which("pdftotext"):
        raise HarnessError("pdftotext is required to validate the rendered evidence index")
    text_status, pdf_text, text_error = run_tool(["pdftotext", "-layout", str(path), "-"], timeout=120)
    if text_status != 0:
        raise HarnessError(f"build receipt PDF text could not be inspected: {text_error.strip()[:300]}")
    rendered_ids = set(
        re.findall(r"(?:ASSET|VIS|RES|SW|RUN)-[A-Z0-9-]+", pdf_text)
    )
    missing_ids = sorted((evidence_ids or set()) - rendered_ids)
    if missing_ids:
        raise HarnessError(f"rendered evidence index is missing IDs: {', '.join(missing_ids)}")
    if allowed_evidence_ids is not None:
        unexpected_ids = sorted(rendered_ids - allowed_evidence_ids)
        if unexpected_ids:
            raise HarnessError(
                "rendered PDF contains evidence outside the artifact scope: "
                + ", ".join(unexpected_ids)
            )
    rendered_visuals = set(re.findall(
        r"placed\s+visual\s*:\s*(VIS-[A-Z0-9-]+)\s+via\s+(ASSET-[A-Z0-9-]+)",
        pdf_text, re.IGNORECASE,
    ))
    rendered_code = set(re.findall(
        r"placed\s+code\s*:\s*(ASSET-[A-Z0-9-]+)", pdf_text, re.IGNORECASE,
    ))
    missing_visuals = sorted((visual_placements or set()) - rendered_visuals)
    missing_code = sorted((code_placements or set()) - rendered_code)
    if missing_visuals:
        raise HarnessError(
            "rendered PDF is missing visual placement sentinels: "
            + ", ".join(f"{visual_id} via {backing_id}" for visual_id, backing_id in missing_visuals)
        )
    if missing_code:
        raise HarnessError(
            "rendered PDF is missing code placement sentinels: "
            + ", ".join(missing_code)
        )
    return int(pages_match.group(1)), encrypted


def fls_input_paths(project: pathlib.Path, fls_text: str) -> set[pathlib.Path]:
    pwd_line = next((line[4:] for line in fls_text.splitlines() if line.startswith("PWD ")), "")
    base = pathlib.Path(pwd_line) if pwd_line else project
    if not base.is_absolute():
        base = project / base
    result: set[pathlib.Path] = set()
    for line in fls_text.splitlines():
        if not line.startswith("INPUT "):
            continue
        raw = line[6:].strip()
        candidate = pathlib.Path(raw)
        try:
            resolved = (candidate if candidate.is_absolute() else base / candidate).resolve()
        except OSError:
            continue
        result.add(resolved)
    return result


def artifact_allowed_rendered_ids(
    registry: dict, artifact_id: str, evidence_ids: set[str],
) -> set[str]:
    allowed = set(evidence_ids)
    for reference in artifact_reference_records(registry, artifact_id):
        if (
            reference.get("kind") == "visual-placement"
            and reference.get("id") in evidence_ids
            and reference.get("backing_id")
        ):
            allowed.add(reference["backing_id"])
    return allowed


def validate_artifact_input_isolation(
    project: pathlib.Path, config: dict, artifact_id: str,
    input_paths: set[pathlib.Path],
) -> None:
    artifacts = artifact_specs(project, config)
    artifact = artifacts[artifact_id]
    evidence_index = (
        managed_paths(project)["generated"] / "evidence-index.tex"
    ).resolve()
    if not artifact["requires_evidence_index"] and evidence_index in input_paths:
        raise HarnessError(
            f"artifact must not input evidence-index.tex: {artifact_id}"
        )
    for other_id, other in artifacts.items():
        if other_id == artifact_id:
            continue
        other_root = (project / other["source_root"]).resolve()
        mixed_inputs = sorted(
            path.relative_to(project).as_posix()
            for path in input_paths
            if path == other_root or other_root in path.parents
        )
        if mixed_inputs:
            raise HarnessError(
                f"build input for artifact {artifact_id} includes canonical source "
                f"from artifact {other_id}: {', '.join(mixed_inputs)}"
            )


def reject_cross_artifact_build_reuse(
    registry: dict, artifact_id: str, catalog: str,
    fls_relative: str, fls_hash: str, pdf_relative: str, pdf_hash: str,
) -> None:
    for receipt in registry.get("receipts", {}).get("builds", []):
        other_id = receipt.get("artifact_id", "notes")
        if other_id == artifact_id or receipt.get("catalog_fingerprint") != catalog:
            continue
        if receipt.get("fls") == fls_relative or receipt.get("fls_sha256") == fls_hash:
            raise HarnessError(
                f"build recorder file is already bound to artifact: {other_id}"
            )
        if receipt.get("pdf") == pdf_relative or receipt.get("pdf_sha256") == pdf_hash:
            raise HarnessError(
                f"build PDF is already bound to artifact: {other_id}"
            )


def record_build(project: pathlib.Path, config: dict, registry: dict, args: argparse.Namespace) -> None:
    artifacts = artifact_specs(project, config)
    artifact_id = args.artifact
    if artifact_id is None:
        if len(artifacts) != 1:
            raise HarnessError("record-build requires --artifact for a multi-artifact project")
        artifact_id = next(iter(artifacts))
    if artifact_id not in artifacts:
        raise HarnessError(f"unknown artifact: {artifact_id}")
    artifact = artifacts[artifact_id]
    fls = ensure_within(project / args.fls, project)
    pdf = ensure_within(project / args.pdf, project)
    if not fls.is_file() or fls.is_symlink() or not pdf.is_file() or pdf.is_symlink():
        raise HarnessError("build receipt inputs are invalid")
    current_evidence_ids = artifact_evidence_ids(
        registry, artifact_id, artifact["evidence_scope"],
    )
    rendered_visuals, rendered_code = required_rendered_placements(
        registry, artifact_id, current_evidence_ids,
    )
    allowed_rendered_ids = (
        artifact_allowed_rendered_ids(registry, artifact_id, current_evidence_ids)
        if artifact["evidence_scope"] == "referenced" else None
    )
    pages, encrypted = validate_pdf_file(
        pdf, current_evidence_ids, rendered_visuals, rendered_code,
        allowed_rendered_ids,
    )
    _, _, _, live_source_files = collect_note_references(
        project, config, artifact_id,
    )
    source_fingerprint = manifest_fingerprint(live_source_files)
    expected_source_fingerprint = artifact_scan_state(
        registry, artifact_id,
    ).get("source_fingerprint")
    if source_fingerprint != expected_source_fingerprint:
        raise HarnessError(
            f"canonical source changed after the last scan for artifact: {artifact_id}"
        )
    fls_text = fls.read_text(encoding="utf-8", errors="replace")
    input_paths = fls_input_paths(project, fls_text)
    validate_artifact_input_isolation(project, config, artifact_id, input_paths)
    required_paths = {
        (managed_paths(project)["generated"] / "evidence-macros.tex").resolve(),
    }
    if artifact["requires_evidence_index"]:
        required_paths.add(
            (managed_paths(project)["generated"] / "evidence-index.tex").resolve()
        )
    missing = sorted(path.name for path in required_paths - input_paths)
    if missing:
        raise HarnessError(f"build recorder did not find generated input in .fls: {', '.join(missing)}")
    missing_source = []
    for item in live_source_files:
        if pathlib.PurePosixPath(item["path"]).suffix.lower() == ".tex":
            expected = (project / item["path"]).resolve()
            if expected not in input_paths:
                missing_source.append(item["path"])
    if missing_source:
        raise HarnessError(f"build recorder did not find canonical TeX input in .fls: {', '.join(missing_source)}")
    placement_bindings = build_placement_bindings(
        project, registry, input_paths, artifact_id, current_evidence_ids,
    )
    newest_source_mtime = max((item["mtime_ns"] for item in live_source_files), default=0)
    if fls.stat().st_mtime_ns < newest_source_mtime or pdf.stat().st_mtime_ns < newest_source_mtime:
        raise HarnessError("build files predate the current canonical source")
    catalog = catalog_fingerprint(registry)
    fls_relative = fls.relative_to(project).as_posix()
    pdf_relative = pdf.relative_to(project).as_posix()
    fls_hash = sha256_file(fls)
    pdf_hash = sha256_file(pdf)
    reject_cross_artifact_build_reuse(
        registry, artifact_id, catalog,
        fls_relative, fls_hash, pdf_relative, pdf_hash,
    )
    registry.setdefault("receipts", {}).setdefault("builds", []).append({
        "recorded_at": now_utc(), "catalog_fingerprint": catalog,
        "artifact_id": artifact_id,
        "source_fingerprint": source_fingerprint,
        "ingestion_fingerprint": ingestion_fingerprint(load_ingestion_manifest(project)),
        "fls": fls_relative, "fls_sha256": fls_hash,
        "pdf": pdf_relative, "pdf_sha256": pdf_hash,
        "pdf_pages": pages, "pdf_encrypted": encrypted,
        "evidence_ids": sorted(current_evidence_ids),
        "placement_bindings": placement_bindings,
        "offline": args.offline == "yes", "source_revision_label": args.source_revision or "",
    })


def status_summary(registry: dict) -> str:
    lines = [f"catalog={catalog_fingerprint(registry)}"]
    for artifact_id, artifact in sorted(
        registry.get("scan", {}).get("artifacts", {}).items()
    ):
        lines.append(
            f"artifact={artifact_id} kind={artifact.get('kind', '')} "
            f"source={artifact.get('source_fingerprint', '')}"
        )
    for section in ("assets", "visuals", "resources", "software", "runs"):
        entries = [entry for entry in registry.get(section, {}).values() if entry.get("state", "current") == "current"]
        pending = sum(1 for entry in entries if entry.get("annotations", {}).get("disposition") == "pending")
        lines.append(f"{section}={len(entries)} pending={pending}")
    return "\n".join(lines)


