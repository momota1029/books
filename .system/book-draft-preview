class PreviewError(Exception):
    def __init__(self, message: str, *, status_recorded: bool = False) -> None:
        super().__init__(message)
        self.status_recorded = status_recorded


def fail(message: str) -> None:
    print(f"book-draft-preview: {message}", file=sys.stderr)
    raise SystemExit(1)


def ensure_directory(path: pathlib.Path, description: str) -> None:
    try:
        metadata = path.lstat()
        resolved = path.resolve(strict=True)
    except (OSError, RuntimeError) as exc:
        raise PreviewError(f"{description} is unavailable") from exc
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or path.is_symlink()
        or pathlib.Path(os.path.abspath(path)) != resolved
    ):
        raise PreviewError(f"{description} is unsafe")


def ensure_regular(path: pathlib.Path, description: str) -> None:
    try:
        metadata = path.lstat()
    except OSError as exc:
        raise PreviewError(f"{description} is unavailable") from exc
    if not stat.S_ISREG(metadata.st_mode) or path.is_symlink():
        raise PreviewError(f"{description} is unsafe")


def read_regular_bytes(path: pathlib.Path, description: str) -> bytes:
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        raise PreviewError(f"{description} is unavailable or unsafe") from exc
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise PreviewError(f"{description} is unsafe")
        with os.fdopen(descriptor, "rb") as handle:
            descriptor = -1
            return handle.read()
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def ensure_nonempty_regular(path: pathlib.Path, description: str) -> None:
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        raise PreviewError(f"{description} is unavailable or unsafe") from exc
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise PreviewError(f"{description} is unsafe")
        if metadata.st_size == 0:
            raise PreviewError(f"{description} is empty")
    finally:
        os.close(descriptor)


def remove_unsafe_generated_entry(path: pathlib.Path, parent: pathlib.Path) -> None:
    """Remove only a non-regular entry created at an expected private output path."""
    ensure_directory(parent, "generated preview output directory")
    if path.parent != parent or not path.name:
        raise PreviewError("generated preview output path is unsafe")
    flags = os.O_RDONLY
    if hasattr(os, "O_DIRECTORY"):
        flags |= os.O_DIRECTORY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(parent, flags)
    try:
        try:
            metadata = os.stat(path.name, dir_fd=descriptor, follow_symlinks=False)
        except FileNotFoundError:
            return
        if stat.S_ISREG(metadata.st_mode):
            return
        if stat.S_ISDIR(metadata.st_mode):
            os.rmdir(path.name, dir_fd=descriptor)
        else:
            os.unlink(path.name, dir_fd=descriptor)
    finally:
        os.close(descriptor)


def repository_root() -> pathlib.Path:
    script = pathlib.Path(__file__)
    if script.is_symlink():
        raise PreviewError("script path is unsafe")
    script = script.resolve(strict=True)
    result = subprocess.run(
        ["git", "-C", str(script.parent.parent), "rev-parse", "--show-toplevel"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        raise PreviewError("repository root is unavailable")
    root = pathlib.Path(result.stdout.strip()).resolve(strict=True)
    if script.parent != root / ".system":
        raise PreviewError("script path is unsafe")
    return root


def resolve_project(root: pathlib.Path, raw_project: str) -> tuple[pathlib.Path, str]:
    candidate = pathlib.Path(raw_project)
    if not candidate.is_absolute():
        candidate = root / candidate
    candidate = pathlib.Path(os.path.abspath(candidate))
    try:
        project = candidate.resolve(strict=True)
        relative = project.relative_to(root / "book-translations")
    except (OSError, RuntimeError, ValueError) as exc:
        raise PreviewError("project is unavailable") from exc
    if candidate != project or len(relative.parts) != 1:
        raise PreviewError("project must be a safe direct child of book-translations")
    ensure_directory(project, "project")
    for name in (
        "draft",
        ".workspace",
        ".workspace/source",
        ".workspace/records",
        ".workspace/tools",
        ".workspace/build",
        ".workspace/logs",
        ".workspace/locks",
    ):
        ensure_directory(project / name, f"project {name}")
    return project, project.relative_to(root).as_posix()


def normalize_source_root(project: pathlib.Path, raw_source_root: str) -> tuple[pathlib.Path, str]:
    pure = pathlib.PurePosixPath(raw_source_root)
    if pure.is_absolute() or ".." in pure.parts or len(pure.parts) < 3:
        raise PreviewError("source root is invalid")
    if pure.parts[:2] != (".workspace", "source"):
        raise PreviewError("source root must be below .workspace/source")
    candidate = pathlib.Path(os.path.abspath(project / pure))
    source_base = (project / ".workspace" / "source").resolve(strict=True)
    try:
        candidate.relative_to(source_base)
    except ValueError as exc:
        raise PreviewError("source root is outside canonical source") from exc
    if candidate.exists() or candidate.is_symlink():
        ensure_directory(candidate, "preview source root")
    else:
        parent = candidate.parent
        ensure_directory(parent, "preview source root parent")
    return candidate, pure.as_posix()


def atomic_write(path: pathlib.Path, content: bytes, prefix: str) -> None:
    ensure_directory(path.parent, "output parent")
    if path.exists() or path.is_symlink():
        ensure_regular(path, "existing output")
    descriptor, temporary = tempfile.mkstemp(prefix=prefix, dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def atomic_json_write(path: pathlib.Path, value: dict[str, Any], prefix: str) -> None:
    atomic_write(
        path,
        (json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n").encode(
            "utf-8"
        ),
        prefix,
    )


@contextlib.contextmanager
def preview_lock(project: pathlib.Path):
    lock_path = project / ".workspace" / "locks" / "book-draft-preview.lock"
    ensure_directory(lock_path.parent, "preview lock directory")
    flags = os.O_RDWR | os.O_CREAT
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(lock_path, flags, 0o600)
    except OSError as exc:
        raise PreviewError("preview lock is unavailable or unsafe") from exc
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise PreviewError("preview lock is unsafe")
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        os.close(descriptor)


def load_json(path: pathlib.Path, description: str) -> dict[str, Any]:
    value, _ = load_json_snapshot(path, description)
    return value


def load_json_snapshot(
    path: pathlib.Path, description: str
) -> tuple[dict[str, Any], bytes]:
    try:
        content = read_regular_bytes(path, description)
        value = json.loads(content.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise PreviewError(f"{description} is invalid") from exc
    if not isinstance(value, dict):
        raise PreviewError(f"{description} is invalid")
    return value, content


def migration_check(
    root: pathlib.Path,
    project_relative: str,
    operation: str,
    target: str | None = None,
) -> bool:
    command = [
        str(root / ".system" / "standards-migration"),
        "check",
        "--scope",
        project_relative,
        "--operation",
        operation,
    ]
    if operation in {"reconstruct", "preview"}:
        if target is None:
            raise PreviewError(f"{operation} requires a target")
        command.extend(("--target", target))
    result = subprocess.run(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    return result.returncode == 0


def standards_fingerprint(root: pathlib.Path, project_relative: str) -> str:
    result = subprocess.run(
        [
            str(root / ".system" / "standards-migration"),
            "fingerprint",
            "--scope",
            project_relative,
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    fingerprint = result.stdout.strip()
    if result.returncode != 0 or len(fingerprint) != 64 or any(
        character not in "0123456789abcdef" for character in fingerprint
    ):
        raise PreviewError("current standards fingerprint is unavailable")
    return fingerprint


def migration_source_root(root: pathlib.Path, project_relative: str) -> str:
    fingerprint = standards_fingerprint(root, project_relative)
    return f"{MIGRATION_SOURCE_PREFIX}{fingerprint[:12]}"


def config_path(project: pathlib.Path) -> pathlib.Path:
    return project / CONFIG_PATH


def source_digest(source_root: pathlib.Path) -> str:
    digest = hashlib.sha256()
    for name in SOURCE_FILES:
        ensure_regular(source_root / name, f"preview source {name}")
    files: list[pathlib.Path] = []
    for current, directories, names in os.walk(source_root, followlinks=False):
        current_path = pathlib.Path(current)
        ensure_directory(current_path, "preview source directory")
        directories.sort()
        names.sort()
        for directory in directories:
            if (current_path / directory).is_symlink():
                raise PreviewError("preview source directory is unsafe")
        for name in names:
            path = current_path / name
            ensure_regular(path, "preview source file")
            files.append(path)
    for path in sorted(files, key=lambda item: item.relative_to(source_root).as_posix()):
        relative = path.relative_to(source_root).as_posix()
        digest.update(
            relative.encode("utf-8")
            + b"\0"
            + read_regular_bytes(path, "preview source file")
        )
    return digest.hexdigest()


def git_revision(root: pathlib.Path) -> str:
    result = subprocess.run(
        ["git", "-C", str(root), "rev-parse", "--verify", "HEAD^{commit}"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    return result.stdout.strip() if result.returncode == 0 else "unavailable"


