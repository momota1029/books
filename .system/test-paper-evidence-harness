write_png() {
  python3 - "$1" "${2:-32,128,224}" <<'PY'
import pathlib
import struct
import sys
import zlib

def chunk(name, data):
    return struct.pack(">I", len(data)) + name + data + struct.pack(">I", zlib.crc32(name + data) & 0xffffffff)

width = height = 4
pixel = bytes(int(value) for value in sys.argv[2].split(","))
assert len(pixel) == 3
scanlines = b"".join(b"\x00" + pixel * width for _ in range(height))
payload = b"\x89PNG\r\n\x1a\n"
payload += chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
payload += chunk(b"IDAT", zlib.compress(scanlines))
payload += chunk(b"IEND", b"")
pathlib.Path(sys.argv[1]).write_bytes(payload)
PY
}

