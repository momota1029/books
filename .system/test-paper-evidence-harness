#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C
export GIT_CONFIG_GLOBAL=/dev/null
export GIT_CONFIG_SYSTEM=/dev/null

source_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
test_root=$(mktemp -d)

cleanup() {
  if [[ -n ${test_root:-} && -d $test_root ]]; then
    rm -rf -- "$test_root"
  fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

fail() {
  printf 'not ok %s - %s\n' "$1" "$2" >&2
  exit 1
}

pass() {
  printf 'ok %s - %s\n' "$1" "$2"
}

visual_review_checks=(
  decode-render visual-presence-crop source-completeness panels-reading-order
  axes-units-scales legend-color-symbols statistical-encoding biological-context
  caption-body-consistency geometry-semantics scientific-interpretation accessibility
)

record_passing_visual_review() {
  local target_id=$1
  local review_id=$2
  local role=$3
  local reviewer=$4
  local independent_of=${5:-}
  local reviewer_kind=${6:-codex}
  local -a command=(
    "$repo_dir/.system/paper-evidence-harness" record-visual-review "$project" "$review_id"
    --target "$target_id" --role "$role" --reviewer "$reviewer" --reviewer-kind "$reviewer_kind"
    --verdict pass --summary 'fixture visual review completed'
    --limitations 'synthetic fixture; no scientific interpretation claimed'
  )
  if [[ -n $independent_of ]]; then
    command+=(--independent-of "$independent_of")
  fi
  local check
  for check in "${visual_review_checks[@]}"; do
    command+=(--check "$check" complete)
  done
  "${command[@]}" >/dev/null
}

record_all_na_visual_review() {
  local target_id=$1
  local review_id=$2
  local -a command=(
    "$repo_dir/.system/paper-evidence-harness" record-visual-review "$project" "$review_id"
    --target "$target_id" --role primary --reviewer codex-all-na --reviewer-kind codex
    --verdict pass --summary 'invalid all-not-applicable review'
    --limitations 'fixture intended to be rejected'
  )
  local check
  for check in "${visual_review_checks[@]}"; do
    command+=(--check "$check" not-applicable)
  done
  "${command[@]}" >/dev/null
}

write_pdf() {
  python3 - "$1" "${2:-}" <<'PY'
import json
import pathlib
import sys

registry_path = pathlib.Path(sys.argv[2]) if sys.argv[2] else None
ids = []
if registry_path:
    registry = json.loads(registry_path.read_text())
    for section in ("assets", "visuals", "resources", "software", "runs"):
        ids.extend(sorted(key for key, value in registry[section].items() if value.get("state", "current") == "current"))
commands = ["BT", "/F1 8 Tf", "10 185 Td", "(EVIDENCE INDEX) Tj"]
for entry_id in ids:
    commands.extend(["0 -12 Td", f"({entry_id}) Tj"])
commands.append("ET")
stream = "\n".join(commands).encode()
objects = [
    b"<< /Type /Catalog /Pages 2 0 R >>",
    b"<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
    b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 300 220] /Resources << /Font << /F1 5 0 R >> >> /Contents 4 0 R >>",
    f"<< /Length {len(stream)} >>\nstream\n".encode() + stream + b"\nendstream",
    b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>",
]
payload = bytearray(b"%PDF-1.4\n")
offsets = [0]
for number, obj in enumerate(objects, 1):
    offsets.append(len(payload))
    payload.extend(f"{number} 0 obj\n".encode())
    payload.extend(obj + b"\nendobj\n")
xref = len(payload)
payload.extend(f"xref\n0 {len(objects) + 1}\n".encode())
payload.extend(b"0000000000 65535 f \n")
for offset in offsets[1:]:
    payload.extend(f"{offset:010d} 00000 n \n".encode())
payload.extend(
    f"trailer\n<< /Size {len(objects) + 1} /Root 1 0 R >>\nstartxref\n{xref}\n%%EOF\n".encode()
)
pathlib.Path(sys.argv[1]).write_bytes(payload)
PY
}

