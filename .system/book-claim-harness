class AuditError(Exception):
    pass


@dataclass(frozen=True)
class Environment:
    name: str
    full_start: int
    content_start: int
    content_end: int
    full_end: int
    start_line: int
    end_line: int
    content: str


def fail(message: str) -> None:
    print(f"book-claim-harness: {message}", file=sys.stderr)
    raise SystemExit(1)


def repository_root() -> pathlib.Path:
    script = pathlib.Path(__file__)
    if script.is_symlink():
        raise AuditError("script path is unsafe")
    script = script.resolve(strict=True)
    result = subprocess.run(
        ["git", "-C", str(script.parent.parent), "rev-parse", "--show-toplevel"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
        text=True,
    )
    if result.returncode != 0:
        raise AuditError("repository root is unavailable")
    root = pathlib.Path(result.stdout.strip()).resolve(strict=True)
    if script.parent != root / ".system":
        raise AuditError("script path is unsafe")
    return root


def ensure_directory(path: pathlib.Path, description: str) -> pathlib.Path:
    lexical = pathlib.Path(os.path.abspath(path))
    try:
        metadata = lexical.lstat()
        resolved = lexical.resolve(strict=True)
    except (OSError, RuntimeError) as exc:
        raise AuditError(f"{description} is unavailable") from exc
    if not stat.S_ISDIR(metadata.st_mode) or lexical.is_symlink() or lexical != resolved:
        raise AuditError(f"{description} is unsafe")
    return resolved


def resolve_project(root: pathlib.Path, raw_project: str) -> pathlib.Path:
    collection = ensure_directory(root / "book-translations", "book collection")
    candidate = pathlib.Path(raw_project)
    if not candidate.is_absolute():
        candidate = root / candidate
    candidate = pathlib.Path(os.path.abspath(candidate))
    project = ensure_directory(candidate, "project directory")
    if project.parent != collection or PROJECT_ID.fullmatch(project.name) is None:
        raise AuditError("project must be one direct child of book-translations")
    for name in ("inbox", "draft", "out", ".workspace"):
        ensure_directory(project / name, f"project directory {name}")
    for name in ("source", "records", "tools", "locks"):
        ensure_directory(project / ".workspace" / name, f"workspace directory {name}")
    return project


def managed_paths(project: pathlib.Path) -> dict[str, pathlib.Path]:
    workspace = project / ".workspace"
    return {
        "config": workspace / "tools" / "book-claim-audit.json",
        "ledger": workspace / "records" / "claim-audit.json",
        "report": workspace / "records" / "claim-audit-report.json",
        "source": workspace / "source",
        "lock": workspace / "locks" / "book-claim-harness.lock",
    }


def reject_symlink_chain(path: pathlib.Path, stop: pathlib.Path) -> None:
    current = path
    while True:
        if current.is_symlink():
            raise AuditError(f"managed path is a symlink: {current}")
        if current == stop:
            return
        if stop not in current.parents:
            raise AuditError("managed path escapes project")
        current = current.parent


@contextlib.contextmanager
def project_lock(project: pathlib.Path):
    lock_path = managed_paths(project)["lock"]
    reject_symlink_chain(lock_path, project)
    flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_CLOEXEC", 0)
    flags |= getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
    descriptor: int | None = None
    try:
        descriptor = os.open(lock_path, flags, 0o600)
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise AuditError("lock path is not a regular file")
        with os.fdopen(descriptor, "a+", encoding="utf-8") as handle:
            descriptor = None
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
            yield
    except OSError as exc:
        raise AuditError("lock path is unsafe or unavailable") from exc
    finally:
        if descriptor is not None:
            os.close(descriptor)


def atomic_json_write(path: pathlib.Path, value: dict[str, Any]) -> None:
    reject_symlink_chain(path.parent, path.parents[2])
    if path.exists() and path.is_symlink():
        raise AuditError(f"managed path is unsafe: {path}")
    encoded = (json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n").encode()
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(encoded)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary_name, path)
    except BaseException:
        try:
            os.unlink(temporary_name)
        except FileNotFoundError:
            pass
        raise


def read_json(path: pathlib.Path, description: str) -> dict[str, Any]:
    try:
        metadata = path.lstat()
        if path.is_symlink() or not stat.S_ISREG(metadata.st_mode):
            raise AuditError(f"{description} is unsafe")
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise AuditError(f"{description} is invalid") from exc
    if not isinstance(value, dict):
        raise AuditError(f"{description} root must be an object")
    return value


